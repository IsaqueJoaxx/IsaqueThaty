<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Projeta.Civil3D</AssemblyName>
    <AutoCADRoot Condition="'$(AutoCADRoot)' == ''">C:\Program Files\Autodesk\AutoCAD 2027</AutoCADRoot>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="AcMgd"><HintPath>$(AutoCADRoot)\acmgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcCoreMgd"><HintPath>$(AutoCADRoot)\accoremgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcDbMgd"><HintPath>$(AutoCADRoot)\acdbmgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AecBaseMgd"><HintPath>$(AutoCADRoot)\ACA\AecBaseMgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AeccDbMgd"><HintPath>$(AutoCADRoot)\C3D\AeccDbMgd.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="CheckAutodeskReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(AutoCADRoot)\C3D\AeccDbMgd.dll')" Text="Biblioteca Civil 3D ausente. Informe AutoCADRoot para a instalação 2027 correta." />
  </Target>
</Project>
