<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Servidor MCP do PROJETA — o executável que o Claude Desktop inicia (stdio).
    Ele não fala com o AutoCAD diretamente: repassa as chamadas para a ponte do plugin (PRJMCP no Civil 3D).
    Instalação: instalador\instalar-mcp.ps1 (publica em %LOCALAPPDATA%\Projeta\mcp\servidor e configura o Claude Desktop).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Projeta.Mcp.Servidor</RootNamespace>
    <AssemblyName>Projeta.Mcp.Servidor</AssemblyName>
    <Version>1.0.0</Version>
    <Authors>Isaque</Authors>
    <Product>PROJETA • Assistente Civil</Product>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Projeta.Mcp\Projeta.Mcp.csproj" />
  </ItemGroup>

</Project>
