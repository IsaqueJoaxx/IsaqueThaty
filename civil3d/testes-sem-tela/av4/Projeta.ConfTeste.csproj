    <Reference Include="Projeta.Redes"><HintPath>$(Bin)\Projeta.Redes.dll</HintPath><Private>True</Private></Reference>
    <Reference Include="Projeta.Mcp"><HintPath>$(Bin)\Projeta.Mcp.dll</HintPath><Private>True</Private></Reference>
