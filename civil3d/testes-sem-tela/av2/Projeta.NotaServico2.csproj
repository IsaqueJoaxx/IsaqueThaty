<Project Sdk="Microsoft.NET.Sdk">
  <!-- CÃ³pia de teste fora do repositÃ³rio: mesmo cÃ³digo, outro nome de assembly e comando PRJNOTASERVICO2 (para recarregar na mesma sessÃ£o). -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Projeta.NotaServico2</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <NoWarn>$(NoWarn);CA1416;MSB3270;MSB3277</NoWarn>
    <AcadDir>C:\Program Files\Autodesk\AutoCAD 2027</AcadDir>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <R>$(MSBuildThisFileDirectory)..\..\projeta</R>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(R)\src\Projeta.Core\Comum\Util.cs" Link="Util.cs" />
    <Compile Include="$(R)\src\Projeta.Core\Relatorios\Xlsx.cs" Link="Xlsx.cs" />
    <Compile Include="$(R)\src\Projeta.Core\Pavimentacao\NotaServico.cs" Link="NotaServico.cs" />
    <Compile Include="$(R)\src\Projeta.Civil3D\Civil\NotaServicoCivil.cs" Link="NotaServicoCivil.cs" />
    <Compile Include="Cmd2.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="AcCoreMgd"><HintPath>$(AcadDir)\AcCoreMgd.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="AcDbMgd"><HintPath>$(AcadDir)\AcDbMgd.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="AcMgd"><HintPath>$(AcadDir)\AcMgd.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="AecBaseMgd"><HintPath>$(AcadDir)\ACA\AecBaseMgd.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="AeccDbMgd"><HintPath>$(AcadDir)\C3D\AeccDbMgd.dll</HintPath><Private>False</Private></Reference>
  </ItemGroup>
</Project>
