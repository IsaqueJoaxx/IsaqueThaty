qass : dialog {
label = "Padrão de linha guia:";
  : toggle {
    label = "Leader /¯¯¯¯¯¯¯¯¯¯";
    mnemonic = "L";
    key = "leadr";
  }
  : toggle {
    label = "Qleader /¯";
    mnemonic = "Q";
    key = "qleadr";
  }
  : toggle {
    label = "Não mostrar esse quadro";
    mnemonic = "Q";
    key = "naover";
  }
  ok_only;
  }
