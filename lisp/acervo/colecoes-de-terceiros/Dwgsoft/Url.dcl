url : dialog {
label = "Conect to";
  : toggle {
    label = "AOL - America on line";
    mnemonic = "A";
    key = "aol";
  }
  : toggle {
    label = "IG - Internet gratis";
    mnemonic = "I";
    key = "ig";
  }
  : toggle {
    label = "TERRA - Terra";
    mnemonic = "T";
    key = "terra";
  }
  : toggle {
    label = "UOL - Universo on line";
    mnemonic = "U";
    key = "uol";
  }
  : toggle {
    label = "SolosConsult";
    mnemonic = "S";
    key = "solos";
  }
  : toggle {
    label = "DWG©soft - www.dwgsoft.com.br";
    mnemonic = "A";
    key = "dwg";
  }
  : edit_box {
    label = "Outro:";
    mnemonic = "O";
    edit_width = 30;
    key = "outro";
  }
  ok_cancel;
}
