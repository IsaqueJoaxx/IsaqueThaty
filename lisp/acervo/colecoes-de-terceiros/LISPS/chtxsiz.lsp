(defun c:chtxsiz (/ a s n i e1 b c d e2)
   (setq a (ssget "x" '((0 . "TEXT") (8 . "MECH"))))
   (setq ts (getdist "\nNew text size  "))
   (setq n (sslength a))
   (setq i 0)
   (repeat n
     (setq e1 (entget (ssname a i)))
     (setq i (+ 1 i))
     (setq c (assoc 40 e1))
     (setq d (cons (car c) ts))
     (setq e2 (subst d c e1))
     (entmod e2)
   )
 )
