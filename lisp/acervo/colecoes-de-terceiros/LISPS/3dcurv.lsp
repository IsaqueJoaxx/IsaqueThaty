(defun C:3dCURV ()
(defun EQUATE (X Y)
(SETQ Z (*(SIN(/(* x 180) pi)) (cos(/(* y 180)pi))))
)
(setq  CMDMODE(getvar "cmdecho")
AMIN(getreal "What is lower limit for X?")
AMAX(getreal "What is upper limit for X?")
AINC(getreal "What is increment for X?")
BMIN(getreal "What is lower limit for Y?")
BMAX(getreal "What is upper limit for Y?")
BINC(getreal "What is increment for Y?")
ACOUNT AMIN)
(setvar "cmdecho" 0)
(command "vpoint" "1,1,1" "line" (list AMIN BMIN 0.0) (list AMAX BMAX 0.0) "")
(command "zoom" "e" "erase" "l" "")
(while(<= ACOUNT AMAX) 
(setq BCOUNT BMIN)
(while(<= BCOUNT BMAX)
(setq PT1(list ACOUNT BCOUNT (equate ACOUNT BCOUNT))
PT2(list (+ ACOUNT AINC) BCOUNT
             (equate (+ ACOUNT AINC) BCOUNT))
PT3(list (+ ACOUNT AINC) (+ BCOUNT BINC)
             (equate (+ ACOUNT AINC) (+ BCOUNT BINC)))
PT4(list ACOUNT (+ BCOUNT BINC)
             (equate ACOUNT (+ BCOUNT BINC))))
(command "3DFACE" pt1 pt2 pt3 pt4 "")
(setq BCOUNT (+ BCOUNT BINC))
)
(setq ACOUNT (+ ACOUNT AINC))
)
(command "zoom" "e")
(setvar "cmdecho" CMDMODE )
)
