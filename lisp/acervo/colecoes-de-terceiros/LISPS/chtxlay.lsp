(defun c:chtxlay (/ a tl n i e1 b c d e2)
   (setq a (ssget "x" '((0 . "TEXT") (8 . "MECH"))))
   (setq LN (getstring "\nNew layer  "))
   (setq n (sslength a))
   (setq i 0)
   (repeat n
     (setq e1 (entget (ssname a i)))
     (setq i (+ 1 i))
     (setq c (assoc 8 e1))
     (setq d (cons (car c) LN))
     (setq e2 (subst d c e1))
     (entmod e2)
   )
 )
