(vmon)
(defun C:KERNTEX ()
(setq style (getstring "Give Text Style: "))
(setq h (getreal "Give Character Height: "))
(setq rot (getreal "Give Character Rotation <0>: "))
(if (= rot nil) (setq rot 0))
(setq p (getpoint "Give L.H.B. point: "))
(terpri)
(setq tex "Key Text : ")
(setq tex (getstring tex  "Key Text  : "))
(setvar "cmdecho" 0)
(setq tx (substr tex 1 1))
(setq l (strlen tex))
(setq ltr(list "A" "L"))
(setq ltl(list "A" "J"))
(setq lbr(list "F" "P" "7" "T" "V" "W" "Y"))
(setq lbl(list "1" "T" "V" "W" "Y"))
(setq n 2)
(setq tf tx)
(setq tl tx)
(while  (<= n l)
 (setq tx (substr tex n 1 ))
 (setq tz tx)
 (if (and (member tl ltr) (member tx lbl)) (setq tx (strcat "%%200" tx)))
 (if (and (member tl lbr) (member tx ltl)) (setq tx (strcat "%%200" tx)))
 (setq tf (strcat tf tx ))
 (setq tl tz)
 (setq n (+ n 1))
 )
(command "text" "s" style p h rot tf)
(setvar "cmdecho" 1)
(princ)
)

