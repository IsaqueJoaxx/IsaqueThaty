(DEFUN RCRVTAB()
   (SETQ FNAME (GETSTRING "ENTER FILE NAME: "))
   (SETQ IN (OPEN FNAME "r"))
 (SETQ SP (GETPOINT "ENTER STARTING POINT: "))
 (SETQ TSIZE (GETREAL "ENTER TEXT SIZE: "))
 (WHILE (SETQ S (READ-LINE IN))
  (COMMAND "TEXT" SP TSIZE 0 S)
  (SETQ SP (LIST (CAR SP) (- (CADR SP) (* 1.5 TSIZE))))
)
(CLOSE IN)
)
(RCRVTAB)
