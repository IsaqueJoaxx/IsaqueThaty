(DEFUN C:HEAL ()
  (SETVAR "CMDECHO" 1)
  (SETQ BLIP (GETVAR "BLIPMODE"))
  (SETQ APER (GETVAR "APERTURE"))
  (SETVAR "APERTURE" 1)
  (SETQ EPT1
    (OSNAP
    (GETPOINT "1ST POINT: ")"ENDP"))
  (TERPRI)
  (SETQ EPT2
    (OSNAP
    (GETPOINT "2ND POINT: ")"ENDP"))
  (SETVAR "BLIPMODE" 0)
  (SETQ MPT1 (OSNAP EPT1 "MIDP"))
  (SETQ MPT2 (OSNAP EPT2 "MIDP"))
  (IF (=
      (ANGTOS (ANGLE MPT1 EPT1) 3 4)
      (ANGTOS (ANGLE EPT1 EPT2) 3 4)
      (ANGTOS (ANGLE EPT2 MPT2) 3 4))
    (PROGN
      (COMMAND "ERASE" MPT2 "")
      (COMMAND "CHANGE" EPT1 ""
        (POLAR MPT2
          (ANGLE EPT2 MPT2)
          (DISTANCE EPT2 MPT2))))
        (PROMPT "*INVALID*"))
  (SETVAR "BLIPMODE" BLIP)
  (SETVAR "APERTURE" APER)
  (SETVAR "CMDECHO" 1)) 