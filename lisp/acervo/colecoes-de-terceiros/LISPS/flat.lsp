(vmon)
(setvar "cmdecho" 0)
;draw the arrow
(defun drwarrw ()
(setq p1 (getpoint "\nArrow head point")
      p2 (getpoint p1 "\nEnd point")
      ht (getvar "textsize")
      ang (angle p1 p2)
      p3 (polar p1 ang (* ht 2))
)
(command "pline" p1 "w" 0 (/ ht 2) p3 "w" 0 0 p2 "")
)
;convert degrees to radians
(defun dtr (d)
(/ (* d pi) 180.0)
)
;convert radians to degrees
(defun rtd (r)
(/ (* r 180.0) pi)
)
;place text on top of line
(defun loctext ()
(if (> (car p2) (car p1))
   (progn
     (setq pangle (angle P1 P2)
           midpt (polar P1 pangle (/ (distance P1 P2) 2))
           angp (+ pangle (dtr 90))
           P3 (polar midpt angp ht)
     )
   )
   (progn
     (setq pangle (angle P2 P1)
           midpt (polar P2 pangle (/ (distance P1 P2) 2))
           angp (+ pangle (dtr 90))
           P3 (polar midpt angp ht)
     )
   )
 )
)
;get text and print it
(defun drwtext ()
(setq txt (getstring T"\nNote on arrow:"))
 (if (> (car p2) (car p1))
    (command "text" "m" p3 ht (rtd pangle) txt)
    (command "text" "m" p3 ht (rtd (angle p2 p1)) txt)
 )
)
(defun C:FLAT ()
(drwarrw)
(loctext)
(drwtext)
)