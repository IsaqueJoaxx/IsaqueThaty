(defun c:numerar (/ h ni p1)
(setq h (getreal "\nRotaco do Texto:"))
(setq ni (getint "\nNumero inicial: "))
         (if (= ni nil)(setq ni 1))
(setq p1 t)
  (while (/= nil p1)
(setq p1 (getpoint "\nPonto de insercao:"))
         (if (= p1 nil)
             (prompt "\n ")
             (progn
  (command "text" p1 h ni)
(setq ni (+ ni 1))
                 )
                )
               )
              )