(defun C:CLOCK (/ pt4 pt3)
  (GRAPHSCR)
  (setq pt1 (getpoint "\nPrimeiro Ponto"))
  (setq pt2 (getcorner "\rSegundo Ponto  \n" pt1))
  (if (> (car pt1) (car pt2))
    (setq pt3 pt1
	  pt1 pt2
	  pt2 pt3
    )
  )
  (CLOCKS)
  (COMMAND "REDRAW")
)					;end fun


