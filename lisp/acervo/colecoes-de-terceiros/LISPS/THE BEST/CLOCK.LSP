(defun hands (/ vlue inc oldmins oldsecs fin fpos newmins newsecs)
  (SETQ INC 0.10472)
  (setq OLDMINS (substr (rtos (getvar "cdate") 2 6) 12 2))
  (setq OLDSECS (substr (rtos (getvar "cdate") 2 6) 14 2))
  (SETQ FIN (* (ATOI OLDSECS) -0.10472))
  (SETQ FPOS (POLAR PT5 (- FIN 1.5708) (* RAD 0.85)))
  (setq vlue (CAR (cadr (GRREAD T))))
  (while (or (<= vlue (CAR PT1)) (>= vlue (CAR PT2)))
    (setq NEWMINS (substr (rtos (getvar "cdate") 2 6) 12 2))
    (setq NEWSECS (substr (rtos (getvar "cdate") 2 6) 14 2))
    (IF	(/= NEWSECS OLDSECS)
      (PROGN (IF (/= OLDMINS NEWMINS)
	       (PROGN (SETQ OLDMINS NEWMINS) (COMMAND "REDRAW") (CLOCKS))
	     )
	     (BUTTON)
	     (GRDRAW PT5 FPOS 0 0)
	     (SETQ OLDSECS NEWSECS)
	     (SETQ FIN (* (ATOI NEWSECS) -0.10472))
	     (SETQ FPOS (POLAR PT5 (+ FIN 1.5708) (* RAD 0.85)))
	     (GRDRAW PT5 FPOS 11 0)
	     (GRVECS
	       (LIST 2 SP3 SHP 3 SP1 SP3 3 SP3 SP2 3 SP2 SHP 3 SHP SP1)
	     )
	     (GRVECS
	       (LIST 2 LP3 LHP 3 LP1 LP3 3 LP3 LP2 3 LP2 LHP 3 LHP LP1)
	     )
	     (RMJ)
      )
    )
    (setq vlue (CAR (cadr (GRREAD T))))
  )
)
