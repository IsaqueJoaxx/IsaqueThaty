(DEFUN BUTTON (/ cntr pt6 pt7 inc)
  (SETQ	CNTR 0
	PT6 NIL
	PT7 NIL
  )
  (SETQ PT6 (POLAR PT5 0 (* RAD 0.025)))
  (SETQ INC 0.349067)
  (WHILE (< CNTR 18)
    (IF	(/= PT7 NIL)
      (SETQ PT6 PT7)
    )
    (SETQ PT7 (POLAR PT5 INC (* RAD 0.025)))
    (GRDRAW PT6 PT7 9 0)
    (SETQ CNTR (1+ CNTR))
    (SETQ INC (+ INC 0.349067))
  )
)
(DEFUN CLOCKS (/     hors  mins	 secs  mnts  mininc	 horinc
