(princ "\n----- Digite \"GETAREA para Iniciar Comando...\"")

(defun c:getarea (/ pt ss vs z1 z2 entl) 
(setq pt (getpoint "\nClicque num ponto dentro da area\n") 
entl (entlast) 
vs (/ (getvar "VIEWSIZE") 2) 
z1 (list (- (car pt) vs) (- (cadr pt) vs)) 
z2 (list (+ (car pt) vs) (+ (cadr pt) vs)) 
ss (ssget "C" z1 z2 
'((-4 . "<OR") 
(8 . "poligonal") 
(8 . "0") 
(8 . "lote") 
(8 . "quadra") 
(8 . "apfv") 
(-4 . "OR>")) )) 
(command "-boundary" "a" "b" "n" ss "" "i" "n" "n" "o" "r" "" pt "") 
(if (eq (entlast) entl) (quit)) 
(command "area" "o" (entlast)) 
(entdel (entlast)) 
(entmake (list '(0 . "TEXT") (cons 1 (rtos (getvar "area") 2 2 ))(cons 10 pt) (cons 40 2))) 
(princ))