(princ "\n----- Digite \"PXY para Iniciar Comando...\"")

(DEFUN C:PXY ()
 (SETQ CAP (GETVAR "CLAYER"))
 (COMMAND "_SETVAR" "CMDECHO" 0)
 (COMMAND "_SETVAR" "PDMODE" 32)
 (SETQ FACTOR (GETDIST "\nEscala da Planta: "))
 (SETQ FACTOR (/ FACTOR 1000))
 (COMMAND "_SETVAR" "PDSIZE" FACTOR)
 (WHILE
   (SETQ P1 (GETPOINT "\nPonto x,y: "))
   (SETQ X (CAR P1))
   (SETQ Y (CADR P1))
   (SETQ NOMBRE (GETSTRING "\nDescricao Ponto: "))
   (SETQ Z (GETSTRING "\nCota :"))
   (SETQ ALTTXT (* 2 FACTOR))
   (COMMAND "_STYLE" "standard" "txt" ALTTXT 1 0 "" "" "") 
   (COMMAND "_LAYER" "_MAKE" "PONTOS" "")
   (COMMAND "_POINT" P1)
   (COMMAND "_LAYER" "_MAKE" "TEXTOPONTO" "")
   (SETQ P2 (LIST (+ X (* 2.5 FACTOR)) (- Y (* -1.0001 FACTOR))))
   (COMMAND "_TEXT" P2 0 NOMBRE)
   (COMMAND "_LAYER" "_MAKE" "COTA" "")
   (SETQ PZ (LIST (+ X (* 2 FACTOR)) (- Y (* 7.5 FACTOR))))
   (SETQ Z (STRCAT "Z=" Z))
   (COMMAND "_TEXT" PZ 0 Z)
   (COMMAND "_LAYER" "_MAKE" CAP "")
   (SETQ PX (LIST (+ X (* 2 FACTOR)) (- Y (* 2.5 FACTOR))))
   (SETQ PY (LIST (+ X (* 2 FACTOR)) (- Y (* 5 FACTOR))))
   (SETQ X (STRCAT "X=" (RTOS X)))
   (SETQ Y (STRCAT "Y=" (RTOS Y)))
   (COMMAND "_TEXT" PX 0 X)
   (COMMAND "_TEXT" PY 0 Y)
 )
 (PRINC)
)
