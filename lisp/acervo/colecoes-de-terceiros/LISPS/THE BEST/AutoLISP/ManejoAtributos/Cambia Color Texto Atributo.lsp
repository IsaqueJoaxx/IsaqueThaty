(defun c:ccta ()
  (if (= (findfile "Captura Block.lsp") nil)
    (progn
      (alert "\nDebes revisar las opciones de configuración del sistema, alguna aplicación fue borrada o renombrada")
      (quit)
    )
    (progn
      (load (findfile "Captura Block.lsp"))
      (captura^block)
    )
  )
  (setq indx 0)
  (initget (+ 1 2 4))
  (setq color (getint "\nIngresa Color del Texto del Atributo < Numeros Enteros entre 1 @ 255 Inclusive >: "))
  (repeat (sslength grupo^block)
    (setq entidad (entnext (ssname grupo^block indx))
         listasoc (entget entidad)
	     tipo (cdr (assoc 0 listasoc))
	     indx (1+ indx)
    )
    (while (= tipo "ATTRIB")
      (setq listasoc (subst (cons 62 color) (assoc 62 listasoc) listasoc))
      (entmod listasoc)
      (entupd entidad)
      (setq entidad (entnext entidad)
	   listasoc (entget entidad)
	       tipo (cdr (assoc 0 listasoc))
      )
    )
  )
  (princ)
)

(prompt "\nRutina Cambia Color Texto Atributo Versión 1.0 Cargada.\nDigita < CCTA > Para Comenzar")

(princ)