(defun c:cea ()
  (if (= (findfile "GAP_Arial.lsp") nil)
    (progn
      (alert "\nDebes revisar las opciones de configuración del sistema, alguna aplicación fue borrada o renombrada")
      (quit)
    )
    (progn
      (load (findfile "GAP_Arial.lsp"))
      (GAP_Arial)
    )
  )
  (if (= (findfile "GAP_Romans.lsp") nil)
    (progn
      (alert "\nDebes revisar las opciones de configuración del sistema, alguna aplicación fue borrada o renombrada")
      (quit)
    )
    (progn
      (load (findfile "GAP_Romans.lsp"))
      (GAP_Romans)
    )
  )
  (if (= (findfile "Captura Block.lsp") nil)
    (progn
      (alert "\nDebes revisar las opciones de configuración del sistema, alguna aplicación fue borrada o renombrada")
      (quit)
    )
    (progn
      (load (findfile "Captura Block.lsp"))
      (captura^block)
    )
  )  
  (setq indx 0)
  (initget "Romans")
  (if (= (setq opcion (getkword "\nSelecciona Estilo: <Arial>/Romans : ")) nil)
    (setq opcion "GAP_Arial")
  )
  (repeat (sslength grupo^block)
    (setq entidad (entnext (ssname grupo^block indx))
         listasoc (entget entidad)
	     tipo (cdr (assoc 0 listasoc))
    )
    (while (= tipo "ATTRIB")
      (setq listasoc (subst (cons 7 opcion) (assoc 7 (entget entidad)) (entget entidad)))
      (entmod listasoc)
      (entupd entidad)
      (setq entidad (entnext entidad)
           listasoc (entget entidad)
               tipo (cdr (assoc 0 listasoc))
      )
    )
    (setq indx (1+ indx))
  )
)

(prompt "\nRutina Cambia Estilo Atributo Versión 1.0 Cargada.\nDigita < CEA > Para Comenzar")

(princ)