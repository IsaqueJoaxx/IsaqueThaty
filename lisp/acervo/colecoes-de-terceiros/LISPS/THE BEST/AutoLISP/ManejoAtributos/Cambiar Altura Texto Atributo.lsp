(defun c:cata ()
  (setq indx 0)
  (initget (+ 1 2 4))
  (setq altura (getreal "\nIngresa Altura del Atributo : "))
  (setq grupo (ssget))
  (repeat (sslength grupo)
    (setq entidad^p (ssname grupo indx)
	  entidad^s (entnext entidad^p)
	   listasoc (entget entidad^s)
	       indx (1+ indx)
           listasoc (subst (cons 40 altura) (assoc 40 listasoc) listasoc)
    )
    (entmod listasoc)
    (entupd entidad^p)
  )
)

(prompt "\nRutina Cambiar Altura Texto Atributo Versión 2.0 Cargada.\nDigita < CATA > Para Comenzar")

(princ)