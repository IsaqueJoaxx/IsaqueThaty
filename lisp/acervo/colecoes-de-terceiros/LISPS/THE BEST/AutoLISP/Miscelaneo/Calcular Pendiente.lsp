(defun desarrollo ()
  (while
    (= (setq entidad (car (entsel "\nSelecciona Linea < Debe ser Linea, Lwpolylinea o 3dpoly > : "))) nil)
    (alert "\nSelecciona Linea < Debe ser Linea, Lwpolylinea o 3dpoly > : ")
  )
  (setq listasoc (entget entidad))
  (cond (
	 (eq (cdr (assoc 0 listasoc)) "LINE")
	 (setq inicio (cdr (assoc 10 listasoc))
	          fin (cdr (assoc 11 listasoc))
	 )
	)
	(
	 (eq (cdr (assoc 0 listasoc)) "LWPOLYLINE")
	 (setq inicio (cdr (assoc 10 listasoc))
	     listasoc (cdr (member (assoc 10 listasoc) listasoc))
	          fin (cdr (assoc 10 listasoc))
	 )
	)
        (
	 (= (cdr (assoc 0 listasoc)) "POLYLINE")
         (setq entidad (entnext entidad)
	      listasoc (entget entidad)
         lista_vetices '()
         )
         (while (= (cdr (assoc 0 listasoc)) "VERTEX")
           (setq lista_vertices (cons (cdr (assoc 10 listasoc)) lista_vertices)
	                entidad (entnext entidad)
	               listasoc (entget entidad)
           )
         )
         (setq inicio (nth 1 lista_vertices)
	          fin (nth 0 lista_vertices)
         )
        )
	(T (alert "Entidad Seleccionada no cumple requisitos") (quit))
  )
  (setq delta_vertical (abs (- (nth 1 inicio) (nth 1 fin)))
      delta_horizontal (abs (- (nth 0 inicio) (nth 0 fin)))
             pendiente (* (/ delta_vertical delta_horizontal) 100)
  )
  (command "clayer" "GAP_Texto-General")
  (command "text" "j" "m" (polar inicio (angle inicio fin) (/ (distance inicio fin) 2)) 1 0 (strcat "\ni = " (rtos pendiente 2 1) " % "))
)

