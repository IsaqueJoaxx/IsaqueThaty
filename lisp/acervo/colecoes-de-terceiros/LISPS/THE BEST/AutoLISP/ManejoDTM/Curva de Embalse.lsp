(defun datos^entrada ()
  (if (= (findfile "Variables Entrada.lsp") nil)
    (progn
      (alert "\nDebes revisar las opciones de configuración del sistema, alguna aplicación fue borrada o renombrada")
      (quit)
    )
    (progn
      (load (findfile "Variables Entrada.lsp"))
      (variables^entrada)
    )
  )
  (if (= (findfile "Captura 3dface.lsp") nil)
    (progn
      (alert "\nDebes revisar las opciones de configuración del sistema, alguna aplicación fue borrada o renombrada")
      (quit)
    )
    (progn
      (load (findfile "Captura 3dface.lsp"))
      (captura^3dface)
    )
  )
)


(defun desarrollo ()
  (if grupo^3dface
    (progn
      (setq archivo (open (getfiled "Selecciona Carpeta de Destino" "c:\\" "csv" 1) "w"))
      (initget (+ 1 2 4))
      (setq delta (getreal "\nIngresa Delta Vertical de Cubicación [m]: "))
      (initget "No")
      (if (= (getkword "\nBuscar Rango del la DTM? <Si>/No: ") nil)
	(progn
	  (if (= (findfile "Rango 3dface.lsp") nil)
            (progn
              (alert "\nDebes revisar las opciones de configuración del sistema, alguna aplicación fue borrada o renombrada")
              (quit)
            )
            (progn
              (load (findfile "Rango 3dface.lsp"))
              (rango^3dface)
	    )  
          )
        )
      )
      (initget (+ 1 2 4))
      (setq nivel^laguna (getint "\nElevación Maxima de la Curva de Embalse [m s.n.m.]: "))
      (repeat (+ (fix (/ (- nivel^laguna cota^minima) delta)) 1)
	(setq indx^cubica 0 volumen^laguna 0)
        (repeat (sslength grupo^3dface)
          (setq entidad^3dface (ssname grupo^3dface indx^cubica)
                      listasoc (entget entidad^3dface)
                   vertice^uno (assoc 10 listasoc)
              cota^vertice^uno (nth 3 vertice^uno)
        coordenada^vertice^uno (list (nth 1 vertice^uno) (nth 2 vertice^uno))
                   vertice^dos (assoc 11 listasoc)
              cota^vertice^dos (nth 3 vertice^dos)
        coordenada^vertice^dos (list (nth 1 vertice^dos) (nth 2 vertice^dos))
                  vertice^tres (assoc 12 listasoc)
             cota^vertice^tres (nth 3 vertice^tres)
       coordenada^vertice^tres (list (nth 1 vertice^tres) (nth 2 vertice^tres))
  	    cota^media^terreno (/ (+ cota^vertice^uno cota^vertice^dos cota^vertice^tres) 3)
                    delta^cota (- nivel^laguna cota^media^terreno)
                   indx^cubica (+ indx^cubica 1)
          )
	  (if (> nivel^laguna cota^media^terreno)
	    (progn
	      (command "area" coordenada^vertice^uno coordenada^vertice^dos coordenada^vertice^tres "")
	      (setq area (getvar "area"))
	      (setq volumen^parcial (* area delta^cota)
                     volumen^laguna (+ volumen^laguna volumen^parcial)
              )
	    )
          )
        )
	(write-line (strcat (rtos volumen^laguna 2 2) ";" (rtos nivel^laguna 2 2)) archivo)
	(setq nivel^laguna ( - nivel^laguna delta))
	(command "redraw")
      )
      (close archivo)
    )
  )
)

