(defun datos^entrada ()
  (if (= (findfile "insertar layer.lsp") nil)
    (progn
      (alert "\nDebes revisar las opciones de configuración del sistema, alguna aplicación fue borrada o renombrada")
      (quit)
    )
    (progn
      (load (findfile "insertar layer.lsp"))
      (c:il)
    )
  )
  (if (= (findfile "Variables Entrada.lsp") nil)
    (progn
      (alert "\nDebes revisar las opciones de configuración del sistema, alguna aplicación fue borrada o renombrada")
      (quit)
    )
    (progn
      (load (findfile "Variables Entrada.lsp"))
      (variables^entrada)
    )
  )
  (setq grupo^3dface (ssget))
  (setq lista^este '() lista^norte '() lista^elevacion '() indx 0)
)

(defun genera^limite ()
  (repeat (sslength grupo^3dface)
    (setq listasoc (entget (ssname grupo^3dface indx))
	      indx (1+ indx)
	   puntero 10
    )
    (repeat 3
      (setq elevacion (nth 3 (assoc puntero listasoc))
	         este (nth 1 (assoc puntero listasoc))
	        norte (nth 2 (assoc puntero listasoc))
      )
      (if (= (member elevacion lista^elevacion) nil)
	(setq lista^elevacion (cons elevacion lista^elevacion))
      )
      (if (= (member este lista^este) nil)
	(setq lista^este (cons este lista^este))
      )
      (if (= (member norte lista^norte) nil)
	(setq lista^norte (cons norte lista^norte))
      )
      (setq puntero (1+ puntero))
    )
  )
  (prompt (strcat "\nElevacion Minima " (rtos (apply 'min lista^elevacion) 2 0) " m s.n.m."))
  (initget 7)
  (setq limite_inferior_solido (getreal "\nIngresa Limite Inferior Solido : "))
)

(defun genera^solido ()
  (command "layer" "s" "GAP_Solido" "")
  (setq	limite_superior_solido (+ (apply 'max lista^elevacion) 100)
	          delta_solido (- limite_superior_solido limite_inferior_solido)
	                  indx 0
  )
  (command "rectang" (list (apply 'min lista^este) (apply 'min lista^norte) limite_inferior_solido)
	   	     (list (apply 'max lista^este) (apply 'max lista^norte) limite_inferior_solido)
  )
  (command "extrude" "l" "" delta_solido "")
  (setq solido (entlast))
  (repeat (sslength grupo^3dface)
    (setq listasoc (entget (ssname grupo^3dface indx))
	      diez_3dface (cdr (assoc 10 listasoc))
	      diez_solido (reverse (cons limite_inferior_solido (cdr (reverse diez_3dface))))
	      once_3dface (cdr (assoc 11 listasoc))
	      once_solido (reverse (cons limite_inferior_solido (cdr (reverse once_3dface))))
              doce_3dface (cdr (assoc 12 listasoc))
	      doce_solido (reverse (cons limite_inferior_solido (cdr (reverse doce_3dface))))
	      indx (1+ indx)
    )
    (command "pline" diez_solido once_solido doce_solido "c"
	     "extrude" "l" "" delta_solido ""
	     "slice" "l" "" diez_3dface once_3dface doce_3dface
       			    (list (apply 'min lista^este) (apply 'min lista^norte) limite_superior_solido)
	     "subtract" solido "" "l" ""
	     )
  )
    (command "erase" grupo^3dface "")
)

(defun datos^salida ()
  (if (= (findfile "Variables Salida.lsp") nil)
    (progn
      (alert "\nDebes revisar las opciones de configuración del sistema, alguna aplicación fue borrada o renombrada")
      (quit)
    )
    (progn
      (load (findfile "Variables Salida.lsp"))
      (variables^salida)
    )
  )
)

(defun c:gst ()
  (datos^entrada)
  (genera^limite)
  (genera^solido)
  (datos^salida)
)

(prompt "\nRutina Genera Genera Solido de Terreno Version 1.0 Cargada.\nPara Comenzar digite < GST >")