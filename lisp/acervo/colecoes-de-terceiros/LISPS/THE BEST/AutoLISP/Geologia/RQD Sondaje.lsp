(defun datos^entrada ()
  (if (= (findfile "Variables Entrada.lsp") nil)
    (progn
      (alert "\nDebes revisar las opciones de configuración del sistema, alguna aplicación fue borrada o renombrada")
      (quit)
    )
    (progn
      (load (findfile "Variables Entrada.lsp"))
      (variables^entrada)
    )
  )
  (if (= (findfile "insertar layer.lsp") nil)
    (progn
      (alert "\nDebes revisar las opciones de configuración del sistema, alguna aplicación fue borrada o renombrada")
      (quit)
    )
    (progn
      (load (findfile "insertar layer.lsp"))
      (c:il)
    )
  )
  (setq archivo^datos (open (getfiled "Selecciona Archivo de Datos" "c:\\" "csv" 8) "r"))
  (while
    (= (setq inicio^sondaje (getpoint "\nIndica Inicio Sondaje : ")) nil)
  )
  (initget (+ 1 2 4))
  (setq ancho^sondaje (getint "\nIngresa Ancho sondaje : "))
  (setq lista^profundidad '()
	        lista^rqd '()
    lista^par^profundidad '()
    lista^par^profundidad (cons (list inicio^sondaje (polar inicio^sondaje 0 ancho^sondaje)) lista^par^profundidad)
	    lista^par^rqd '()
	lista^xy^achurado '()
  )
  (setq	angdir^old (getvar "angdir"))
  (setvar "angdir" 1)
)

(defun insertar^layer ()
  (command "layer" "m" "GAP_RQD 100 - 90" "c" "191" "GAP_RQD 100 - 90" "")
  (command "layer" "m" "GAP_RQD 89 - 75" "c" "130" "GAP_RQD 89 - 75" "")
  (command "layer" "m" "GAP_RQD 74 - 50" "c" "100" "GAP_RQD 74 - 50" "")
  (command "layer" "m" "GAP_RQD 49 - 25" "c" "50" "GAP_RQD 49 - 25" "")
  (command "layer" "m" "GAP_RQD Menor 25" "c" "10" "GAP_RQD Menor 25" "")
)

(defun leer^datos^archivo ()
  (while (setq linea (read-line archivo^datos))
    (setq indx 1)
    (repeat (strlen linea)
      (if (= (substr linea indx 1) ";")
        (setq posicion indx)
      )
      (setq indx (1+ indx))
    )
    (setq profundidad (substr linea 1 (- posicion 1))
    lista^profundidad (cons (atof profundidad) lista^profundidad)
	          rqd (substr linea (+ posicion 1) (- (strlen linea) posicion))
	    lista^rqd (cons (atof rqd) lista^rqd)
    )
  )
  (setq lista^profundidad (reverse lista^profundidad)
                lista^rqd (reverse lista^rqd)
  )
)

(defun crear^lista^datos^profundidad ()
  (setq indx 0)
  (repeat (length lista^profundidad)
    (setq lista^par^profundidad (cons
				  (list
				    (polar inicio^sondaje (* (/ pi 2) 3) (nth indx lista^profundidad))
				    (polar (polar inicio^sondaje (* (/ pi 2) 3) (nth indx lista^profundidad)) 0 ancho^sondaje)
				  )
				  lista^par^profundidad
				)
		           indx (1+ indx)
    )
  )
  (setq lista^par^profundidad (reverse lista^par^profundidad))
)

(defun desarrollo^grafico^profundidad ()
  (setq indx 0)
  (command "layer" "s" "GAP_Sondajes" "")
  (repeat (length lista^par^profundidad)
    (setq par^profundidad (nth indx lista^par^profundidad)
	             indx (1+ indx)
    )
    (command "line" (nth 0 par^profundidad) (nth 1 par^profundidad) "")
  )
  (command "line" (nth 0 (car lista^par^profundidad)) (nth 0 (last lista^par^profundidad)) "")
  (command "line" (nth 1 (car lista^par^profundidad)) (nth 1 (last lista^par^profundidad)) "")
)

(defun crear^lista^datos^rqd ()
  (setq indx 0)
  (repeat (length lista^rqd)
    (cond
      ((zerop (nth indx lista^rqd)) (setq indx (1+ indx)))
      ((= (nth indx lista^rqd) 100) (setq indx (1+ indx)))
      (t (setq lista^par^rqd (cons
			       (list
			         (polar
				   (polar inicio^sondaje (* (/ pi 2) 3) (nth indx lista^profundidad)) 0 (/ (* ancho^sondaje (nth indx lista^rqd)) 100.0)
			         )
		                 (polar
			           (polar
				     (polar inicio^sondaje (* (/ pi 2) 3) (nth indx lista^profundidad)) 0 (/ (* ancho^sondaje (nth indx lista^rqd)) 100.0)
			           )
			           (/ pi 2) (if (zerop indx)
					      (nth indx lista^profundidad)
					      (- (nth indx lista^profundidad) (nth (- indx 1) lista^profundidad))
					    )
				 )
			       )
			       lista^par^rqd
			     )
	                indx (1+ indx)
        )
      )
    )
  )
  (setq lista^par^rqd (reverse lista^par^rqd))
)

(defun desarrollo^grafico^rqd ()
  (setq indx 0)
  (command "layer" "s" "GAP_Sondajes" "")
  (repeat (length lista^par^rqd)
    (setq par^rqd (nth indx lista^par^rqd)
             indx (1+ indx)
    )
    (command "line" (nth 0 par^rqd) (nth 1 par^rqd) "")
  )
)

(defun crear^lista^datos^achurado ()
  (setq indx 0)
  (repeat (length lista^rqd)
    (if (zerop (nth indx lista^rqd))
      (setq indx (1+ indx))
      (setq lista^xy^achurado (cons
			        (polar
                                  (polar inicio^sondaje (* (/ pi 2) 3) (nth indx lista^profundidad))
			            (angle
				      (polar inicio^sondaje (* (/ pi 2) 3) (nth indx lista^profundidad))
		                      (polar
			                (polar
				          (polar inicio^sondaje (* (/ pi 2) 3) (nth indx lista^profundidad)) 0 (/ (* ancho^sondaje (nth indx lista^rqd)) 100.0)
			                )
			                (/ pi 2) (if (zerop indx)
					           (nth indx lista^profundidad)
					           (- (nth indx lista^profundidad) (nth (- indx 1) lista^profundidad))
					         )
				      )
				    )
                                    (/
				      (distance
				        (polar inicio^sondaje (* (/ pi 2) 3) (nth indx lista^profundidad))
		                        (polar
			                  (polar
				            (polar inicio^sondaje (* (/ pi 2) 3) (nth indx lista^profundidad)) 0 (/ (* ancho^sondaje (nth indx lista^rqd)) 100.0)
			                  )
			                  (/ pi 2) (if (zerop indx)
				                     (nth indx lista^profundidad)
					             (- (nth indx lista^profundidad) (nth (- indx 1) lista^profundidad))
						   )
					)
				      )
				      2
				    )
				  )
				  lista^xy^achurado
			        )
	                   indx (1+ indx)
      )
    )
  )
  (setq lista^xy^achurado (reverse lista^xy^achurado))
)

(defun desarrollo^grafico^achurado ()
  (setq indx 0)
  (command "zoom" "c" inicio^sondaje 20)
  (setvar "HPNAME" "ANSI31")
  (setvar "HPSCALE" 0.1000)
  (command "layer" "s" "GAP_Achurados" "")
  (repeat (length lista^xy^achurado)
    (setq xy^achurado (nth indx lista^xy^achurado)
                 indx (1+ indx)
    )
    (command "zoom" "c" xy^achurado "")
    (command "bhatch" xy^achurado "")
  )
  (command "zoom" "e")
)

(defun datos^salida ()
  (if (= (findfile "Variables Salida.lsp") nil)
    (progn
      (alert "\nDebes revisar las opciones de configuración del sistema, alguna aplicación fue borrada o renombrada")
      (quit)
    )
    (progn
      (load (findfile "Variables Salida.lsp"))
      (variables^salida)
    )
  )
  (close archivo^datos)
  (setvar "angdir" angdir^old)
)

(defun c:rs ()
  (datos^entrada)
  (insertar^layer)
  (leer^datos^archivo)
  (crear^lista^datos^profundidad)
  (desarrollo^grafico^profundidad)
  (crear^lista^datos^rqd)
  (desarrollo^grafico^rqd)
  (crear^lista^datos^achurado)
  (desarrollo^grafico^achurado)
  (datos^salida)
  (princ)
)

(prompt "\nRutina RQD Sondaje Versión 2.0 Cargada.\nDigita < RS > Para Comenzar")

(princ)