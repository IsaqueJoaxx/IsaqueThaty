(defun captura^alineamiento ()
  (setq entidad (car (entsel "\nSelecciona Alineamiento : ")))
)

(defun proceso^revision^polyline ()
  (setq listasoc^rev (entget entidad)
	   lista^rev '()
	    lista^xy '()
  )
  (foreach p listasoc^rev (if (= (car p) 42) (setq lista^rev (cons p lista^rev))))
  (foreach p listasoc^rev (if (= (car p) 10) (setq lista^xy (cons p lista^xy))))
  (setq lista^rev (reverse (cddr lista^rev))
	 lista^xy (reverse lista^xy)
	    ciclo (/ (length lista^rev) 2)
  )
  (repeat ciclo
    (if (and (= (cdr (nth 0 lista^rev)) 0) (/= (cdr (nth 1 lista^rev)) 0))
      (progn
	(setq lista^rev (cddr lista^rev)
	       lista^xy (cddr lista^xy)
        )
      )
      (progn
        (alert "\Trazado no cumple requisitos.\nProbablemente existe un vértice en algún tramo recto.")
	(setvar "pdmode" 3)
	(command "point" (cdr (nth 1 lista^xy)))
	(command "zoom" "c" (cdr (nth 1 lista^xy)) 50 "")
	(quit)
      )
    )  
  )
)

(defun datos^entrada ()
  (setq indx_vertice 2 lista_vertice_kilometraje '() lista_vertice '() lista_datos '())
  (if (= (findfile "Variables Entrada.lsp") nil)
    (progn
      (alert "\nDebes revisar las opciones de configuración del sistema, alguna aplicación fue borrada o renombrada")
      (quit)
    )
    (progn
      (load (findfile "Variables Entrada.lsp"))
      (variables^entrada)
    )
  )
  (if (= (findfile "insertar layer.lsp") nil)
    (progn
      (alert "\nDebes revisar las opciones de configuración del sistema, alguna aplicación fue borrada o renombrada")
      (quit)
    )
    (progn
      (load (findfile "insertar layer.lsp"))
      (c:il)
    )
  )
  (initget (+ 1 2 4))
  (setq escala (getint "\nIngresa Escala : "))
  (initget (+ 1 4))
  (setq angulo (getreal"\nIngresa Angulo < Valor opción TWist del comando DVIEW > : "))
)

(defun procesa^entidad ()
  (setq listasoc (entget entidad))
  (while (assoc 10 listasoc)
    (setq vertice_kilometraje (cdr (assoc 10 listasoc))
    lista_vertice_kilometraje (cons vertice_kilometraje lista_vertice_kilometraje)
	             listasoc (cdr (member (assoc 10 listasoc) listasoc))
    )
  )
  (setq lista_vertice_kilometraje (reverse lista_vertice_kilometraje)
                    lista_trabajo lista_vertice_kilometraje
  )
)

(defun genera^vertices ()
  (while (> (length lista_vertice_kilometraje) 3)
    (setq inicio_primer_alineamiento (nth 0 lista_vertice_kilometraje)
	     fin_primer_alineamiento (nth 1 lista_vertice_kilometraje)
         inicio_segundo_alineamiento (nth 2 lista_vertice_kilometraje)
	    fin_segundo_alineamiento (nth 3 lista_vertice_kilometraje)
                       vertice_final (inters inicio_primer_alineamiento fin_primer_alineamiento
			                     inicio_segundo_alineamiento fin_segundo_alineamiento
			       		     nil
		      		     )
	               lista_vertice (cons vertice_final lista_vertice)
           lista_vertice_kilometraje (cdr (cdr lista_vertice_kilometraje))
    )
  )
  (setq lista_vertice (reverse lista_vertice))
)

(defun procesa^curvas ()
  (command "clayer" "GAP_Ejes")
  (while (> (length lista_trabajo) 3)
    (setq uno (nth 1 lista_trabajo)
	  dos (nth 0 lista_vertice)
         tres (nth 2 lista_trabajo)
angulo_inicial (angle uno dos)
 angulo_final (angle dos tres)
 angulo_total (abs (- angulo_inicial angulo_final))
    )
    (if (< angulo_total pi)
      (setq alfa angulo_total)
      (setq alfa (- (* 2 pi) angulo_total))
    )	     
    (setq alfa_medio (/ alfa 2)
                gama (- (/ pi 2) alfa_medio)
            tangente (- (distance (nth 0 lista_trabajo) (nth 0 lista_vertice))
			(distance (nth 0 lista_trabajo) (nth 1 lista_trabajo))
	             )
          hipotenusa (/ tangente (cos gama))
               radio (* hipotenusa (cos alfa_medio))
             secante (- hipotenusa radio)
          desarrollo (* alfa radio)
         lista_datos (cons (list
		             (nth 0 lista_vertice)
		             (rtos indx_vertice 2 0)
		             (angtos alfa 2 3)
		             (rtos radio 2 3)
		             (rtos desarrollo 2 3)
		             (rtos tangente 2 3)
	  	             (rtos secante 2 3)
		           )
	             lista_datos
	             )
    )
    (setq lista_trabajo (cdr (cdr lista_trabajo))
          lista_vertice (cdr lista_vertice)
	   indx_vertice (+ indx_vertice 1)
    )
    (command "pline" uno dos tres "")
  )
  (setq lista_datos (reverse lista_datos))
  (command "clayer" "GAP_Simbolo")
  (repeat (length lista_datos)
    (command "insert" "H:\\Informacion_GOLDER\\04-Info_Tecnica_Golder\\4600_Geomática\\Libreria\\Ingenieria\\Informacion Curva.dwg"
	              (nth 0 (car lista_datos))
	              (/ (* 1.0 escala) 1000.0)
	              (/ (* 1.0 escala) 1000.0)
	              (- 360 angulo)
                      (nth 1 (car lista_datos))
		      (nth 6 (car lista_datos))
		      (nth 5 (car lista_datos))
		      (nth 4 (car lista_datos))
	              (nth 3 (car lista_datos))
	              (nth 2 (car lista_datos))
    )
    (setq lista_datos (cdr lista_datos))
  )
  (command "clayer" 0)
)

