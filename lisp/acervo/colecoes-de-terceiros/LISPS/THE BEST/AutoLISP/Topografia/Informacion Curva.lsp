  (if (= (findfile "Variables Salida.lsp") nil)
    (progn
      (alert "\nDebes revisar las opciones de configuración del sistema, alguna aplicación fue borrada o renombrada")
      (quit)
    )
    (progn
      (load (findfile "Variables Salida.lsp"))
      (variables^salida)
    )
  )
)

(defun c:ic ()
  (captura^alineamiento)
  (if (and (/= entidad nil) (= (cdr (assoc 0 (entget entidad))) "LWPOLYLINE"))
    (progn
      (proceso^revision^polyline)
      (datos^entrada)
      (procesa^entidad)
      (genera^vertices)
      (procesa^curvas)
      (datos^salida)
    )
    (progn
      (if (= entidad nil)
        (alert "\nNo Seleccionaste Alineamiento")
	(alert "\nEntidad Seleccionada No Es Polyline")
      )
    )  
  )
)

(prompt "\nRutina Informacion Curva Version 3.0 Cargada.\nDigita < IC > Para Comenzar")

