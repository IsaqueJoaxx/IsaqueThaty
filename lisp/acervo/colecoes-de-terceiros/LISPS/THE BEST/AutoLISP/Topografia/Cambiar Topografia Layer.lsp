(defun datos^entrada ()
  (setq lista^delta '() indx 0)
  (setvar "cmdecho" 0)
  (if (= (findfile "insertar layer.lsp") nil)
    (progn
      (alert "\nDebes revisar las opciones de configuración del sistema, alguna aplicación fue borrada o renombrada")
      (quit)
    )
    (progn
      (load (findfile "insertar layer.lsp"))
      (c:il)
    )
  )
  (if (= (findfile "Variables Entrada.lsp") nil)
    (progn
      (alert "\nDebes revisar las opciones de configuración del sistema, alguna aplicación fue borrada o renombrada")
      (quit)
    )
    (progn
      (load (findfile "Variables Entrada.lsp"))
      (variables^entrada)
    )
  )
)

(defun desarrollo ()
  (initget (+ 1 2) "100 50 25 10 5")
  (setq rango (getkword "\nCurvas indice cada cuantos metros ? \n100 / 50 / 25 / 10 / 5: "))
  (setq delta (atoi rango))
  (while (<= delta 100)
    (setq lista^delta (cons
			(cond
			  ((= (strlen (rtos delta 2 0)) 1) (strcat "0" (rtos delta 2 0)))
                          ((= (strlen (rtos delta 2 0)) 2) (rtos delta 2 0))
                          ((= (strlen (rtos delta 2 0)) 3) (substr (rtos delta 2 0) 2))
        	        )
		      lista^delta
		      )
                delta (+ delta (atoi rango))
    )
  )
  (initget "N G")
  (setq opcion (getkword "\nIngresa Opción <M>/N/G : "))
  (if (/= (setq grupo (ssget)) nil)
    (progn
      (repeat (sslength grupo)
        (setq entidad (ssname grupo indx)
             listasoc (entget entidad)
	         tipo (cdr (assoc 0 listasoc))
        )
        (if (equal (cdr (assoc 0 listasoc)) "LWPOLYLINE")
          (progn
	    (if (= (strlen (rtos (fix (cdr (assoc 38 listasoc))) 2 0)) 3)
	      (setq cota (substr (rtos (cdr (assoc 38 listasoc)) 2 0) 2 2))
	      (setq cota (substr (rtos (cdr (assoc 38 listasoc)) 2 0) 3 2))
	    )
	  )  
        )
        (if (equal (cdr (assoc 0 listasoc)) "POLYLINE")
	  (progn
	    (setq entidad (entnext entidad)
		 listasoc (entget entidad)
            )
	    (if (= (strlen (rtos (fix (last (assoc 10 listasoc))) 2 0)) 3)
	      (setq cota (substr (rtos (last (assoc 10 listasoc)) 2 0) 2 2))
	      (setq cota (substr (rtos (last (assoc 10 listasoc)) 2 0) 3 2))
            )
	  )
        )
	(if (or (= tipo "LWPOLYLINE") (= tipo "POLYLINE"))
	  (progn
	    (cond
	      ((= opcion "N")
	       (if (member cota lista^delta)
		 (command "chprop" entidad "" "layer" "GAP_Curvas-Maestras-N" "")
		 (command "chprop" entidad "" "layer" "GAP_Curvas-Secundarias-N" "")
	       )
	      )
	      ((= opcion "G")
               (if (member cota lista^delta)
		 (command "chprop" entidad "" "layer" "GAP_Curvas-Maestras-G" "")
		 (command "chprop" entidad "" "layer" "GAP_Curvas-Secundarias-G" "")
	       )
	      ) 
	      (T
	       (if (member cota lista^delta)
		 (command "chprop" entidad "" "layer" "GAP_Curvas-Maestras-M" "")
		 (command "chprop" entidad "" "layer" "GAP_Curvas-Secundarias-M" "")
	       )
	      )  
	    )
	  )
	)  
        (setq indx (+ indx 1))
      )
    )
    (prompt "\No seleccionaste Curvas de Nivel")
  )
)

(defun c:ctl ()
  (datos^entrada)
  (desarrollo)
  (datos^salida)
  (princ)
 )

(defun datos^salida ()
  (if (= (findfile "Variables Salida.lsp") nil)
    (progn
      (alert "\nDebes revisar las opciones de configuración del sistema, alguna aplicación fue borrada o renombrada")
      (quit)
    )
    (progn
      (load (findfile "Variables Salida.lsp"))
      (variables^salida)
    )
  )
)

(prompt "\nRutina Cambia Curva Layer Versión 6.0 Cargada.\nDigita < CTL > Para Comenzar")

