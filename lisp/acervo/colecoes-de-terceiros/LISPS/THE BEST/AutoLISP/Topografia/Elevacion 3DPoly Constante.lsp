(defun c:epc ()
  (if (setq grupo (ssget))
    (progn
      (initget 1)
      (setq elevacion (getreal "\nIngresa elevación : "))
      (setq indx 0)
      (repeat (sslength grupo)
        (setq entidad (ssname grupo indx)
                 indx (1+ indx)
             listasoc (entget entidad)
                 tipo (cdr (assoc 0 listasoc))
        )
        (if (= tipo "POLYLINE")
          (progn
    	    (setq entidad (entnext entidad)
	         listasoc (entget entidad)
	             tipo (cdr (assoc 0 listasoc))
            )
            (while (= tipo "VERTEX")
              (setq listasoc (subst (reverse (cons elevacion (cdr (reverse (assoc 10 listasoc))))) (assoc 10 listasoc) listasoc))
              (entmod listasoc)
              (setq entidad (entnext entidad)
	           listasoc (entget entidad)
	               tipo (cdr (assoc 0 listasoc))
	      )
	    )
	    (entupd entidad)
	  )
	  (alert "Entidad Selecionada No es 3dpoly")
	)
      )
      (command "regen")
      (princ)
    )
    (progn
      (alert "No Selecionaste Nada")
      (princ)
    )
  )
)

(prompt "\nRutina Elevacion Polyline Constante Versión 3.0 Cargada.\nDigita < EPC > Para Comenzar")

(princ)