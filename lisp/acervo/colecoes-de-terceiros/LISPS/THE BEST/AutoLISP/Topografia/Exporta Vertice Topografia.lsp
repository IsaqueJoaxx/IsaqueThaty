(defun datos^entrada ()
  (setq indx_grupo 0 indx_vertice 0 lista^vertices '())
  (setq archivo (open (getfiled "Selecciona Carpeta de Destino" "c:\\" "dat" 1) "w"))
)

(defun seleccionar^topografia ()
  (setq grupo (ssget))
)

(defun desarrollo ()
  (repeat (sslength grupo)
    (setq entidad (ssname grupo indx_grupo)
         listasoc (entget entidad)
             tipo (cdr (assoc 0 listasoc))
    )
    (cond
      ((= tipo "LWPOLYLINE") (vertices^lwpolyline))
      ((= tipo "AECC_CONTOUR") (vertices^aecc_contour))
      ((= tipo "POLYLINE") (vertices^3dpoly))
    )
    (setq indx_grupo (+ indx_grupo 1))
  )
)

(defun vertices^lwpolyline ()
  (setq elevacion (cdr (assoc 38 listasoc)))
  (while (/= (setq par^vertice (assoc 10 listasoc)) nil)
    (setq lista^vertices (cons (cdr par^vertice) lista^vertices)
	        listasoc (cdr (member par^vertice listasoc))
    )
  )
  (escritura^archivo)
)

(defun vertices^aecc_contour ()
  (setq elevacion (cdr (assoc 40 listasoc)))
  (while (/= (setq par^vertice (assoc 10 listasoc)) nil)
    (setq lista^vertices (cons (cdr par^vertice) lista^vertices)
	        listasoc (cdr (member par^vertice listasoc))
    )
  )
  (escritura^archivo)
)

(defun vertices^3dpoly ()
  (setq entidad (entnext entidad)
       listasoc (entget entidad)
	   tipo (cdr (assoc 0 listasoc))
  )
  (while (= tipo "VERTEX")
    (setq vertice (cdr (assoc 10 listasoc))
   lista^vertices (cons vertice lista^vertices)
          entidad (entnext entidad)
	 listasoc (entget entidad)
	     tipo (cdr (assoc 0 listasoc))
    )
  )
  (escritura^archivo)
)

(defun escritura^archivo ()
  (setq lista^vertices (reverse lista^vertices))
  (repeat (length lista^vertices)
    (if (= tipo "LWPOLYLINE")
      (write-line (strcat (rtos (nth 0 (car lista^vertices)) 2 2) "," (rtos (nth 1 (car lista^vertices)) 2 2) "," (rtos elevacion 2 2)) archivo)
      (write-line (strcat (rtos (nth 0 (car lista^vertices)) 2 2) "," (rtos (nth 1 (car lista^vertices)) 2 2) "," (rtos (nth 2 (car lista^vertices)) 2 2)) archivo)
    )
    (setq lista^vertices (cdr lista^vertices))
  )
)

(defun datos^salida ()
  (close archivo)
)  

(defun c:evt ()
  (datos^entrada)
  (seleccionar^topografia)
  (desarrollo)
  (datos^salida)
  (princ)
)

(prompt "\nRutina Exporta Vertices Topografia Version 3.0 Cargada.\nDigita < EVT > Para Comenzar")

(princ)