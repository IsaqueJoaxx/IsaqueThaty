(defun c:vsp ()
  (while
    (= (setq entidad (car (entsel "\nSelecciona Polylinea: "))) nil)
  )
  (setq listasoc (entget entidad)
	  inicio (assoc 10 listasoc)
             fin (cdr (assoc 10 (cdr (member (assoc 10 listasoc) listasoc))))
	  inicio (cdr inicio)
             xy1 (polar fin (angle fin inicio) (/ (distance fin inicio) 4))
             xy2 (polar xy1 (+ (angle fin inicio) (/ pi 2)) (/ (distance fin inicio) 4))
             xy3 (polar xy1 (- (angle fin inicio) (/ pi 2)) (/ (distance fin inicio) 4))
  )
  (command "pline" inicio fin xy3 xy2 fin "")
  (initget "No")
  (if (= (getkword "\nInvertir Sentido de la Polylinea <Si>/No: ") nil)
    (progn
      (if (= (findfile "Invertir Sentido Polylinea.lsp") nil)
        (progn
          (alert "\nDebes revisar las opciones de configuración del sistema, alguna aplicación fue borrada o renombrada")
          (quit)
        )
        (progn
          (load (findfile "Invertir Sentido Polylinea.lsp"))
          (c:isp)
        )
      )
    )
  )
  (command "erase" (entlast) "")
  (princ)
)