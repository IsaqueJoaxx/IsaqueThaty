(defun datos^entrada ()
  (if (= (findfile "Variables Entrada.lsp") nil)
    (progn
      (alert "\nDebes revisar las opciones de configuración del sistema, alguna aplicación fue borrada o renombrada")
      (quit)
    )
    (progn
      (load (findfile "Variables Entrada.lsp"))
      (variables^entrada)
    )
  )
  (initget "1 2")
  (setq opcion (getkword "\nOpcion [ 1 / 2 <3> ] : "))
  (cond
    ((= opcion "1") (elevar^topografia^vecina))
    ((= opcion "2") (elevar^curva^delta))
    (t (elevar^curva^texto))
  )
)

(defun elevar^topografia^vecina ()
  (while (/= (setq entidad (car (entsel "\nSelecciona Curva Elevada : "))) nil)
    (if (= (cdr (assoc 0 (entget entidad))) "POLYLINE")
      (progn
	(setq entidad (entnext entidad)
	     listasoc (entget entidad)
	    elevacion (last (assoc 10 listasoc))
        )
      )
      (setq elevacion (cdr (assoc 38 (entget entidad))))
    )  
    (setq entidad (car (entsel (strcat "\nSelecciona Curva Proxima. Elevacion "  (rtos elevacion 2 2) " m s.n.m... "))))
    (entmod (subst (cons 38 elevacion) (assoc 38 (entget entidad)) (entget entidad)))
    (command "change" entidad "" "p" "c" 3 "")
  )
)

(defun elevar^curva^delta ()
  (setq penultima^elevacion (cdr (assoc 38 (entget (car (entsel "\nSelecciona Penultima Curva Elevada : ")))))
           ultima^elevacion (cdr (assoc 38 (entget (car (entsel "\nSelecciona Ultima Curva Elevada : ")))))
	              delta (- ultima^elevacion penultima^elevacion)
    elevacion^proxima^curva (+ ultima^elevacion delta)
  )
  (while (/= (setq entidad (car (entsel (strcat "\nSeleccione Proxima Curva. Elevacion " (rtos elevacion^proxima^curva 2 2) " m s.n.m... ")))) nil)
    (command "change" entidad "" "p" "e" elevacion^proxima^curva "c" 3 "")
    (setq elevacion^proxima^curva (+ elevacion^proxima^curva delta))
  )
)

(defun elevar^curva^texto ()
  (while (/= (setq entidad^texto (car (entsel "\nSelecciona Texto Elevación : "))) nil)
    (if (= (cdr (assoc 0 (entget entidad^texto))) "TEXT")
      (progn
	(setq entidad^curva (car (entsel (strcat "\nSelecciona Curva de Nivel. Elevacion " (cdr (assoc 1 (entget entidad^texto))) " m s.n.m... "))))
	(if (= (cdr (assoc 0 (entget entidad^curva))) "LWPOLYLINE")
	  (progn
            (setq listasoc (entget entidad^curva))
            (entmod (subst (cons 38 (atoi (cdr (assoc 1 (entget entidad^texto))))) (assoc 38 listasoc) listasoc))
            (command "change" entidad^curva "" "p" "c" 3 "")
	  )
	  (quit)
	)  
      )
      (quit)
    )
  )
)

(defun datos^salida ()
  (if (= (findfile "Variables Salida.lsp") nil)
    (progn
      (alert "\nDebes revisar las opciones de configuración del sistema, alguna aplicación fue borrada o renombrada")
      (quit)
    )
    (progn
      (load (findfile "Variables Salida.lsp"))
      (variables^salida)
    )
  )
)

(defun c:ec ()
  (datos^entrada)
  (datos^salida)
  (princ)
)

(prompt "\nRutina Elevar Curvas Version 2.0 Cargada. Para Comenzar digita < EC >.\n")

(princ)