(defun datos^entrada ()
  (setq lista^cota '() indx 0 indx^nth 0)
  (setq cmdecho^old (getvar "cmdecho"))
  (setvar "cmdecho" 0)
)

(defun desarrollo ()
  (if (setq grupo^linea (ssget "x" (list '(0 . "LINE"))))
    (progn
      (nivel)
      (seleccion)
    )
    (progn
      (alert "\No existen Line")
    )
  )
)

(defun nivel ()
  (while (/= (setq entidad (ssname grupo^linea indx)) nil)
    (setq listasoc (entget entidad)
              cota (rtos (last (assoc 10 listasoc)) 2 0)
    )
    (if (= (member cota lista^cota) nil)
      (setq lista^cota (cons cota lista^cota))
    )
    (setq indx (1+ indx))
  )
  (setq lista^cota (acad_strlsort lista^cota)
              indx 0
  )
)

(defun seleccion ()
  (repeat (length lista^cota)
    (setq grupo^nivel (ssget "x" (list '(0 . "LINE")))
                nivel (atoi (nth indx^nth lista^cota))
          lista^nivel (ssadd)
    )
    (while (/= (setq entidad (ssname grupo^nivel indx)) nil)
      (setq listasoc (entget entidad)
                cota (last (assoc 10 listasoc))
      )
      (if (= cota nivel)
        (progn
          (setq lista^nivel (ssadd entidad lista^nivel))
          (prompt (strcat "\nProcesando Nivel " (rtos ( + indx^nth 1) 2 0) " de " (rtos (length lista^cota) 2 0)))
        )
      )
      (setq indx (1+ indx))
    )
    (command "pedit" lista^nivel "y" "j" lista^nivel "" "")
    (setq lista^nivel '()
             indx^nth (1+ indx^nth)
                 indx 0
    )
  )
)

(defun datos^salida ()
  (setvar "cmdecho" cmdecho^old)
  (princ)
)

(defun c:ut ()
  (datos^entrada)
  (desarrollo)
  (datos^salida)
)