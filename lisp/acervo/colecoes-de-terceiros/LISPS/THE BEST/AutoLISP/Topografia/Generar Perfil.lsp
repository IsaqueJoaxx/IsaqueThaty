)

(defun c:gp ()
  (datos_de_entrada)
  (Eje^Perfil)
  (seleccionar_curvas)
  (if (/= grupo nil)
    (progn
      (repeat (sslength grupo)
        (capturar_vertices_curva)
        (buscar_interseccion)
        (datos_de_salida)
      )
      (repeat (length lista_Perfil)
        (ordenar_valores)
      )
      (restar_inicio)
      (eje_lisp)
      (modificar_referencia)
      (escalas)
      (define_grillas)
      (ubicacion_Perfil)
      (dibuja_Terreno)
      (dibuja_Perfil)
      (if (/= grupo_eje nil)
        (dibuja_eje)
      )
      (escribe_Texto_vertical)
      (escribe_Texto_horizontal)
      (block)
    )
    (alert "\nTopografia No Cumple Requisitos : \nRevisar Nombre de Layer y/o Topografia")
  )
  (princ)
)

