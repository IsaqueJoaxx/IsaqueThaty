      (load (findfile "insertar layer.lsp"))
      (c:il)
    )
  )
  (setq lista_vertices '()
	  lista_Perfil '()
	  lista_maxima '()
	    lista_cota '()
    nueva_lista_Perfil '()
     indx_lista_Perfil 0
	  indx_Terreno 0
	          indx 0
  )
)

(defun Eje^Perfil ()
  (while
    (= (setq letra (getstring "\nIngresa Letra Perfil : ")) "")
    (alert "\nIngresa Letra Perfil")
  )
  (if (= (setq opcion (getstring "\nIndica extremos del eje o <Selecciona Eje Perfil> : ")) "" )
    (progn
      (while
        (= (setq entidad (car (entsel "\nSelecciona Eje Perfil : "))) nil)
	(alert "\nSeleciona Eje Perfil")
      )
      (setq listasoc (entget entidad))
      (if (= (cdr (assoc 0 listasoc)) "LINE")
	(progn
	  (setq inicio_Perfil (cdr (assoc 10 listasoc))
                   fin_Perfil (cdr (assoc 11 listasoc))
	  )
	)
	(progn
	  (setq inicio_Perfil (cdr (member 10 (assoc 10 listasoc)))
	             listasoc (reverse listasoc)
	           fin_Perfil (cdr (member 10 (assoc 10 listasoc)))
          )
	)
      )
    )
    (progn
      (while
        (= (setq inicio_Perfil (getpoint "\nInicio Perfil : ")) nil)
        (alert "\nInicio Perfil")
      )
      (while
        (= (setq fin_Perfil (getpoint "\nFin Perfil : ")) nil)
        (alert "\nFin Perfil")
      )
    )
  )
)

(defun seleccionar_curvas ()
  (setq grupo (ssget "x" '(
			    (-4 . "<or")
		              (-4 . "<and")
			        (8 . "GAP_Curvas-Maestras-M")
               		      (-4 . "and>")
		              (-4 . "<and")
			        (8 . "GAP_Curvas-Secundarias-M")
			      (-4 . "and>")
                              (-4 . "<and")
			        (8 . "GAP_Curvas-Maestras-N")
               		      (-4 . "and>")
		              (-4 . "<and")
			        (8 . "GAP_Curvas-Secundarias-N")
			      (-4 . "and>")
                              (-4 . "<and")
			        (8 . "GAP_Curvas-Maestras-G")
               		      (-4 . "and>")
		              (-4 . "<and")
			        (8 . "GAP_Curvas-Secundarias-G")
			      (-4 . "and>")
			    (-4 . "or>")
			  )
	      )
  )
)

(defun capturar_vertices_curva ()
  (setq entidad (ssname grupo indx)
       listasoc (entget entidad)
  )
  (if (= (cdr (assoc 0 listasoc)) "LWPOLYLINE")
    (progn
      (setq cota (cdr (assoc 38 listasoc)))
      (while listasoc
        (setq listasoc (member (assoc 10 listasoc) listasoc)
        lista_vertices (cons (cdr (car listasoc)) lista_vertices)
	      listasoc (cdr listasoc)
        )
      )
      (setq lista_vertices (reverse (cdr lista_vertices)))
    )
    (progn
      (setq entidad (entnext entidad)
           listasoc (entget entidad)
               tipo (cdr (assoc 0 listasoc))
	       cota (last (assoc 10 listasoc))
      )
      (while (= tipo "VERTEX")
	(setq coordenada (list (nth 1 (assoc 10 listasoc)) (nth 2 (assoc 10 listasoc)))
          lista_vertices (cons coordenada lista_vertices)
	         entidad (entnext entidad)
	        listasoc (entget entidad)
	            tipo (cdr (assoc 0 listasoc))
        )
      )
    )
  )
)

(defun buscar_interseccion ()
  (repeat (- (length lista_vertices) 1)
    (setq inicio_curva (car lista_vertices)
	     fin_curva (cadr lista_vertices)
    )
    (if (= (setq interseccion (inters inicio_Perfil fin_Perfil inicio_curva fin_curva)) nil)
      (setq lista_vertices (cdr lista_vertices))
      (progn
        (setq distancia (distance inicio_Perfil interseccion)
           lista_Perfil (cons (list distancia cota) lista_Perfil)
         lista_vertices (cdr lista_vertices)
	)
      )
    )
  )
)

(defun datos_de_salida ()
  (setq lista_vertices '()
                  indx (+ indx 1)
  )
)

(defun ordenar_valores ()
  (repeat (length lista_Perfil)
    (setq elemento (nth indx_lista_Perfil lista_Perfil)
         distancia (car elemento)
      lista_maxima (cons distancia lista_maxima)
 indx_lista_Perfil (+ indx_lista_Perfil 1)
    )
  )
  (setq distancia_maxima (apply 'max lista_maxima)
	      par_maximo (assoc distancia_maxima lista_Perfil)
      nueva_lista_Perfil (cons par_maximo nueva_lista_Perfil)
	    lista_Perfil (subst (list 0 0) par_maximo lista_Perfil)
  )
  (setq indx_lista_Perfil 0
	     lista_maxima '()
  )
)

(defun restar_inicio ()
  (setq distancia_minima (car (car nueva_lista_Perfil)))
  (repeat (length nueva_lista_Perfil)
    (setq elemento (nth indx_lista_Perfil nueva_lista_Perfil)
distancia_elemento (nth 0 elemento)
        diferencia (- distancia_elemento distancia_minima)
    nuevo_elemento (cons diferencia (nth 1 elemento))
nueva_lista_Perfil (subst nuevo_elemento elemento nueva_lista_Perfil)
              cota (nth 1 elemento)
        lista_cota (cons cota lista_cota)
 indx_lista_Perfil (+ indx_lista_Perfil 1)
    )
  )
  (setq cota_maxima (apply 'max lista_cota)
	cota_minima (apply 'min lista_cota)
         referencia (- (fix (apply 'min lista_cota)) 20)
    
  )
)

(defun eje_lisp ()
  (setq grupo_eje (ssget "x" (list '(0 . "LINE") '(8 . "GAP_Eje-Lisp"))))
  (if (/= grupo_eje nil)
    (progn
      (setq entidad (ssname grupo_eje 0)
           listasoc (entget entidad)
    inicio_eje_lisp (cdr (assoc 10 listasoc))
       fin_eje_lisp (cdr (assoc 11 listasoc))
      )
      (setq interseccion_eje_lisp (inters inicio_eje_lisp fin_eje_lisp inicio_Perfil fin_Perfil)
               distancia_eje_lisp (- (distance interseccion_eje_lisp inicio_Perfil) distancia_minima)
      )
    )
  )
)

(defun modificar_referencia ()
  (initget 128)
  (if (= (setq referencia_nueva (getkword (strcat "\nCota Minima Topografia : " (rtos cota_minima 2 1) ". Cota Maxima Topografia : " (rtos cota_maxima 2 1)
						  "\nCota Referencia < " (rtos referencia 2 0) " > : "
				 	  )
                                )
	 )
	 nil
      )
    (setq delta_y (- cota_maxima referencia))
    (progn
      (setq delta_y (- cota_maxima (atoi referencia_nueva))
         referencia (atoi referencia_nueva)
      )
    )
  )
)

(defun escalas ()
  (initget 1 "100 125 200 250 500 1000 1250 2000 2500 4000 5000 7500 10000 12500 25000")
  (setq escala_horizontal (getkword  "\nEscala Horizontal < 100 125 200 250 500 1000 1250 2000 2500 4000 5000 7500 10000 12500 25000 > : "))
  (initget "100 125 200 250 500 1000 1250 2000 2500 4000 5000 7500 10000 12500 25000")
  (if (= (setq escala_vertical (getkword  (strcat "\nEscala Vertical < " escala_horizontal " > : "))) nil)
    (setq escala_vertical escala_horizontal)
  )
  (setq escala_horizontal (atoi escala_horizontal)
	  escala_vertical (atoi escala_vertical)
  )
)

(defun define_grillas ()
  (while
    (= (setq grilla_vertical (getint (strcat "\nEspaciamiento Valores Grilla Vertical < Altura Perfil desde Referencia " (rtos delta_y 2 1) " > : "))) nil)
    (alert "\nEspaciamiento Grilla Vertical")
  )
  (while
    (= (setq grilla_horizontal (getint (strcat "\nEspaciamiento Valores Grilla Horizontal < Largo del Perfil " (rtos (car (last nueva_lista_Perfil)) 2 1) " > : "))) nil)
    (alert "\nEspaciamiento Grilla Horizontal")
  )
  (initget (+ 2 4) "No")
  (setq grilla (getkword "\nMostrar Grilla No/<Si> : "))
)

(defun ubicacion_Perfil ()
  (while
    (= (setq ubicacion (getpoint "\nUbicacion del Perfil : ")) nil)
    (alert "\nUbicacion del Perfil")
  )
)

(defun dibuja_Terreno ()
  (repeat (- (length nueva_lista_Perfil) 1)
    (setq elemento_Terreno (nth indx_Terreno nueva_lista_Perfil)
            xy_referencia1 (polar ubicacion 0 (/ (* 1000.0 (car elemento_Terreno)) escala_horizontal))
               xy_Terreno1 (polar xy_referencia1 (/ pi 2) (/ (* 1000.0 (- (cdr elemento_Terreno) referencia)) escala_vertical))
	      indx_Terreno (+ indx_Terreno 1)
          elemento_Terreno (nth indx_Terreno nueva_lista_Perfil)
            xy_referencia2 (polar ubicacion 0 (/ (* 1000.0 (car elemento_Terreno)) escala_horizontal))
               xy_Terreno2 (polar xy_referencia2 (/ pi 2) (/ (* 1000.0 (- (cdr elemento_Terreno) referencia)) escala_vertical))
    )
    (command "layer" "s" "GAP_Terreno" ""
             "line" xy_Terreno1 xy_Terreno2 ""
    )
  )
  (command "pedit" "l" "" "j" "all" "" "")
)

(defun dibuja_Perfil ()
  (command "layer" "s" "GAP_Perfil" "")
  (setq distancia_horizontal (/ (* 1000.0 (car (last nueva_lista_Perfil))) escala_horizontal)
  distancia_horizontal_final (polar ubicacion 0 distancia_horizontal)
  distancia_vertical_inicial (polar ubicacion (/ pi 2) (/ (* 1000.0 delta_y) escala_vertical))
    distancia_vertical_final (polar distancia_horizontal_final (/ pi 2) (/ (* 1000.0 delta_y) escala_vertical))
  )
  (command "line" distancia_vertical_inicial ubicacion distancia_horizontal_final distancia_vertical_final "")
)

(defun dibuja_eje ()
  (if (/= grupo_eje nil)
    (progn
      (setq inicio_eje_lisp (polar ubicacion 0 (/ (* 1000.0 distancia_eje_lisp) escala_horizontal))
               fin_eje_lisp (polar inicio_eje_lisp (/ pi 2) (/ (* 1000.0 delta_y) escala_vertical))
      )
      (command "layer" "s" "GAP_Ejes" "")
      (command "line" inicio_eje_lisp fin_eje_lisp "")
    )
  )
)

(defun escribe_Texto_vertical ()
  (setq indx_cota_vertical grilla_vertical)
  (setq ubicacion_referencia (polar ubicacion pi 2)
   ubicacion_Texto_elevacion (polar distancia_vertical_inicial (/ pi 2) 9)
      ubicacion_Texto_unidad (polar distancia_vertical_inicial (/ pi 2) 5)
  )
  (command "layer" "s" "GAP_Texto-General" ""
           "text" "j" "mr" ubicacion_referencia 2.5 0 (rtos referencia 2 0)
	   "text" "j" "m" ubicacion_Texto_elevacion 2.5 0 "Elevacion"
	   "text" "j" "m" ubicacion_Texto_unidad 2 0 "[m s.n.m.]"
  )
  (repeat (fix (/ delta_y grilla_vertical))
    (setq cota_nueva (+ referencia indx_cota_vertical)
ubicacion_cota_nueva (polar ubicacion_referencia (/ pi 2) (/ (* 1000.0 indx_cota_vertical) escala_vertical))
inicio_ubicacion_marca_vertical (polar ubicacion_cota_nueva 0 1)
   fin_ubicacion_marca_vertical (polar inicio_ubicacion_marca_vertical 0 1)
    )
    (command "text" "j" "mr" ubicacion_cota_nueva 2.5 0 (rtos cota_nueva 2 0))
    (command "layer" "s" "GAP_Perfil" "")
    (command "line" inicio_ubicacion_marca_vertical fin_ubicacion_marca_vertical "")
    (if (= grilla nil)
      (progn
        (command "layer" "s" "GAP_Malla-Perfil" "")
        (setq inicio_grilla (polar ubicacion (/ pi 2) (/ (* 1000.0 indx_cota_vertical) escala_vertical))
	         fin_grilla (polar inicio_grilla 0 (/ (* 1000.0 (car (last nueva_lista_Perfil))) escala_horizontal))
        )
        (command "line" inicio_grilla fin_grilla "")
      )
    )
    (command "layer" "s" "GAP_Texto-General" "")
    (setq indx_cota_vertical (+ indx_cota_vertical grilla_vertical))
  )
)

(defun escribe_Texto_horizontal ()
  (setq indx_cota_horizontal grilla_horizontal)
  (setq ubicacion_cero (polar ubicacion (* (/ pi 2) 3) 2)
ubicacion_Texto_distancia (polar distancia_horizontal_final (* (/ pi 2) 3) 10)
ubicacion_Texto_unidad (polar distancia_horizontal_final (* (/ pi 2) 3) 14)
     ubicacion_seccion (polar (polar ubicacion 0 (/ distancia_horizontal 2)) (* (/ pi 2) 3) 20)
  )
  (command "layer" "s" "GAP_Texto-General" ""
           "text" "j" "mr" ubicacion_cero 2.5 90 "0"
	   "text" "j" "m" ubicacion_Texto_distancia 2.5 0 "Distancia"
	   "text" "j" "m" ubicacion_Texto_unidad 2 0 "[m]"
  )
  (repeat (fix (/ (/ (* escala_horizontal distancia_horizontal) 1000.0) grilla_horizontal))
    (setq distancia_nueva (+ 0 indx_cota_horizontal)
ubicacion_distancia_nueva (polar ubicacion_cero 0 (/ (* 1000.0 indx_cota_horizontal) escala_horizontal))
inicio_ubicacion_marca_horizontal (polar ubicacion_distancia_nueva (/ pi 2) 1)
   fin_ubicacion_marca_horizontal (polar inicio_ubicacion_marca_horizontal (/ pi 2) 1)
    )
    (command "text" "j" "mr" ubicacion_distancia_nueva 2.5 90 (rtos distancia_nueva 2 0))
    (command "layer" "s" "GAP_Perfil" "")
    (command "line" inicio_ubicacion_marca_horizontal fin_ubicacion_marca_horizontal "")
    (if (= grilla nil)
      (progn
        (command "layer" "s" "GAP_Malla-Perfil" "")
        (setq inicio_grilla (polar ubicacion 0 (/ (* 1000.0 indx_cota_horizontal) escala_horizontal))
	         fin_grilla (polar inicio_grilla (/ pi 2) (/ ( * 1000.0 delta_y) escala_vertical))
        )
        (command "line" inicio_grilla fin_grilla "")
      )
    )
    (command "layer" "s" "GAP_Perfil" "")
    (setq indx_cota_horizontal (+ indx_cota_horizontal grilla_horizontal))
  )
  (command "clayer" 0)
)

