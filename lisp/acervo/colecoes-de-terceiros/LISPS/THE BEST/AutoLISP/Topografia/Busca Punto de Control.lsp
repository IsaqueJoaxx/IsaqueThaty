(defun datos^entrada ()
  (if (= (findfile "Variables Entrada.lsp") nil)
    (progn
      (alert "\nDebes revisar las opciones de configuración del sistema, alguna aplicación fue borrada o renombrada")
      (quit)
    )
    (progn
      (load (findfile "Variables Entrada.lsp"))
      (variables^entrada)
    )
  )
  (if (= (findfile "Captura Block.lsp") nil)
    (progn
      (alert "\nDebes revisar las opciones de configuración del sistema, alguna aplicación fue borrada o renombrada")
      (quit)
    )
    (progn
      (load (findfile "Captura Block.lsp"))
      (captura^block)
    )
  )
  (setq lista^numero^entidad '() indx 0)
)

(defun proceso ()
  (repeat (sslength grupo^block)
    (setq entidad (entnext (ssname grupo^block indx))
             indx (1+ indx)
          vertice (cdr (assoc 1 (entget entidad)))
      indx^string 1
    lista^vertice '()
    )
    (repeat (strlen vertice)
      (setq caracter (substr vertice indx^string 1)
         indx^string (1+ indx^string)
      )
      (if (and (>= (ascii caracter) 48) (<= (ascii caracter) 57))
        (setq lista^vertice (cons caracter lista^vertice))
      )
      (setq numero (atoi (apply 'strcat (reverse lista^vertice))))
    )
    (setq lista^numero^entidad (cons (cons numero entidad) lista^numero^entidad))
  )
  (initget (+ 1 2 4))
  (setq numero^buscado (getint (strcat "\nIngresa Numero del Punto de Control <Entre 1 y " (rtos (length lista^numero^entidad) 2 0) "> inclusive: ")))
  (if (> numero^buscado (length lista^numero^entidad))
    (alert "\nNumero Fuera de Rango")
    (progn
      (command "zoom" "c" (cdr (assoc 10 (entget (cdr (assoc numero^buscado lista^numero^entidad))))) "")
    )
  )
)

(defun datos^salida ()
  (if (= (findfile "Variables Salida.lsp") nil)
    (progn
      (alert "\nDebes revisar las opciones de configuración del sistema, alguna aplicación fue borrada o renombrada")
      (quit)
    )
    (progn
      (load (findfile "Variables Salida.lsp"))
      (variables^salida)
    )
  )
)

(defun c:bpc ()
  (datos^entrada)
  (proceso)
  (datos^salida)
)