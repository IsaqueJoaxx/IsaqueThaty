(defun c:ggu ()
  (datos^entrada)
  (define^datos^grilla)
  (define^grilla)
  (define^valor^grilla)
  (datos^salida)
)

(prompt "\nRutina Generar Grilla UTM Versión 3.0 Cargada.\nDigita < GGU > Para Comenzar")

(princ)