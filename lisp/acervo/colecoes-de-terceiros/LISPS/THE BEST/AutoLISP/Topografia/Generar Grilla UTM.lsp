)

(defun define^datos^grilla ()
  (initget 1 "10 20 25 50 75 100 125 200 250 400 500 750 1000 1250 2000 2500 4000 5000 10000 12500 20000 25000 40000 50000")
  (setq separacion_grilla (atoi (getkword  "\nSeparacion Grilla < 10 20 25 50 75 100 125 200 250 400 500 750 1000 1250 2000 2500 4000 5000 10000 12500 20000 25000 40000 50000> : ")))
  (initget 1 "50 75 100 125 200 250 400 500 750 1000 1250 2000 2500 4000 5000 7500 10000 12500 20000 25000 40000 50000")
  (setq escala (atoi (getkword  "\nIngresa Escala de la Planta < 50 75 100 125 200 250 400 500 750 1000 1250 2000 2500 4000 5000 7500 10000 12500 20000 25000 40000 50000> : ")))
  (initget (+ 1 2 4))
  (setq esquina_inferior_izquierda (getpoint "\nIndica Esquina Inferior Izquierda: "))
  (initget (+ 1 2 4))
  (setq esquina_superior_derecha (getpoint "\nIndica Esquina Superior Derecha: "))
)

(defun define^grilla ()
  (setq este_minimo (car esquina_inferior_izquierda)
	este_maximo (car esquina_superior_derecha)
      este_variable (* (fix (/ (/ (+ este_minimo este_maximo) 2) 1000)) 1000)
       norte_minimo (cadr esquina_inferior_izquierda)
       norte_maximo (cadr esquina_superior_derecha)
     norte_variable (* (fix (/ (/ (+ norte_minimo norte_maximo) 2) 1000)) 1000)
  )
  (while (< (+ norte_variable separacion_grilla) norte_maximo)
    (setq norte_variable (+ norte_variable separacion_grilla))
  )
  (setq norte_maximo (+ norte_variable separacion_grilla))
  (while (> (- norte_variable separacion_grilla) norte_minimo)
    (setq norte_variable (- norte_variable separacion_grilla))
  )
  (setq norte_minimo (- norte_variable separacion_grilla))
  (while (< (+ este_variable separacion_grilla) este_maximo)
    (setq este_variable (+ este_variable separacion_grilla))
  )
  (setq este_maximo (+ este_variable separacion_grilla))
  (while (> (- este_variable separacion_grilla) este_minimo)
    (setq este_variable (- este_variable separacion_grilla))
  )
  (setq este_minimo (- este_variable separacion_grilla))
  (command "layer" "s" "GAP_Cuadricula" "")
  (setq indx_norte 1 indx_este 1)
  (command "line" (list este_minimo norte_minimo) (list este_maximo norte_minimo) "")
  (repeat (/ (- norte_maximo norte_minimo) separacion_grilla)
    (command "line" (list este_minimo (+ norte_minimo (* separacion_grilla indx_norte)))
	            (list este_maximo (+ norte_minimo (* separacion_grilla indx_norte)))
	     ""
    )
    (setq indx_norte (+ indx_norte 1))
  )
  (command "line" (list este_minimo norte_minimo) (list este_minimo norte_maximo) "")
  (repeat (/ (- este_maximo este_minimo) separacion_grilla)
    (command "line" (list (+ este_minimo (* separacion_grilla indx_este)) norte_minimo)
	            (list (+ este_minimo (* separacion_grilla indx_este)) norte_maximo)
	     ""
    )
    (setq indx_este (+ indx_este 1))
  )
)

(defun define^valor^grilla ()
  (setq indx_valor_grilla 0)
  (command "layer" "s" "GAP_Texto-Malla-UTM" "")
  (setq grupo_grilla (ssget "C" (append (list este_minimo) (list norte_minimo))
			        (append (list este_maximo) (list norte_maximo))
			        (list '(0 . "LINE") '(8 . "GAP_Cuadricula"))
                     )
  )
  (repeat (sslength grupo_grilla)
    (setq entidad_grilla (ssname grupo_grilla indx_valor_grilla)
         listasoc_grilla (entget entidad_grilla)
           inicio_grilla (cdr (assoc 10 listasoc_grilla))
              fin_grilla (cdr (assoc 11 listasoc_grilla))
    )
    (if (= (nth 0 inicio_grilla) (nth 0 fin_grilla))
      (progn
	(if (< (nth 1 inicio_grilla) (nth 1 fin_grilla))
          ()
          (setq inicio_grilla fin_grilla)
	)
	(setq valor_este (nth 0 inicio_grilla)
     posicion_valor_este (polar inicio_grilla pi (/ (* 1 escala) 1000.0))
	)
	(command "text" posicion_valor_este (/ (* 3 escala) 1000.0) 90 (strcat "E " (rtos valor_este 2 0)))
      )
      (progn
	(if (< (nth 0 inicio_grilla) (nth 0 fin_grilla))
          ()
          (setq inicio_grilla fin_grilla)
	)
	(setq valor_norte (nth 1 inicio_grilla)
     posicion_valor_norte (polar inicio_grilla (/ pi 2) (/ (* 1 escala) 1000.0))
	)
	(command "text" posicion_valor_norte (/ (* 3 escala) 1000.0) 0 (strcat "N " (rtos valor_norte 2 0)))
      )
    )
    (setq indx_valor_grilla (+ indx_valor_grilla 1))
  )
)

