(defun datos^entrada ()
  (if (= (findfile "Variables Entrada.lsp") nil)
    (progn
      (alert "\nDebes revisar las opciones de configuración del sistema, alguna aplicación fue borrada o renombrada")
      (quit)
    )
    (progn
      (load (findfile "Variables Entrada.lsp"))
      (variables^entrada)
    )
  )
  (setq lista^tmp '()
        lista^par '()
             indx 0
  )
)

(defun desarrollo ()
  (setq listasoc (entget entidad))
  (if (= (cdr (assoc 0 listasoc)) "LWPOLYLINE")
    (repeat (length listasoc)
      (if (= (car (nth indx listasoc)) 10)
        (setq lista^par (cons (nth indx listasoc) lista^par))
      )
      (setq indx (1+ indx))
    )
    (progn
      (alert "\nEntidad Selelecionada no es LWPolyline")
      (quit)
    )
  )
  (setq indx 0)
  (repeat (length listasoc)
    (if (/= (car (nth indx listasoc)) 10)
      (setq lista^tmp (cons (nth indx listasoc) lista^tmp)
      )
      (progn
	(setq lista^tmp (cons (car lista^par) lista^tmp)
              lista^par (cdr lista^par)
        )
      )
    )
    (setq indx (1+ indx))
  )
  (setq listasoc (reverse lista^tmp))
  (entmod listasoc)
)

(defun datos^salida ()
  (if (= (findfile "Variables Salida.lsp") nil)
    (progn
      (alert "\nDebes revisar las opciones de configuración del sistema, alguna aplicación fue borrada o renombrada")
      (quit)
    )
    (progn
      (load (findfile "Variables Salida.lsp"))
      (variables^salida)
    )
  )
)

(defun c:isp ()
  (datos^entrada)
  (desarrollo)
  (datos^salida)
)