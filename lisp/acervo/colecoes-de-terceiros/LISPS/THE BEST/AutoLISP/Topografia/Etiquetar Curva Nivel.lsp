(defun capturar^curvas ()
  (setq grupo (ssget "x" '(
			    (-4 . "<or")
			      (8 . "GAP_Curvas-Maestras-G")
                              (8 . "GAP_Curvas-Maestras-M")
			      (8 . "GAP_Curvas-Maestras-N")
			    (-4 . "or>")
			  )
	       )
  )
)

(defun datos^entrada ()
  (if (= (findfile "Variables Entrada.lsp") nil)
    (progn
      (alert "\nDebes revisar las opciones de configuración del sistema, alguna aplicación fue borrada o renombrada")
      (quit)
    )
    (progn
      (load (findfile "Variables Entrada.lsp"))
      (variables^entrada)
    )
  )
  (if (= (findfile "insertar layer.lsp") nil)
    (progn
      (alert "\nDebes revisar las opciones de configuración del sistema, alguna aplicación fue borrada o renombrada")
      (quit)
    )
    (progn
      (load (findfile "insertar layer.lsp"))
      (c:il)
    )
  )
  (if (= (findfile "GAP_Arial.lsp") nil)
    (progn
      (alert "\nDebes revisar las opciones de configuración del sistema, alguna aplicación fue borrada o renombrada")
      (quit)
    )
    (progn
      (load (findfile "GAP_Arial.lsp"))
      (GAP_arial)
    )
  )
  (command "clayer" "GAP_Texto-Curvas")
  (setq indx 0)
)

(defun eje^alineamiento ()
  (while
    (= (setq inicio_alineamiento (getpoint "\nInicio Alineamiento : ")) nil)
    (alert "\nInicio Alineamiento")
  )
  (while
    (= (setq fin_alineamiento (getpoint "\nFin Alineamiento : ")) nil)
    (alert "\nFin Alineamiento")
  )
  (initget 1 "100 125 200 250 500 750 1000 1250 2000 2500 4000 5000 7500 10000 12500 20000 25000 40000 50000")
  (setq escala (atoi (getkword  "\nIngresa Escala del Dibujo < 100 125 200 250 500 750 1000 1250 2000 2500 4000 5000 7500 10000 12500 20000 25000 40000 50000> : ")))
)

(defun desarrollo ()
  (repeat (sslength grupo)
    (setq entidad (ssname grupo indx)
         listasoc (entget entidad)
    )
    (if (= (cdr (assoc 0 listasoc)) "LWPOLYLINE")
      (progn
	(setq cota (cdr (assoc 38 listasoc))
	  listasoc (member (assoc 10 listasoc) listasoc)
   vertice_inicial (cdr (car listasoc))
         listasoc (cdr listasoc)
        )
        (while listasoc
	  (if (/= (setq listasoc (member (assoc 10 listasoc) listasoc)) nil)
	    (progn
	      (setq vertice_final (cdr (car listasoc)))
              (buscar^interseccion)
              (setq vertice_inicial vertice_final
	                   listasoc (cdr listasoc)
	      )
            )
	  )
        )
      )
      (progn
        (setq entidad (entnext entidad)
             listasoc (entget entidad)
                 tipo (cdr (assoc 0 listasoc))
	         cota (last (assoc 10 listasoc))
      vertice_inicial (list (nth 1 (assoc 10 listasoc)) (nth 2 (assoc 10 listasoc)))
        )
        (while (= tipo "VERTEX")
          (setq entidad (entnext entidad)
               listasoc (entget entidad)
                   tipo (cdr (assoc 0 listasoc))
	  )
	  (if (/= tipo "SEQEND")
            (setq vertice_final (list (nth 1 (assoc 10 listasoc)) (nth 2 (assoc 10 listasoc))))
	  )  
	  (buscar^interseccion)
          (setq vertice_inicial vertice_final)
        )
      )
    )
    (setq indx (+ indx 1))
  )
)
        
(defun buscar^interseccion ()
  (if (setq interseccion (inters inicio_alineamiento fin_alineamiento vertice_inicial vertice_final))
    (command "text" "j" "m" interseccion (/ (* 2 escala) 1000.0)
	                                 (- (atof (angtos (angle inicio_alineamiento fin_alineamiento) 0 1)) 90)
					 (rtos cota 2 0)
    )
  )
)

(defun datos^salida ()
  (if (= (findfile "Variables Salida.lsp") nil)
    (progn
      (alert "\nDebes revisar las opciones de configuración del sistema, alguna aplicación fue borrada o renombrada")
      (quit)
    )
    (progn
      (load (findfile "Variables Salida.lsp"))
      (variables^salida)
    )
  )
)  

(defun c:ecn ()
  (capturar^curvas)
  (if (/= grupo nil)
    (progn
      (datos^entrada)
      (eje^alineamiento)
      (desarrollo)
    )
    (alert "\nTopografia No Cumple Requisitos : \nRevisar Nombre de Layer y/o Topografia")
  )
  (datos^salida)
)

(prompt "\nRutina Etiquetar Curva Nivel Versión 2.0 Cargada.\nDigita < ECN > Para Comenzar")

(princ)