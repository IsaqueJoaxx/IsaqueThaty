(defun datos^entrada ()
  (setq indx 0)
  (setvar "cmdecho" 0)
)

(defun desarrollo ()
  (if (= (findfile "Rango Curvas Nivel.lsp") nil)
    (progn
      (alert "\nDebes revisar las opciones de configuración del sistema, alguna aplicación fue borrada o renombrada")
      (quit)
    )
    (progn
      (load (findfile "Rango Curvas Nivel.lsp"))
      (rango^curvas^nivel)
    )
  )
  (initget (+ 1 2 4))
  (setq cota (getreal "\nIngresa cota a buscar : "))
  (while (/= (>= cota^maxima cota cota^minima) T)
    (initget (+ 1 2 4))
    (prompt "\nCota ingresada esta fuera de rango")
    (setq cota (getreal "\nIngresa cota a buscar : "))
  )
  (initget "1 2 3 4 5 6 7 BYLAYER")
  (if (= (setq color (getkword "\nIngresa numero de color para identificacion de la curva \n1/2/3/4/5/6/7/<BYLAYER> : ")) nil)
    (setq color "bylayer")
  )
  (repeat (sslength grupo^curvas)
    (setq entidad (ssname grupo^curvas indx)
         listasoc (entget entidad)
    )
    (if (equal (cdr (assoc 0 listasoc)) "LWPOLYLINE")
      (progn
        (setq cota^curva (cdr (assoc 38 listasoc)))
        (if (= cota^curva cota)
          (cambio^color)
        )
      )
    )
    (if (equal (cdr (assoc 0 listasoc)) "POLYLINE")
      (progn
	(setq entidad (entnext entidad)
	     listasoc (entget entidad)
           cota^curva (last (assoc 10 listasoc))
	)
        (if (= cota^curva cota)
          (cambio^color)
        )
      )
    )
    (setq indx (1+ indx))
  )
)

(defun cambio^color ()
  (command "change" entidad "" "p" "c" color "")
)

(defun c:bcn ()
  (datos^entrada)
  (desarrollo)
)