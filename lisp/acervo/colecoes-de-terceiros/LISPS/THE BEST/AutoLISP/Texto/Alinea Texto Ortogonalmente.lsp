(defun c:ato ()
  (setq grupo (ssget) indx 0)
  (initget 7)
  (setq pt^xy (getpoint "\nIndique Referencia : "))
  (initget "H")
  (setq opcion (getkword "\nAlineamiento H / <V> : "))
  (if (= opcion nil)
    (progn
      (repeat (sslength grupo)
        (setq listasoc (entget (ssname grupo indx))
	          indx (+ indx 1)
                par^xy (assoc 10 listasoc)
              listasoc (subst (subst (nth 0 pt^xy) (nth 1 par^xy) par^xy) par^xy listasoc)
        )
        (entmod listasoc)
      )
    )
    (progn
      (repeat (sslength grupo)
        (setq listasoc (entget (ssname grupo indx))
	          indx (+ indx 1)
                par^xy (assoc 10 listasoc)
              listasoc (subst (subst (nth 1 pt^xy) (nth 2 par^xy) par^xy) par^xy listasoc)
        )
        (entmod listasoc)
      )
    )
  )
  (princ)
)

(prompt "\nRutina Alinea Texto Ortogonalmente Versión 3.0 Cargada.\nDigita < ATO > Para Comenzar")

(princ)