(defun c:mm ()
  (setq indx 0)
  (initget "1")
  (setq opcion (getkword "\nTrasforma Minúscula a Mayúscula < Enter > / Viceversa <1>: "))
  (setq grupo (ssget))
  (repeat (sslength grupo)
    (setq entidad (ssname grupo (- (setq indx (1+ indx)) 1))
	 listasoc (entget entidad)
    )
    (if (or (= (cdr (assoc 0 listasoc)) "TEXT") (= (cdr (assoc 0 listasoc)) "MTEXT"))
      (progn
        (if (= opcion nil)
          (setq listasoc (subst (cons 1 (strcase (cdr (assoc 1 listasoc)))) (assoc 1 listasoc) listasoc))
          (setq listasoc (subst (cons 1 (strcase (cdr (assoc 1 listasoc)) min)) (assoc 1 listasoc) listasoc))
	)
	(entmod listasoc)
      )
    )
  )
  (princ)
)

(prompt "\nRutina Cambia Texto Minuscula a Mayuscula y viceversa Versión 1.0 Cargada.\nDigita < MM > Para Comenzar")

(princ)