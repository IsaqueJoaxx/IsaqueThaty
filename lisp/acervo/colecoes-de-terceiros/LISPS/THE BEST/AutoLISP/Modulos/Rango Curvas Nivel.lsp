(defun rango^curvas^nivel ()
  (setq	indx^rango 0
	lista^zeta '()
  )
  (if
    (/=
      (setq grupo^curvas
	     (ssget "x"
		    '(
		      (-4 . "<or")
		       (-4 . "<and")
		         (8 . "GAP_Curvas-Maestras-M")
		       (-4 . "and>")
		       (-4 . "<and")
		         (8 . "GAP_Curvas-Secundarias-M")
		       (-4 . "and>")
		       (-4 . "<and")
		         (8 . "GAP_Curvas-Maestras-N")
		       (-4 . "and>")
		       (-4 . "<and")
		         (8 . "GAP_Curvas-Secundarias-N")
		       (-4 . "and>")
		       (-4 . "<and")
		         (8 . "GAP_Curvas-Maestras-G")
		       (-4 . "and>")
		       (-4 . "<and")
		         (8 . "GAP_Curvas-Secundarias-G")
		       (-4 . "and>")
		       (-4 . "or>")
		     )
	     )
      )
      nil
    )
    (progn
      (repeat (sslength grupo^curvas)
	(setq entidad (ssname grupo^curvas indx^rango)
	     listasoc (entget entidad)
        )
	(if (equal (cdr (assoc 0 listasoc)) "LWPOLYLINE")
	  (setq zeta (cdr (assoc 38 listasoc)))
	)
	(if (equal (cdr (assoc 0 listasoc)) "POLYLINE")
	  (setq zeta (last (assoc 10 (entget (entnext entidad)))))
	)
	(if (= (member zeta lista^zeta) nil)
	  (setq lista^zeta (cons zeta lista^zeta))
	)
	(setq indx^rango (+ indx^rango 1))
      )
      (setq cota^minima (apply 'min lista^zeta)
	    cota^maxima (apply 'max lista^zeta)
	          rango (/ (- cota^maxima cota^minima) (- (length lista^zeta) 1))
      )
      (prompt (strcat "\nCota Minima : " (rtos cota^minima 2 2) " m s.n.m. ; Cota Maxima : " (rtos cota^maxima 2 2) " m s.n.m."))
    )
  )
)