(defun falma(/ entcy)
(COMMAND"_.UCS""3P"P2 (PD P2 100) (LIST (CAR P2)(CADR P2) 100))
(COMMAND"_cylinder"(pd (list 0 0 0) rm)"D" df larg)(SETQ ENTcy(ENTLAST))
(COMMAND"_.ARRAY""SI"ENTcy"P""0,0,0"NF"""Y")
(SETQ furos(SSADD))(REPEAT nf(SETQ furos(SSADD entcy furos) entcy(entnext entcy)))
(COMMAND"_.UCS""W"));defun
(DEFUN DENTE3D(/ P1 P3 P4 P5 P6 P7 P8 P9 P10 P11 ENT2)
(COMMAND"_.VPOINT""R""315""30")(falma)
(COMMAND"_.REGION"ENT1"")(SETQ ENTR(ENTLAST))
(SETQ P1 P29
      P2(PD P1 HD)
      P3(LIST (CAR P1) (CADR P1) (/ TB 2))
      P4(LIST (CAR P1) (CADR P1) (/ TB -2))
      P5(LIST (CAR P2) (CADR P2) (/ TD 2))
      P6(LIST (CAR P2) (CADR P2) (/ TD -2))
      P7(PD P30 HD)
      P8(LIST (CAR P30) (CADR P30) (/ TB 2))
      P9(LIST (CAR P30) (CADR P30) (/ TB -2))
     P10(LIST (CAR P7) (CADR P7) (/ TD 2))
     P11(LIST (CAR P7) (CADR P7) (/ TD -2))
)
(COMMAND"_.LINE"P2 P7"")(SETQ L0(ENTLAST))
(COMMAND"_.LINE"P3 P4"")(SETQ L1(ENTLAST))
(COMMAND"_.LINE"P4 P6"")(SETQ L2(ENTLAST))
(COMMAND"_.LINE"P6 P5"")(SETQ L3(ENTLAST))
(COMMAND"_.LINE"P5 P3"")(SETQ L4(ENTLAST))
(COMMAND"_.UCS""3P"P3 P4 (PD P3 100))
(COMMAND"_PEDIT"L1"Y""J"L2 L3 L4"""")(SETQ ENTDE(ENTLAST))
(COMMAND"_.REGION"ENTDE"")(SETQ ENTDE(ENTLAST))
(COMMAND"_EXTRUDE""SI"ENTDE"P"L0)(SETQ ENT2(ENTLAST))
(COMMAND"_.UCS""W")
(COMMAND"_.UCS""3P"P0 (PD P0 100) (LIST (CAR P0)(CADR P0) 100))
(COMMAND"_.ARRAY""SI"ENT2"P""0,0,0"Z"""Y")
(SETQ DENTES(SSADD))(REPEAT Z(SETQ DENTES(SSADD ENT2 DENTES) ENT2(ENTNEXT ENT2)))
(COMMAND"_.CIRCLE""0,0,0""D"DI)(SETQ ENTPA(ENTLAST))
(COMMAND"_.EXTRUDE""SI"ENTR"P"ENTPA)(SETQ ENTCO(ENTLAST))
(PROMPT "Aguarde . . . .")
(COMMAND"_UNION"ENTCO DENTES"")(SETQ ENTCO(ENTLAST))
(ENTDEL ENTPA)(ENTDEL L0)
(COMMAND"_.UCS""W")
(COMMAND"_.subtract""SI" ENTCO "SI" FUROS)
