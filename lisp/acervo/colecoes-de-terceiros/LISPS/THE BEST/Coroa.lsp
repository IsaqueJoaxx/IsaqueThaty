(DEFUN DESENHAR(/ LP1 LP2)
(SETQ DP(* M Z)
      DI(- DP (* 2.332 M))
      DE(+ DP (* 2.0 M))
      DC(- DE (* 10.0 M))
      DB(FIX (* 1.6 FURO))
      rm(fix (+ (/ db 2) (/ (- dc db) 4)))
      df(fix (/ (- dc db) 3.5))
      NF(FIX (/ (* PI (- DC DB)) 2 DF))
      S(* 0.4875 M PI)
     TD(- S (* 2 M 0.36397))
     TB(+ S (* 2 1.166 M 0.36397))
     HD(/ (- DE DI) 2)
    ALMA(FIX (/ LARG 3))
    RAIO(FIX (/ ALMA 4))
 CHANFRO(FIX (/ LARG 15))
)
