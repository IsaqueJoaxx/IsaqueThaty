(DEFUN PE(P0 DIST / P0 P1 DIST)(SETQ P1(POLAR P0 (+ Apd pi) DIST)))
(DEFUN PB(P0 DIST / P0 P1 DIST)(SETQ P1(POLAR P0 (+ (+ Apd pi) (/ pi 2)) DIST)))

