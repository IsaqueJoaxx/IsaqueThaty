(defun c:22()
  (command "ucs" "w")
  (setq a (getangle "\nIngrese angulo :"))
  (setq a (/ (* 180 a) pi ))
  (command "ucs" "z" a)
  (princ "\n Seleccione conjunto de cotas: ")
  (setq conjunto (ssget))
  (setq contador 0)
  (repeat (sslength conjunto)
    (setq cota (ssname conjunto contador))
    (command "luprec" "2" "dim" "tedit" cota "h" "tedit" cota "@-.18,-.18" "e") 
    (setq contador (+ 1 contador))
  ) ;;fin del repeat
  (command "ucs" "w")
)
