(defun c:aw()
        (graphscr)
        (terpri)
        (command "ucs" "w")
        (setq a (getangle "\nIngrese angulo :"))
        (setq a (/ (* 180 a) pi ))
        (command "orthomode" "1" "osmode" "0" "ucs" "z" a "dim" (c:cotas) "exit" "ucs" "w")
        (terpri)
)
;
(defun c:flec()
        (graphscr)
        (terpri)
        (command "osnap" "end" "ucs" "")
        (setq cu(getvar "clayer")) 
        (setq s (getreal "\nIngrese factor de escala :"))
        (setq a (getangle "\nIngrese angulo de la flecha :"))
        (setq a (/ (* 180 a) pi ))
        (command "ucs" "w" "ucs" "z" a)
        (setq p (getpoint "\nIngrese punto inicial :"))
        (command "layer" "s" "cotas" "" "osmode" "0" "pline" p "w" "0" "0.03" "@.15<0" "" "plinewid" "0" "scale" "l" "" p s "ucs" "w" "layer" "s" cu "")
        (terpri)
)
;
