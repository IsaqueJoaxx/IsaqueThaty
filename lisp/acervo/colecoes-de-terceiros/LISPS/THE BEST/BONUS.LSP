(defun c:dde()
        (graphscr)
        (terpri)
        (prompt "Seleccione cota a cambiar texto :")(terpri)
        (setq aa1 (ssget))
        (prompt "Seleccione la cota que contenga el nuevo texto :")(terpri)
        (setq aa2 (entsel))
        (setq n (sslength aa1))
        (setq index 0)
        (setq ab2 (entget (car aa2)))
        (setq ad2 (assoc 1 ab2))
        (repeat n
                (setq ab1 (entget (ssname aa1 index)))
                (setq ad1 (assoc 1 ab1))
                (setq ab3 (subst ad2 ad1 ab1))
                (entmod ab3)
                (setq index (+ index 1))
        )
        (terpri)
)
