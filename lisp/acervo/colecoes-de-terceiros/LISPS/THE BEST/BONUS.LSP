(defun c:cz()
        (graphscr)
        (terpri)
        (prompt "Selecione entidades a cambiar :")(terpri)
        (setq a1 (ssget))
        (prompt "Seleccione el layer de la nueva entidad :")(terpri)
        (setq a2 (entsel))
        (setq n (sslength a1))
        (setq index 0)
        (setq b2 (entget (car a2)))
        (setq d2 (assoc 8 b2))
        (repeat n
                (setq b1 (entget (ssname a1 index)))
                (setq d1 (assoc 8 b1))
                (setq b3 (subst d2 d1 b1))
                (entmod b3)
                (setq index (+ index 1))
        )
        (terpri)
)
;
