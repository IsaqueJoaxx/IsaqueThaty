(defun c:nume (/ h ni p1)
(setq h (getreal "\nAltura da letra:"))
(setq ni (getint "\nNumero inicial: "))
         (if (= ni nil)(setq ni 1))
(setq p1 t)
  (while (/= nil p1)
(setq p1 (getpoint "\nPonto de insercao:"))
         (if (= p1 nil)
             (prompt "\n ")
             (progn
  (command "text" p1 h 0 ni)
(setq ni (+ ni 1))
                 )
                )
               )
              )
(princ "\n------- Digite \"NUME PARA INICIAR COMANDO...\"")