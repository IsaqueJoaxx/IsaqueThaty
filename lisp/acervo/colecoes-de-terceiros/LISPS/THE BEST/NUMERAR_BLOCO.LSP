(princ "\n----- Digite \"Nblock para Iniciar Comando...\"")
(defun c:Nblock (/ h ni p1)
(setq h (getreal "\nAltura da letra:"))
(setq ni (getint "\nNumero inicial: "))
         (if (= ni nil)(setq ni 1))
(setq p1 t)
  (while (/= nil p1)
(setq p1 (getpoint "\nPonto de insercao:"))
(command "-insert" "C:/p.dwg" p1 "" "" "") 
         (if (= p1 nil)
             (prompt "\n ")
             (progn
(command "text" p1 h ni)
(setq ni (+ ni 1))
                 )
                )
               )
              )
