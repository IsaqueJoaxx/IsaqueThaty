(vmon)
(defun C:HNUTS ()
   (setvar "cmdecho" 0)
   (prompt "\nCurrent Thread Dia.:")
   (print bw)
   (setq bwx (getdist "\nIndicate New Thread Dia.: "))
   (if (= bwx nil) (setq bw bw) (setq bw bwx))
   (prompt "\nCurrent Angle:")
   (print a2)
   (setq a1x (getangle "\nIndicate New Angle: "))
   (if (= a1x nil) (setq a1 a1) (setq a1 a1x))
   (setq a2 (* (/ a1 (* pi 2.0)) 360))
   (setq rac 1.732)
   (if (<= bw 0.450) (setq rac 1.816))
   (if (<= bw 0.390) (setq rac 1.760))
   (if (<= bw 0.340) (setq rac 1.849))
   (if (<= bw 0.260) (setq rac 2.020))
   (if (<= bw 0.200) (setq rac 2.279))
   (if (<= bw 0.170) (setq rac 2.421))
   (if (<= bw 0.150) (setq rac 2.654))
   (setq rat 0.855)
   (if (<= bw 0.640) (setq rat 0.873))
   (if (<= bw 0.450) (setq rat 0.858))
   (if (<= bw 0.390) (setq rat 0.875))
   (if (<= bw 0.340) (setq rat 0.849))
   (if (<= bw 0.260) (setq rat 0.872))
   (if (<= bw 0.200) (setq rat 0.658))
   (if (<= bw 0.170) (setq rat 0.762))
   (if (<= bw 0.150) (setq rat 0.801))
   (setq ip (getpoint "\nIndicate Insertion Point: "))
   (setvar "blipmode" 0)
   (setq ltp (getvar "celtype"))
   (command "linetype" "S" "continuous")
   (command "")
   (setq thk (* bw rat))
   (setq p9 (polar ip a1 thk))
   (setq hac (/ (* rac bw) 2.0))
   (setq haf (/ (* rac bw) 4.0))
   (setq a4 (/ pi 2.0))
   (setq a3 (+ pi (/ pi 2.0)))
   (setq p1 (polar ip (+ a1 a3) hac))
   (setq p2 (polar ip (+ a1 a3) haf))
   (setq p3 (polar ip (+ a1 a4) haf))
   (setq p4 (polar ip (+ a1 a4) hac))
   (setq p5 (polar p1 a1 (* thk 0.85)))
   (setq p6 (polar p2 a1 (* thk 0.85)))
   (setq p7 (polar p3 a1 (* thk 0.85)))
   (setq p8 (polar p4 a1 (* thk 0.85)))
   (setq p11 (polar p9 (+ a1 a4) (+ haf (/ haf 2.0))))
   (setq p10 (polar p9 (+ a1 a3) (+ haf (/ haf 2.0))))
   (command "arc" p5 p10 p6)
   (command "arc" p6 p9 p7)
   (command "arc" p7 p11 p8)
   (command "line" p8 p4 p1 p5)
   (command "")
   (command "line" p10 p11)
   (command "")
   (command "line" p2 p6)
   (command "")
   (command "line" p3 p7)
   (command "")
   (command "linetype" "S" ltp)
   (command "")
   (setvar "blipmode" 1)
)
(defun C:SHCSS ()
   (setvar "cmdecho" 0)
   (prompt "\nCurrent Thread Dia.:")
   (print bw)
   (setq bwx (getdist "\nIndicate New Thread Dia.: "))
   (if (= bwx nil) (setq bw bw) (setq bw bwx))
   (prompt "\nCurrent Screw Length:")
   (print sbl)
   (setq sblx (getdist "\nIndicate New Screw Lgth.: "))
   (if (= sblx nil) (setq sbl sbl) (setq sbl sblx))
   (prompt "\nCurrent Angle:")
   (print a2)
   (setq a1x (getangle "\nIndicate New Angle: "))
   (if (= a1x nil) (setq a1 a1) (setq a1 a1x))
   (setq a2 (* (/ a1 (* pi 2.0)) 360))
   (repeat 100
      (setq ip (getpoint "\nIndicate Insertion Point: "))
      (setvar "blipmode" 0)
      (setq ltp (getvar "celtype"))
      (command "linetype" "S" "continuous")
      (command "")
      (setq hd (* 1.50 bw))
      (if (<= bw 0.24) (setq hd (* 1.64 bw)))
      (setq ch (* bw 0.12))(setq c1 (polar ip (+ a1 pi) bw))
      (setq p1 (polar ip (+ a1 (/ pi 2.0)) (/ hd 2.0)))
      (setq p2 (polar ip (+ a1 pi (/ pi 2.0)) (/ hd 2.0)))
      (setq p3 (polar p1 (+ a1 pi) (- bw ch)))
      (setq p4 (polar p2 (+ a1 pi) (- bw ch)))
      (setq p5 (polar c1 (+ a1 (/ pi 2.0)) (- (/ hd 2.0) ch)))
      (setq p6 (polar c1 (+ a1 pi (/ pi 2.0)) (- (/ hd 2.0) ch)))
      (command "line" p4 p3 p5 p6 p4 p2 p1 p3)
      (command "")
      (setq p1 (polar ip (+ a1 (/ pi 2.0)) (/ bw 2.0)))
      (setq p7 (polar ip (+ a1 (/ pi 2.0)) (- (/ bw 2.0) ch)))
      (setq p2 (polar ip (+ a1 pi (/ pi 2.0)) (/ bw 2.0)))
      (setq p8 (polar ip (+ a1 pi (/ pi 2.0)) (- (/ bw 2.0) ch)))
      (setq p3 (polar p1 a1 (- sbl ch)))
      (setq p4 (polar p2 a1 (- sbl ch)))
      (setq p5 (polar p7 a1 sbl))
      (setq p6 (polar p8 a1 sbl))
      (command "line" p2 p4 p6 p5 p3 p1)
      (command "")
      (command "line" p4 p3)
      (command "")
      (command "linetype" "S" "hidden")
      (command "")
      (command "line" p5 p7)
      (command "")
      (command "line" p6 p8)
      (command "")
      (command "linetype" "S" ltp)
      (command "")
      (setvar "blipmode" 1))
)
