(defun chlayer (/ en n index ent1 ent2 newla oldla)
     (while (not (setq en (entsel "Point to entity on target layer\n"))))
     (setq n (sslength ss))
     (setq index 0)
     (setq ent1 (entget (car en)))
     (setq newla (assoc 8 ent1))
     (repeat n
          (setq ent2 (entget (ssname ss index)))
          (setq oldla (assoc 8 ent2))
          (setq ent2 (subst newla oldla ent2))
          (entmod ent2)
          (setq index (+ index 1))
     )
)
(defun chcolor (/ en ent col)
     (while (not (setq en (entsel "Point to entity with target color\n"))))
     (setq ent (entget (car en)))
     (setq col (cdr (cond ((assoc 62 ent))
                          ((assoc 62 (tblsearch "layer" (cdr (assoc 8 ent)))))                     )
               ) 
     )
     (command "chprop" "p" "" "c" col "")
)
(defun chthick (/ en ent thk)
     (while (not (setq en (entsel "Point to entity with target thickness\n "))))
     (setq ent (entget (car en)))
     (setq thk (cdr (assoc 39 ent)))
     (if (= thk nil) (setq thk 0.0))
    (command "chprop" "p" "" "t" thk "")
)
(defun chltype (/ en ent col)
     (while (not (setq en (entsel "Point to entity with target linetype\n"))))
     (setq ent (entget (car en)))
     (setq lt (cdr (cond ((assoc 6 ent))
                          ((assoc 6 (tblsearch "layer" (cdr (assoc 8 ent)))))                     )
               ) 
     )
     (command "chprop" "p" "" "lt" lt "")
)

(defun c:pickprop (/ prop)
 (setvar "cmdecho" 0)
 (graphscr)
 (prompt "Select entities to be changed ")
 (setq ss (ssget))
 (initget "Color LAyer LType Thickness")
 (setq prop (getkword "Change what property (Color/LAyer/LType/Thickness) ?" ))
 (cond ((= prop "Color") (chcolor))
       ((= prop "LAyer") (chlayer))
       ((= prop "LType") (chltype))
       ((= prop "Thickness") (chthick))
 ) 
 (setq ss nil)
 (princ)
)
