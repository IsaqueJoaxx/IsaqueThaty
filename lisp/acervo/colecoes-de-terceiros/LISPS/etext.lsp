(defun getspu ()
       (setq cs (- lw 65))
       (setq cz 0)
   (while (<= cz cs)
      (setq cg (read-line fl)) 
      (setq cz (1+ cz))
))
(defun getspl ()
      (setq cs (- lw 97))
      (setq cz 0)
   (while (<= cz cs)
      (setq cg (read-line fl))
      (setq cz (1+ cz))
))
