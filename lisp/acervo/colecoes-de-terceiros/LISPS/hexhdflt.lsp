(defun C:HEXHDFLT-F (/ pt0 sz rad dia tbl n)
	(setvar "cmdecho" 0)
	(setq pt0 (getpoint "\nCenter point: "))
	(prompt "\nEnter Size: (0,1,2,3,4,5,6,8,10,1/4,5/16,3/8,7/16) ")
	(setq sz (getstring))
	(setq rad 0)
	(setq tbl (list
		'("0" 0.128 0.0175)
		'("1" 0.158 0.025)
		'("2" 0.187 0.025)
		'("3" 0.216 0.03125)
		'("4" 0.245 0.03125)
		'("5" 0.271 0.0391)
		'("6" 0.297 0.0391)
		'("8" 0.349 0.0469)
		'("10" 0.401 0.0625)
		'("1/4" 0.521 0.0782)
		'("5/16" 0.646 0.0938)
		'("3/8" 0.771 0.1094)
		'("7/16" 0.834 0.25))
	)
	(setq n 12)
	(while (and (>= n 0) (/= sz (car (nth n tbl))))
		(setq n (1- n))
	)
	(if (>= n 0)
		(setq dia (cadr (nth n tbl)) rad (caddr (nth n tbl)))
	)
	(if (/= rad 0) (progn
		(command "CIRCLE" pt0 "D" dia
			"POLYGON" 6 pt0 "C" rad))
	)
)
