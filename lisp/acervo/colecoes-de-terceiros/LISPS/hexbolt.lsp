(defun C:HEXBOLT-F (/ pt0 sz rad tbl n)
	(setvar "cmdecho" 0)
	(setq pt0 (getpoint "\nCenter point: "))
	(prompt "\nEnter Size: (1,2,3,4,5,6,8,10,12,1/4,5/16,3/8) ")
	(setq sz (getstring))
	(setq rad 0)
	(setq tbl (list
		'("1" 0.0625)
		'("2" 0.0625)
		'("3" 0.094)
		'("4" 0.094)
		'("5" 0.094)
		'("6" 0.125)
		'("8" 0.125)
		'("10" 0.156)
		'("12" 0.156)
		'("1/4" 0.1875)
		'("5/16" 0.25)
		'("3/8" 0.281))
	)
	(setq n 11)
	(while (and (>= n 0) (/= sz (car (nth n tbl))))
		(setq n (1- n))
	)
	(if (>= n 0)
		(setq rad (cadr (nth n tbl)))
	)
	(if (/= rad 0) (progn
		(command "CIRCLE" pt0 rad
			"POLYGON" 6 pt0 "C" rad))
	)
)
