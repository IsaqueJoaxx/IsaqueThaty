(defun c:zopen ( / TempFH TempDir flength OldCmdecho)
     (setq TempFH(getfiled"Select a ZIP file..." "" "ZIP" 4)
          OldCmdecho(getvar "CMDECHO")
          flength(strlen TempFH)
     )
     (setvar "CMDECHO" 0)
     (while (/= (substr TempFH flength 1) (chr 92))
          (setq flength (1- flength))
     )
     (setq TempDir (substr TempFH 1 (1- flength)))
     (command "PkUnzip" (strcat TempFH " " TempDir))
     (command "Open" "Y" (substr TempFH 1 (- (strlen TempFH) 4)))
     (setvar "CMDECHO" OldCmdecho)
     (princ)
)
(defun c:zend ( / OldCmdecho TempFH)
     (setvar "CMDECHO" 0)
     (setq TempFH (strcat (getvar "DWGNAME") ".DWG"))
     (command "WBLOCK" TempFH "Y" "*")
     (setq ZipText (strcat (getvar "DWGNAME") ".ZIP -m " (getvar "DWGNAME") ".* -x" (getvar "DWGNAME") ".DWK"))
     (command "PkZip" ZipText)
     (command ".QUIT" "Y")
)
(defun c:znew ( / OldCmdecho TempFH)
     (setvar "CMDECHO" 0)
     (setq TempFH (strcat (getvar "DWGNAME") ".DWG"))
     (command "WBLOCK" TempFH "Y" "*")
     (setq ZipText (strcat (getvar "DWGNAME") ".ZIP -m " (getvar "DWGNAME") ".* -x" (getvar "DWGNAME") ".DWK"))
     (command "PkZip" ZipText)
     (command ".NEW" "Y" "")
)
(defun c:zquit ( / OldCmdecho TempFH)
     (setvar "CMDECHO" 0)
     (setq ZipText (strcat (getvar "DWGNAME") ".ZIP -m " (getvar "DWGNAME") ".* -x" (getvar "DWGNAME") ".DWK"))
     (command "PkZip" ZipText)
     (command ".QUIT" "Y")
)
(princ)
