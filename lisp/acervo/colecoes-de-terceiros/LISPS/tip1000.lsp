(defun C:CM ()
   (setq A nil)
   (setq OM (getvar "OSMODE"))
   (setvar "OSMODE" 33)
   (setq PNT1 (getpoint "\nPick first point:  "))
   (setq PNT2 (getpoint "\nPick second point:  " PNT1))(terpri)
   (initget 1 "M E N")
   (prompt "\nSelect one of the following:  ")
   (setq CTYPE 
   (getkword "\n(M)ax spacing   (E)xact spacing   (N)umber:  "))
   (if (= CTYPE "M")
   (setq SP (getdist "\nMaximum object spacing:  ")))
   (if (= CTYPE "E")
   (setq SP (getdist "\nExact object spacing:  ")))
   (if (= CTYPE "N")
   (setq SP (getreal "\nNumber of objects:  ")))
   (setq DIST (distance PNT1 PNT2))
   (setq ANG (angle PNT1 PNT2))
   (setq TEMP1 (/ DIST SP))
   (setq TEMP2 (fix (/ DIST SP)))
   (setq INC1 SP)
   (setq INC2 (/ DIST (+ 1 (fix (/ DIST SP)))))
   (setq INC3 (/ DIST (- SP 1)))
   (if (= TEMP1 TEMP2) (setq INC INC1) (setq INC INC2))
   (if (= CTYPE "E") (setq INC INC1) (setq INC INC))
   (if (= CTYPE "N") (setq INC INC3) (setq INC INC))
   (setq TMS (fix (+ 0.00001 (/ DIST INC))))
   (setvar "OSMODE" 0)
   (setq A (ssget))
   (setq INCR 0)
   (repeat TMS
      (setq INCR (+ INCR INC))
      (setq NEWPT (polar PNT1 ANG INCR))
      (command "copy" A "" PNT1 NEWPT)
   )
   (setvar "OSMODE" OM)
   (setq A nil)
);end cm.lsp
