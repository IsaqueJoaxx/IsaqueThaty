(defun c:vess(/ p1 p2 p3 p4 p5 p6 p7 p8 p9 d1 d2 a1)
(setvar"cmdecho" 0)
(setq d1(getdist "\nVessel Diameter: ")
      p1(getpoint "\nVessel Insertion point: ")          
      a1(getangle p1 "\nVessel Orientation: ")
      d2(getdist p1"\nVessel Length: ")
      p2(polar p1(+ A1 PI)2)
      p3(polar p2(+ a1(* 0.5 pi))(* 0.5 d1))
      p4(polar p2(- a1(* 0.5 pi))(* 0.5 d1))
      p5(polar p2(+ a1 pi)(* 0.25 d1))
      p6(polar p2 (+ 1.2056 (+ a1 pi))(* D1 0.4329))
      p7(polar p6(+ a1(* 0.5 pi))(* d1 0.8087))
      p8(polar p2(+ a1 pi 1.3952)(* d1 0.48519))
      p9(polar p2(- a1 pi 1.3952)(* d1 0.48519)))
(command "arc" p6 p5 p7)
(command "arc" p6 p8 p4)
(command "arc" p3 p9 p7)
(command "line" p3(polar p3 a1 (+ d2 4))"")
(command "line" p4(polar p4 a1 (+ d2 4))"")
(setq p1(polar p1 a1 d2)
      a1(+ a1 pi)
      p2(polar p1(+ A1 PI)2)
      p3(polar p2(+ a1(* 0.5 pi))(* 0.5 d1))
      p4(polar p2(- a1(* 0.5 pi))(* 0.5 d1))
      p5(polar p2(+ a1 pi)(* 0.25 d1))
      p6(polar p2 (+ 1.2056 (+ a1 pi))(* D1 0.4329))
      p7(polar p6(+ a1(* 0.5 pi))(* d1 0.8087))
      p8(polar p2(+ a1 pi 1.3952)(* d1 0.48519))
      p9(polar p2(- a1 pi 1.3952)(* d1 0.48519)))
(command "arc" p6 p5 p7)
(command "arc" p6 p8 p4)
(command "arc" p3 p9 p7)
(prin1))
