(defun c:blksrch (/ k t b a n bk)
   (setq k 5)
   (while (setq t (tblnext "block" k))
     (setq k nil)
     (setq b (assoc 2 t))
     (setq a (ssget "x" (list b)))
     (if (/= a nil)
       (progn
         (setq n (sslength a))
         (setq bk (cdr (assoc 2 t)))
         (prin1 n) (prompt "   ") (prin1 bk) (terpri)
       )
     )
   )
   (prin1)
 )
