;DOT with DTEXT
(vmon)
(defun textht ()
 (setq t1 "Text Height: <default = "
       t2 " >:"
       t3 (getvar "textsize")
  ) 
  (terpri) 
  (setq ht (getreal (strcat t1 (rtos t3 2 2) t2)))
  (if (= ht nil)
    (setq ht t3)
  )
  (setvar "textsize" ht)
)
(defun lead ( / pt1 pt2 pt3)
  (setq pt1 (getpoint "\nPick Grade point:")
        pt2 (getpoint "\nTo point:")
  )
  (command "donut" "0" (* 0.5 ht) pt1 "")
  (command "pline" pt1 "w" "0" "0" pt2)
  (while (setq pt2 (getpoint "\nTo point:" pt2))
    (command pt2)
  )
  (command "")
(defun l-text ( / pt1 pt2)
(setq pt1 (getvar "lastpoint")
      pt2 (osnap pt1 "quick,midp")
)
(prompt "\nEnter text:")
(if (> (car pt1) (car pt2))
  (progn
    (setq pt1 (polar pt1 5.759 ht))
    (command "dtext" pt1 ht 0)
   )
   (progn
     (setq pt1 (polar pt1 3.665 ht))
     (command "dtext" "r" pt1 ht 0)
   )
  )
))
(defun C:FGTEXT ()
(setvar "cmdecho" 0)
(textht)
(lead)
(l-text)
)
