(DEFUN SCREENE ()
  (JMP 24) (TEXTSCR)
  (PROMPT "              [7mADDITIONAL FOUNDATION GENERATOR FEATURES[0m")
  (PROMPT "\n\nThis demo offers a sampling of the programs flexibility, but omits")
  (PROMPT "\ndemonstrating a few useful features:")
  (PROMPT "\n\n1.    Walls may be masonry or concrete (crosshatched or not).")
  (PROMPT "\n\n2.    Spread footings may be omitted.  This is useful near existing")
  (PROMPT "\n      buildings or other special conditions.")
  (PROMPT "\n\n3.    Sections of wall (concrete or masonry) may be drawn without")
  (PROMPT "\n      column piers.  These sections of wall may be straight or turn")
  (PROMPT "\n      corners and may be drawn at an angle other than 0ø or 90ø.")
  (PROMPT "\n      This is an extremely useful feature.")
  (PROMPT "\n\n4.    Pier sizes may change at every column location.")
  (PROMPT "\n\n5.    Crosshatching size may be entered to conform to your preference.")
  (PROMPT "\n\n6.    All common corner conditions can be drawn.\n\n\n")
  (PAUSE 3170) (TERPRI) (TERPRI)
  

  (PROMPT "                   [7mFOUNDATION GENERATOR LIMITATIONS[0m")
  (PROMPT "\n\nLet's face it, nothing is perfect.  There are a few limits you.")
  (PROMPT "\nshould be aware of:")
  (PROMPT "\n\n1.    Footings must be square.  This may be corrected in future updates.")
  (PROMPT "\n\n2.    All common corner conditions can be drawn and most unusual ones as")
  (PROMPT "\n      well, but it is possible to ask FG to do something it can't do.")
  (PROMPT "\n      If this occasion arises, the program will warn you and skip to the")
  (PROMPT "\n      next wall section.  All straight wall sections can be drawn.")
  (PROMPT "\n\n3.    Sections of wall with column piers must be drawn horizontal or vertical.")
  (PROMPT "\n      In other words at 0ø, 90ø, 180ø or 270ø.  This may be corrected in")
  (PROMPT "\n      future versions.  Sections of wall without piers are not subject to")
  (PROMPT "\n      this limitation.")
  (PROMPT "\n\n4.    FG can not draw intersections of more than 2 walls.")
  (JMP 5) (PAUSE 3170) (TERPRI) (TERPRI)
  
  (PROMPT "One final word:  If you run AUTOCAD 2.6X, Revision 9 or Revision 10")
  (PROMPT "\nthen you can run [7mFOUNDATION GENERATOR.[0m")
  (PROMPT "\n\nI hope you have found this demonstration informative and will be")
  (PROMPT "\npersuaded to purchase the program.  ")
  (PROMPT "\n\nPlease feel free to share this demo program with friends and colleagues.")
  (PROMPT "\nAnd should any questions arise please don't hesitate to contact me:")
  (PROMPT "\n\n                               ROBERT BUSCH")
  (PROMPT "\n                       ROBERT BUSCH ASSOCIATES, INC.")
  (PROMPT "\n                            1241 PARKWAY AVENUE")
  (PROMPT "\n                        TRENTON,  NEW JERSEY 08628")
  (PROMPT "\n                           1 - 609 - 771 - 6901")
  (JMP 7)
  (PROMPT "The demo is now over and you can inspect the drawing yourself.")  
  (TERPRI)
)
