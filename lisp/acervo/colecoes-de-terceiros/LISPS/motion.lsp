;			    INSERT SUB-ROUTINE
(DEFUN AN6 ()
     (PRINT)
     (SETQ LIST (GETSTRING "BLOCK NAME: "))
     (WRITE-LINE LIST F)
     (WRITE-LINE LIST Z)
     (PRINT)
     (GRAPHSCR)
; INSERTION POINT SELECTION
