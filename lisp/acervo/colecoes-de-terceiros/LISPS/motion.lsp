;
;			     ENDING STATEMENT
;
(DEFUN AN8 ()
     (SETQ LAST (OPEN "END.SCR" "w"))
     (WRITE-LINE "QUIT" LAST)
     (WRITE-LINE "Y" LAST)
     (WRITE-LINE "2" LAST)
     (WRITE-LINE "" LAST)
     (WRITE-LINE "SCRIPT" LAST)
     (WRITE-LINE A LAST)
     (CLOSE LAST)
     (COMMAND "SCRIPT"
	(WRITE-LINE "END")
     )
)
;
;
(DEFUN C:ANIMATE ()
     (SETQ APER (GETVAR "APERTURE"))
     (SETQ PICK (GETVAR "PICKBOX"))
     (SETVAR "APERTURE" 6)
     (SETVAR "PICKBOX" 6)
     (AN)
     (SETQ F (OPEN FILE "w"))
     (AN1)
     (REPEAT N
	(AN2)
     )
     (WRITE-LINE "DELAY" F)
     (WRITE-LINE "2000" F)
     (SETQ N (+ N 4))
     (REPEAT N
	(WRITE-LINE "U" F)
     )
     (WRITE-LINE "RSCRIPT" F)
     (CLOSE F)
     (COMMAND "MENU" ACAD)
     (SETVAR "APERTURE" APER)
     (SETVAR "PICKBOX" PICK)
     (AN8)
)
