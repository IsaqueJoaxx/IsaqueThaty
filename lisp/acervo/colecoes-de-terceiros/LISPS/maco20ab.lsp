(DEFUN C:SAVPRT (/ STR SAVNAM)
;SAVES CURRENT UCS WITH VPORTS CONFIG. AND CURRENT WINDOW SO THEY CAN BE 
;RESTORED TOGETHER
(SETQ STR "")
(WHILE(NULL SAVNAM)
(SETQ SAVNAM
(GETSTRING"\nNAME FOR SAVING VIEW CONFIG? "))
(IF(TBLSEARCH "UCS" SAVNAM)
(SETQ STR(STRCAT STR " UCS")))
(IF(TBLSEARCH "VPORT" SAVNAM)
(SETQ STR(STRCAT STR " VPORTS")))
(IF(TBLSEARCH "VIEW" SAVNAM)
(SETQ STR(STRCAT STR " VIEW")))
(IF(NOT(EQUAL STR ""))
(PROGN
(PRINC(STRCAT"\nSORRY, FOLLOWING CONFIGS:"
STR " ARE ALREADY SAVED WITH THE NAME: "SAVNAM))
(SETQ SAVNAM nil STR "")
)
(COMMAND "UCS" "S" SAVNAM "VPORTS" "S" SAVNAM "VIEW" "S" SAVNAM)
)
(PRINC)
)
)
(DEFUN C:GETPRT (/ STR GETNAM)
(SETQ STR "")
(WHILE(NULL GETNAM)
(SETQ GETNAM
(GETSTRING"\nNAME OF VIEW CONFIG. TO RETRIEVE? "))
(IF(NULL(TBLSEARCH "UCS" GETNAM))
(SETQ STR(STRCAT STR " UCS")))
(IF(NULL(TBLSEARCH "VPORT" GETNAM))
(SETQ STR(STRCAT STR " VPORTS")))
(IF(NULL(TBLSEARCH "VIEW" GETNAM))
(SETQ STR(STRCAT STR " VIEW" )))
(IF(NOT(EQUAL STR ""))
(PROGN
(PRINC(STRCAT"\nSORRY, THE FOLLOWING CONFIGS:"
STR " ARE NOT SAVED WITH THE NAME: " GETNAM))
(SETQ GETNAM nil STR "")
)
(COMMAND "UCS" "R" GETNAM "VPORTS" "R" GETNAM "VIEW" "R" GATNAM)
)
)
(PRINC)
)
