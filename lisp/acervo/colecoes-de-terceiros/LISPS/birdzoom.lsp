;SPECIFY ZOOM WINDOW IN BIRDS-EYE VIEWPORT THAT HAS EFFECT IN CURRENT ;VIEWPORT
;CADALYST MAY 1989 PAGE 75
(DEFUN C:ZWAV (/ CE CVP P1)
(SETQ CE (GETVAR "CMDECHO")
CVP (GETVAR "CVPORT"))
(SETVAR "CMDECHO" 0)
(INITGET 1)
(SETQ P1 (GETPOINT "\nSELECT WINDOW TO ZOOM IN ANY VIEWPORT:"))
(COMMAND "VIEW""WINDOW""$ZWAV" P1 PAUSE)
(SETVAR "CVPORT" CVP)
(COMMAND "VIEW" "RESTORE" "$ZWAV")
(COMMAND "VIEW" "DELETE" "$ZWAV")
(SETVAR "CMDECHO" CE)
(PRIN1)
)