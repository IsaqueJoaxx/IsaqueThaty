(DEFUN C:CLEAR ()
   (PRINT "REMOVING ATOMS:")
   (WHILE (/= (CAR ATOMLIST) '<-USER-SYS->)
          (SET (CAR ATOMLIST) NIL)
          (PRINC (CAR ATOMLIST))
          (PRINC ",")
          (SETQ ATOMLIST (CDR ATOMLIST)))
   (GC)
   (TERPRI)
)
(DEFUN C:TIMER ()
   (COND ((= TS NIL) (SETQ TS (GETVAR "CDATE"))))
   (COND ((/= TS NIL) (SETQ TS2 (GETVAR "CDATE"))))
   (SETQ DIFF (- TS2 TS))
   (COND ((> DIFF 0.001) (COMMAND "SAVE" "")))
   (COND ((> DIFF 0.001) (SETQ TS TS2)))
)
(SETQ @ DEFUN)
