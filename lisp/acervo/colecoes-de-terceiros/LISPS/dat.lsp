(defun rvdraw (txtdim)
(command "line" (list (+ (car pt2) A) (cadr pt2))
          (list (+ (car pt0r) B) (cadr pt2)))
(command)
(command "text" (list (+ (car pt0r) C) (- (cadr pt2) A))
          D 0 txtdim)
)
