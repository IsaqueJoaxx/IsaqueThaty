(defun thdraw (txtdim)
(command "line" (list (car pt2) (+ (cadr pt2) A))
          (list (car pt2) (+ (cadr pt0t) B)))
(command)
(command "text" (list (+ (car pt2) A) (+ (cadr pt0t) C)) D 90 txtdim)
)
