; BLDPROP builds property list from the .dwg
;
(defun bldprop (E)
  (setq DBLIST () )
  (while (not (equal (cdr (assoc 0 (entget E))) "SEQEND"))
    (cond
      ((cdr (assoc 66 (entget E)))
        (setq DBLIST () )
        (setq RECORDLIST () )
        (setq RECORDLIST (cons (cdr (assoc -1 (entget E)))
          RECORDLIST))
        (setq RECORDLIST (cons (cdr (assoc 2 (entget E)))
          RECORDLIST))
        (setq DBLIST (cons RECORDLIST DBLIST)))
      ((equal (cdr (assoc 0 (entget E))) "ATTRIB")
        (setq RECORDLIST () )
        (setq RECORDLIST (cons (cdr (assoc 1 (entget E)))
          RECORDLIST))
        (setq RECORDLIST (cons (cdr (assoc 2 (entget E)))
          RECORDLIST))
        (setq DBLIST (cons RECORDLIST DBLIST))
        (if (equal (cdr (assoc 2 (entget E))) "ROOMNO")
          (setq KEY (cdr (assoc 1 (entget E))))
        )
      )
    )
    (setq E (entnext E))
  )
  (setq DBLIST (reverse DBLIST))
  (setq DBLIST (cons KEY DBLIST))
  (setq PROPLIST (cons DBLIST PROPLIST))
)

