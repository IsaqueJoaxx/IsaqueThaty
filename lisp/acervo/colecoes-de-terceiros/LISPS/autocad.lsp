(vmon) (setvar "CMDECHO" 0)
(defun *error* (st)
(princ (strcat "\n" st)) (quote :))
(defun C:ER () (setvar "CMDECHO" 0)
(autosv) (command "ERASE") (quote *))
(defun C:H () (setvar "CMDECHO" 0) (IF (= 0 (getvar "HIGHLIGHT"))
(setvar "HIGHLIGHT" 1) (setvar "HIGHLIGHT" 0))
(IF (= 1 (getvar "HIGHLIGHT")) (princ "\nHighlight ON\n")
(princ "\nHighlight OFF\n")) (autosv))
(setq tim (getvar "DATE") tme (/ 15 1440.0))
(defun autosv () (setvar "CMDECHO" 0)
(while (> (getvar "DATE") (+ tim tme))
(princ "\n SAVING CURRENT DRAWING...     ")
(command "SAVE" "CURRENT" "Y") (princ "*DONE")
(setq tim (getvar "DATE"))) (quote *))
(defun C:SI () (setvar "CMDECHO" 0) (princ "\nSave Increment <")
(princ (* 1440 tme)) (prompt ">:") (setq tmf (* tme 1440.0) tme (getreal))
(if (= nil tme) (setq tme tmf)) (setq tme (/ tme 1440.0)) (autosv))
(defun C:W () (setvar "CMDECHO" 0)
(autosv) (command "ZOOM" "W") (quote *))
(defun C:C () (setvar "CMDECHO" 0)
(autosv) (command "ZOOM" "C") (quote *))
(defun C:D () (setvar "CMDECHO" 0)
(autosv) (command "ZOOM" "D") (quote *))
(defun C:N () (setvar "CMDECHO" 0)
(autosv) (command "PAN") (quote *))
(defun C:P () (setvar "CMDECHO" 0)
(command "ZOOM" "P") (autosv))
(defun C:X () (setvar "CMDECHO" 0)
(command "ZOOM" "E") (autosv))
(defun C:L () (setvar "CMDECHO" 0)
(setq p1 (getvar "LIMMIN") p2 (getvar "LIMMAX"))
(command "ZOOM" "W" p1 p2) (autosv))
(defun C:R () (setvar "CMDECHO" 0)
(command "REDRAW") (autosv))
