(defun C:HEXSET-F (/ pt0 sz rad dia tbl n)
	(setvar "cmdecho" 0)
	(setq pt0 (getpoint "\nCenter point: "))
	(prompt "\nEnter Size: (0,1,2,3,4,5,6,8,10,1/4,5/16,3/8,7/16) ")
	(setq sz (getstring))
	(setq rad 0)
	(setq tbl (list
		'("0" 0.06 0.014)
		'("1" 0.073 0.0175)
		'("2" 0.086 0.0175)
		'("3" 0.099 0.025)
		'("4" 0.112 0.025)
		'("5" 0.125 0.0313)
		'("6" 0.138 0.0313)
		'("8" 0.164 0.0391)
		'("10" 0.19 0.0469)
		'("1/4" 0.25 0.0625)
		'("5/16" 0.3125 0.0781)
		'("3/8" 0.375 0.0938)
		'("7/16" 0.4375 0.1094))
	)
	(setq n 12)
	(while (and (>= n 0) (/= sz (car nth n tbl))))
		(setq n (1- n))
	)
	(if (>= n 0)
		(setq dia (cadr (nth n tbl)) rad (caddr (nth n tbl)))
	)
	(if (/= rad 0) (progn
		(command "CIRCLE" pt0 "D" dia
			"POLYGON" 6 pt0 "C" rad))
	)
)
