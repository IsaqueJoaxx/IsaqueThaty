)

(defun C:FIX (/ FIX1)
        (if (not  *FIX1)
            (setq *FIX1 "C"))
 (setq FIX1 (strcase (getstring "\nIntersection type = Tee/Cross/corneR: ")))
        (if (equal FIX1 "")
             (setq FIX1 *FIX1)(setq *FIX1 FIX1))
 (princ "Option chosen...")
 (princ FIX1)
        (if (equal FIX1 "T") 
                  (FIXT2))         
        (if (equal FIX1 "C") 
                  (FIXC2))
        (if (equal FIX1 "R") 
                  (FIXR2))
 
)
 

