(defun FIXT2 (/ OS1 PT1 PT2 PT3 PT4 PT5 PT6 PT7 PT8 PT9 
                        DST1 DST1A DST2 DST2A)
        (setq   PB1 (getvar "pickbox")        
                OS1 (getvar "osmode"))
        (setvar "cmdecho" 0)
        (setvar "pickbox" 1)
        (setvar "osmode" 32)
        (prompt "\nFirst two points determine inside corners to remain.")
                (setq PT1  (getpoint "\nSelect first intersection <ccw>:  "))
                (setq PT2  (getpoint "\nSelect second intersection <ccw>: "))
                (setq PT3  (getpoint "\nSelect third intersection <ccw>: "))
        (setvar "osmode"  0)
                (setq DST1  (distance PT1 PT2)
                      DST1A (distance PT2 PT3)
                      DST2  (* DST1 0.5)
                      DST2A (* DST1A 0.5)
                      ANG1  (angle PT1 PT2)
                      ANG2  (angle PT2 PT3)
                      PT4   (polar PT1 ANG1 DST2)
                      PT5   (polar PT2 ANG2 DST2A) 
                      PT7   (polar PT5 ANG2 DST1A) 
                      PT8   (polar PT1 ANG2 DST2A) 
                      PT9   (polar PT8 ANG2 DST1A))
        (command "trim" "c" PT1 PT3 "" PT9 PT7 PT8 PT5 PT4 "")
        (setvar "pickbox" PB1) 
        (setvar "osmode" OS1)
)

(defun FIXR2 (/ OS1 PB1 PT1 PT2 PT3 PT4 PT5 PT6 PT7 
                DST1A DST1 DST2 DST2A DST3 DST3A)
        (setq PB1 (getvar "pickbox")        
              OS1 (getvar "osmode"))
        (setvar "cmdecho" 0)
        (setvar "pickbox" 1)
        (setvar "osmode" 32)
        (prompt "\nFirst point determines inside corner to remain.")
                (setq PT1  (getpoint "\nSelect first intersection <ccw>:  "))
                (setq PT2  (getpoint "\nSelect second intersection <ccw>: "))
                (setq PT3  (getpoint "\nSelect third intersection <ccw>: "))
        (setvar "osmode"  0)
                (setq DST1  (distance PT1 PT2)
                      DST1A (distance PT2 PT3)
                      DST2  (* DST1 0.5)
                      DST2A (* DST1A 0.5)
                      DST3  (* DST1 1.5)
                      DST3A (* DST1A 1.5)
                      ANG1  (angle PT1 PT2)
                      ANG2  (angle PT2 PT3)
                      PT4   (polar PT1 ANG2 DST2A)
                      PT5   (polar PT1 ANG1 DST2) 
                      PT6   (polar PT1 ANG1 DST3) 
                      PT7   (polar PT1 ANG2 DST3A) 
                      PT8   (polar PT2 ANG2 DST3A) 
                      PT9   (polar PT3 ANG1 DST2))
        (command "trim" "c" PT1 PT3 "" PT6 PT9 PT8 PT7 PT4 PT5 "")
        (setvar "pickbox" PB1) 
        (setvar "osmode" OS1)
)

(defun FIXC2 (/ PB1 OS1 PT1 PT2 PT3 PT4 PT5 PT6 PT7 
                DST1 DST1A DST2 DST2A)
        (setq PB1 (getvar "pickbox"))
        (setq OS1 (getvar "osmode")) 
