; TIP984.LSP: FIX.LSP   Clean Up Wall Intersections   (c)1994, Steven Hauk

(defun C:FIXC (/ PT1 PT2 PT3 PT4 PT5 PT6 PT7 PT0 DST1 DST2)
        (setq PB1 (getvar "pickbox"))
        (setvar "cmdecho" 0)
        (setvar "osmode" 32)
        (setvar "pickbox" 1)
                (setq PT2  (getpoint "\nSelect first intersection <ccw>:  "))
                (setq PT1  (getpoint "\nSelect second intersection <ccw>: "))
        (setvar "osmode"  0)
                (setq DST1 (distance PT1 PT2))
                (setq DST2 (* DST1 0.5))
                (setq ANG1 (angle PT2 PT1))
                (setq ANG2 (+ (/ pi 2) ANG1))
                (setq PT3  (polar PT2 ANG1 DST2))
                (setq PT4  (polar PT2 ANG2 DST2))
                (setq PT5  (polar PT4 ANG2 DST2))
                (setq PT6  (polar PT5 ANG1 DST2))
                (setq PT7  (polar PT1 ANG2 DST2))
        (command "trim" "c" PT1 PT5 "" PT6 PT7 PT4 PT3 "")
        (setvar "pickbox" PB1)
        (princ DST1)
        (princ)
)

