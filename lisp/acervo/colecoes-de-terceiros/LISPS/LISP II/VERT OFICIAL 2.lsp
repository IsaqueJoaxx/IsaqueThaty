(Prompt "\n Programa de rotinas para Desenhar Vertedouros")
(Prompt "\n  Desenvolvido por Equipe Projetos GOLDER ASSOCIATES BRASIL")
(defun c:VERT1X1 (); VERTEDOURO TRAPEZOIDAL DE 1m Larg x 1m Alt = Incli X=1.5,1=Y
(PRINC "LISP QUE DESENHA VERTEDOURO TRAPEZOIDAL 1 X 1..")
(command "zoom" "e" "")
(SETQ RR (GETSTRING "\ndigite Angulo em 1: "))
(SETQ P1 '(-1.5 1 0))
(SETQ P2 '(0 0 0))
(SETQ P3 '(1 0 0))
(SETQ P4 '(2.5 1 0))
(command "PLINE" P1 P2 P3 P4 "")
(setq L1 (entsel "\nSelecione a POLYLINHA de Enrocamento...:"))
(command "offset" "0.30" L1 pause)
(setq L2 (entsel "\nSelecione a POLYLINHA de Transição...:"))
(command "offset" "0.15" L2 pause PAUSE)
)
