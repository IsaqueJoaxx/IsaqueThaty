(DEFUN C:HIDER ()
(SETVAR "CMDECHO" 0)
(SETQ SET (GETVAR "OSMODE"))
(COMMAND "OSNAP" "INT,NEA")
 (SETQ ENT (GETPOINT "\n\n\n\nSELECT THE LINE TO HIDE:")
      PT1 (GETPOINT "\nSELECT THE INTERSECT OF THE FIRST BREAK:")
      PT2 (GETPOINT "\nSELECT THE NEXT INTERSECT:")
 )
(COMMAND "BREAK" ENT "F" PT1 PT1)
(COMMAND "BREAK" ENT "F" PT2 PT2)
(COMMAND "CHANGE" ENT "" "P" "LT" "HIDDEN" "")
(SETVAR "OSMODE" SET)
)
