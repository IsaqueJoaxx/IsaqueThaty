(Defun C:PER (/ SANG SBASE SMODE ORTHO OSM P1 P2)
  (setvar "cmdecho" 0)
  (setq SANG (getvar "snapang"))
  (setq SBASE (getvar "snapbase"))
  (setq SMODE (getvar "snapmode"))
  (setq ORTHO (getvar "orthomode"))
  (setq OSM (getvar "osmode"))
  (setq	P1
	 (osnap
	   (getpoint
	     "\nEscolha um ponto em uma linha para desenhar uma perpendicular... :  "
	   )
	   "nea"
	 )
  )
  (setvar "osmode" 0)
  (setq P2 (osnap P1 "end"))
  (if (equal P1 P2)
    (setq P2 (osnap P1 "MID"))
  )
  (command ".snap" "r" P1 P2)
  (setvar "snapmode" 0)
  (setvar "orthomodE" 1)
  (prompt "\nto point:")
  (command "pline" P1 pause "")
  (setvar "snapang" SANG)
  (setvar "snapbase" SBASE)
  (setvar "snapmode" SMODE)
  (setvar "orthomode" ORTHO)
  (setvar "osmode" OSM)
  (setvar "cmdecho" 1)
  (command "snapang" "0")
  (princ)
)	