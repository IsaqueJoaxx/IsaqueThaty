(defun C:HEXHDBUT-F (/ pt0 sz rd dia tbl n)
	(setvar "cmdecho" 0)
	(setq pt0 (getpoint "\nCenter point: "))
	(prompt "\nEnter Size: (0,1,2,3,4,5,6,8,10,1/4,5/16,3/8,1/2) ")
	(setq sz (getstring))
	(setq rd 0)
	(setq tbl (list
		'("0" 0.114 0.0175)
		'("1" 0.139 0.025)
		'("2" 0.164 0.025)
		'("3" 0.188 0.03125)
		'("4" 0.213 0.03125)
		'("5" 0.238 0.0391)
		'("6" 0.262 0.0391)
		'("8" 0.312 0.0469)
		'("10" 0.361 0.0625)
		'("1/4" 0.437 0.0781)
		'("5/16" 0.547 0.0938)
		'("3/8" 0.656 0.1094)
		'("1/2" 0.875 0.1563))
	)
	(setq n 12)
	(while (and (>= n 0) (/= sz (car (nth n tbl))))
		(setq n (1- n))
	)
	(if (>= n 0)
		(setq dia (cadr (nth n tbl)) rd (caddr (nth n tbl)))
	)
	(if (/= rd 0) (progn
		(command "CIRCLE" pt0 "D" dia
			"POLYGON" 6 pt0 "C" rd
			"CIRCLE" pt0 (* rd 1.667)))
	)
)
