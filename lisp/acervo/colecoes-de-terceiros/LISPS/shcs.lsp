(DEFUN CHECKFORBLOCK()
 ;set up and make into a block
(IF(/= tempblock blockname)
 (progn
 (setq enityname(ssadd ablock(ssadd bblock(ssadd cblock(ssadd dblock)))))
 (setq location (entget dblock))
 (setq location (cdr(assoc 10 location)))
 (command"block" blockname location enityname "")));end of if and progn
(if (= tempblock blockname)
 (setq location Lct))
(command"insert"blockname location "" "" "")
);END OF CHECKFORBLOCK

