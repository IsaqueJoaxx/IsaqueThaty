(DEFUN MENU-OPERATION (HEADER ITEM-LIST PROMPT / COUNTER)
       (SETQ COUNTER 0)
       (terpri)
       (REPEAT (- 38 (/ (STRLEN HEADER) 2)) (PRINC "\260"))
       (PRINC " ") 
       (PRINC HEADER)
       (PRINC " ")
       (REPEAT (- 38 (/ (STRLEN HEADER) 2)) (PRINC "\260"))
       (REPEAT (FIX (/ (- 24 (LENGTH ITEM-LIST)) 2.0)) (TERPRI))
       (SETQ COUNTER 0)
       (FOREACH ITEM ITEM-LIST
                (SETQ COUNTER (1+ COUNTER))
                (TERPRI)
                (PRINC (STRCAT " " (RTOS (FLOAT COUNTER) 2 0) "] "))
                (PRINC ITEM))
       (REPEAT (FIX (/ (- 24 (LENGTH ITEM-LIST)) 2.0)) (TERPRI))
       (IF (= number nil)
		(setq number "None Selected"))
       (PRINC PROMPT)(princ "Default= ")(PRINC number )(terpri)
       (setq getnumber(GETINT))
       (IF (/= getnumber nil)
		(setq number getnumber))) 
;; This an an example of using MENU-OPERATION to get a value from the user.
;; The first argument must be the header.
:: The second argument mus be a list of things to be chosen from.
;; The third argument must be a prompt [question] to the user.
;; MENU-OPERATION looks for and returns an integer.
(defun menu () 
       (setq menu-size 
          (menu-operation "SHCS MENU"
               '("No 8 shcs"
                 "No 10 shcs"
                 "1/4 shcs"
                 "5/16 shcs"
                 "3/8 shcs"
                 "1/2 shcs"
                 "7/16 shcs"
                 "5/8 shcs"
                 "3/4 shcs"
                 "7/8 shcs"
                 "1 shcs"
                 "1-1/4 shcs"
                 "1-1/2 shcs")
            "Select number corresponding to size of SHCS to be used:")))
(DEFUN HIDDENLINE ()
   (IF(= HIDE2 nil)
   (setq HIDE "Default = USE LINE TYPE AS IS"))
   (PRINC"\n TO BE HIDDEN - [Y]es OR [N]o ? < ")(PRINC HIDE)(PRinc"> ")
   (setq HIDE2 (strcase (GETSTRING)))
   (IF(/= HIDE2 "")(setq HIDE HIDE2))
   (IF (= HIDE "Y")(COMMAND"linetype""S""hidden" "")))
;FINISH SETUP FOR HIDDENLINE

