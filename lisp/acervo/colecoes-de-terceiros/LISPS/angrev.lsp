(defun C:angrev ()
   (setq e (entget (car (entsel))))
   (if (= "TEXT" (cdr (assoc 0 e)))
     (progn
       (setq a (assoc 1 e))
       (setq a1 (cdr (assoc 1 e)))
       (setq a2 (atof a1))
       (setq a3 (abs(+ (- 180 a2)(* a2 2))))
       (setq a4 (dtr a3))
       (setq a5 (angtos a4))
       (setq a6 (cons 1 a5))
       (setq e (subst a6 a e))
       (entmod e)
     )
   )
 )
