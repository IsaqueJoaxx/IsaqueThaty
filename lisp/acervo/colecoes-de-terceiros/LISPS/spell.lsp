(defun c:sp ( / ss1 file cnt ent txt temp )
(setq ss (ssget "x" '((0 . "text"))))
(setq ssl (sslength ss))
(setq file (open "E:\\TRASH\\spell.tmp" "w"))
(setq cnt 0)
(princ "\nWriting file...\n")
   (while (< cnt ssl)
      (setq ent (entget (ssname ss cnt)))
        (setq cnt (+ cnt 1))
        (setq txt (cdr (assoc 1 ent)))
        (princ txt file)
        (princ "\n" file)
   )
   (close file)
   (princ "\n\n")
   (command "spell" "E:\\TRASH\\spell.tmp")
   (setq file (open "E:\\TRASH\\spell.tmp" "r"))
   (setq cnt 0)
   (princ "\nUpdating drawing...\n")
            (while (< cnt ssl)
               (setq ent (entget (ssname ss cnt)))
            (setq temp (READ-LINE file))
                (setq ent (subst (cons 1 temp) (assoc 1 ent) ent))
            (entmod ent)
            (setq cnt (1+ cnt))
            )
         (close file)
 (princ)
)
