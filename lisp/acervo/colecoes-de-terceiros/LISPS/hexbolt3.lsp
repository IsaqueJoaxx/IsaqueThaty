(defun C:HEXBOLT-3 (/ pt0 rad dia el el0 t0 iht oht tmp mul end n tbl)
	(setvar "cmdecho" 0)
	(setq pt0 (getpoint "\nCenter point: ") end "> ")
	(if (not nbsz)
		(setq nbsz "1/4")
		(if (zerop (strlen nbsz))
			(setq nbsz "1/4")
		)
	)
	(setq tmp "\nEnter Size: (1,2,3,4,5,6,8,10,12,1/4,5/16,3/8) <")
	(prompt (strcat tmp nbsz end))
	(setq tmp (getstring))
	(if (not (zerop (strlen tmp)))
		(setq nbsz tmp)
	)
	(setq el0 (getvar "elevation") t0 (getvar "thickness"))
	(prompt (strcat "\nElevation of bolt base: <" (rtos el0) end))
	(setq el (getreal))
	(if (not el)
		(setq el el0)
	)
	(if (not blen)
		(setq tmp 0.0)
		(setq tmp blen)
	)
	(setq blen (getreal (strcat "\nLength of bolt: <" (rtos tmp) end)))
	(if (not blen)
		(setq blen tmp)
		(setq blen (abs blen))
	)
	(if (not bdir)
		(if (minusp t0)
			(setq tmp "D")
			(setq tmp "U")
		)
		(if (zerop (strlen bdir))
			(if (minusp t0)
				(setq tmp "D")
				(setq tmp "U")
			)
			(setq tmp bdir)
		)
	)
	(prompt (strcat "\nDirection of bolt (U)p or (D)own: <" tmp end))
	(setq bdir (getstring))
	(if (zerop (strlen bdir))
		(setq bdir tmp)
	)
	(setq rad 0)
	(setq tbl (list '("1" 0.0625 0.073 0.04 0.035)
		'("2" 0.0625 0.086 0.045 0.039)
		'("3" 0.094 0.099 0.05 0.043)
		'("4" 0.094 0.112 0.055 0.048)
		'("5" 0.094 0.125 0.064 0.054)
		'("6" 0.125 0.138 0.086 0.075)
		'("8" 0.125 0.164 0.103 0.094)
		'("10" 0.156 0.19 0.114 0.1)
		'("12" 0.156 0.216 0.147 0.133)
		'("1/4" 0.1875 0.25 0.181 0.166)
		'("5/16" 0.25 0.3125 0.219 0.203)
		'("3/8" 0.281 0.375 0.282 0.256))
	)
	(setq n 11)
	(while (and (>= n 0) (/= nbsz (car (nth n tbl))))
		(setq n (1- n))
	)
	(if (>= n 0)
		(setq rad (cadr (nth n tbl)) dia (caddr (nth n tbl))
		    iht (cadddr (nth n tbl)) oht (last (nth n tbl)))
	)
	(if (/= rad 0) (progn
		(if (= (ascii (strcase bdir)) 85)
			(setq mul -1.0)
			(setq mul 1.0)
		)
		(setvar "elevation" el)
		(setvar "thickness" (* mul iht))
		(command "CIRCLE" pt0 rad)
		(setvar "thickness" (* mul oht))
		(command "POLYGON" 6 pt0 "C" rad)
		(setvar "thickness" (* (- mul) blen))
		(command "CIRCLE" pt0  "D" dia)
		(setvar "elevation" el0)
		(setvar "thickness" t0))
	)
)
