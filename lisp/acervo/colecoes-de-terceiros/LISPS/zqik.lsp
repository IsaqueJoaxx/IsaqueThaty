(defun zq ( /  p2 XtoY VsMax VsMin X Y rm ex Pad
               ViewS ViewC Tiny x1 x2 y1 y2 xp1)
 (setq rm (getvar "regenmode")
       om (getvar "orthomode")
       ex (getvar "expert")
       error *error*
       *error* *ZQik*)
 (setvar "expert" 0)
 (setvar "cmdecho" 0)
 (setvar "regenmode" 0)
 (initget 1 "Max Window Previous Tiny")
 (setq p1 (getpoint "\nBase point or Previous/Max/Tiny/Window: ")
       Pad (* (- (car (TRANS (getvar "vsmax") 1 2))
                 (car (TRANS (getvar "vsmin") 1 2))) 0.0001)
       VsMax (mapcar '- (TRANS (getvar "vsmax") 1 2)(list Pad Pad))
       VsMin (mapcar '+ (TRANS (getvar "vsmin") 1 2)(list Pad Pad))
       XtoY (/ (- (car VsMax)(car VsMin))(- (cadr VsMax)(cadr VsMin)))
       Tiny (/ (apply '- (mapcar '(lambda (x) (cadr (trans (getvar x) 1 2)))
                                 '("vsmax" "vsmin")))
             (- (fix (/ 32767 (apply 'max (getvar "screensize")))) 0.000001)))
   (cond ((listp p1)
     (setvar "orthomode" 0)
     (initget 1)
     (setq ViewC (mapcar '+ (TRANS (getvar "viewctr") 1 2)
                   (mapcar '- (TRANS (setvar "lastpoint" p1) 2 1)
                        (getpoint (getvar "lastpoint") "\nSecond point: ")))
           ViewS (getvar "viewsize"))
     (mapcar 'set  (list 'x1 'x2 'y1 'y2)
                   (list (- (car ViewC)(/ (* ViewS XtoY) 2))
                         (+ (car ViewC)(/ (* ViewS XtoY) 2))
                         (- (cadr ViewC)(/ ViewS 2))
                         (+ (cadr ViewC)(/ ViewS 2)) )))
   ((= p1 "Tiny") (setq xp1 '(1 1))
      (prompt "\nPosition BOX at new view center and strike any key: ")
      (while (or (= 5 (car (setq p1 (grread T)))) (= 12 (car p1)))
         (setq p1 (cadr p1))
         (if (member 'nil (mapcar '= xp1 p1))(progn
            (mapcar '(lambda (w x y z)
                       (set x (y (w (TRANS p1 1 2)) (/ z 2))))
                 (list car car cadr cadr)(list 'x1 'x2 'y1 'y2)(list - + - +)
                 (list (* Tiny XtoY)(* Tiny XtoY) Tiny Tiny))
            (if (/= 1 (car xp1))(Zgrdr))
            (setq pt1 (TRANS (list x1 y1) 2 1)
                  pt2 (TRANS (list x2 y1) 2 1)
                  pt3 (TRANS (list x2 y2) 2 1)
                  pt4 (TRANS (list x1 y2) 2 1))
            (Zgrdr)
         ));if,progn
        (setq xp1 p1)
   ));Tiny,while
   ((= p1 "Window")
     (initget 1)
     (setq p1 (getpoint "\nFirst corner: "))
     (initget 1)
     (setq p2 (TRANS (getcorner p1 "\nOther corner: ") 1 2)
           P1 (TRANS P1 1 2)
           X (abs (- (car p1)(car p2)))
           Y (abs (- (cadr p1)(cadr p2))))
     (if (< X (* XtoY Y))
        (setq X (* Y XtoY))
        (setq Y (* X (/ (- (cadr VsMax)(cadr VsMin))
                        (- (car VsMax)(car VsMin))))))
     (setq p1 (mapcar 'min p1 p2))
     (mapcar 'set
        (list 'x1 'x2 'y1 'y2)
        (list (car p1)(+ X (car p1))(cadr p1)(+ Y (cadr p1)))))
   ((= p1 "Previous")(command "p"))
   ((= p1 "Max")(command "w" (TRANS VsMin 2 1)(TRANS VsMax 2 1)) ))
 (if (and (/= p1 "Max")(/= p1 "Previous"))(progn
   (mapcar '(lambda (w x y z)
              (if (w (eval x) y) (progn
                 (princ "\nView boundary adjusted to eliminate REGEN")
                 (set z (+ (eval z)(- y (eval x))))
                 (set x (+ (eval x)(- y (eval x)))))))
      (list < < > >)(list 'x1 'y1 'x2 'y2)
      (list (car VsMin)(cadr VsMin)(car VsMax)(cadr VsMax))
      (list 'x2 'y2 'x1 'y1))
   (command "c"
      (TRANS (inters (list x1 y1)(list x2 y2)(list x1 y2)(list x2 y1)) 2 1))
   (setvar "expert" ex)
   (setvar "orthomode" om)
   (setvar "regenmode" rm)
   (if (not (<= Tiny (- y2 y1)))
      (prompt "\nView size enlarged to eliminate REGEN"))
   (command (max Tiny (- y2 y1)))))
 (setq *error* error)
 (princ)
)
;
(defun c:ZQstat ( / x)
 (textscr)
 (princ "\nVirtual View height = ")
 (princ (setq x (- (cadr (getvar "vsmax"))(cadr (getvar "vsmin")))))
 (princ "\nVIEWSIZE = ")
 (princ (getvar "viewsize"))
 (princ "\nViewport resolution = ")
 (princ (fix (apply 'max (getvar "screensize"))))
 (princ " x ")
 (princ (fix (apply 'min (getvar "screensize"))))
 (princ "\nVirtual Pixel to Real Pixel ratio = ")
 (princ (fix (/ 32767 (apply 'max (getvar "screensize")))))
 (princ " to 1")
 (princ "\nSmallest ZOOM percent for current Vport = ")
 (princ (rtos (* 100 (/ (vh) x)) 2 2))
 (princ " %")
 (princ)
);ZQstat
;
(defun Zgrdr()
  (grdraw pt1 pt2 -1 0)
  (grdraw pt2 pt3 -1 0)
  (grdraw pt3 pt4 -1 0)
  (grdraw pt4 pt1 -1 0)
)
;
(defun *ZQik* (m)
 (setvar "expert" ex)
 (setvar "orthomode" om)
 (setvar "regenmode" rm)
 (setq *error* error)
 (princ "\n")
 (princ m)
 (princ " ")
 (princ)
)
;
(princ "\nZQik v2.0")
(princ)

