(defun C:HEXNUT-3 (/ pt0 rad dia el el0 t0 iht oht tmp ndir end n tbl)
	(setvar "cmdecho" 0)
	(setq pt0 (getpoint "\nCenter point: ") end "> ")
	(if (not nbsz)
		(setq nbsz "1/4")
		(if (zerop (strlen nbsz))
			(setq nbsz "1/4")
		)
	)
	(setq tmp "\nEnter Size: (0,1,2,3,4,5,6,8,10,12,1/4,5/16,3/8) <")
	(prompt (strcat tmp nbsz end))
	(setq tmp (getstring))
	(if (not (zerop (strlen tmp)))
		(setq nbsz tmp)
	)
	(setq el0 (getvar "elevation") t0 (getvar "thickness"))
	(prompt (strcat "\nElevation of nut base: <" (rtos el0) end))
	(setq el (getreal))
	(if (not el)
		(setq el el0)
	)
	(if (not bdir)
		(if (minusp t0)
			(setq tmp "U")
			(setq tmp "D")
		)
		(if (zerop (strlen bdir))
			(if (minusp t0)
				(setq tmp "U")
				(setq tmp "D")
			)
			(if (= (ascii bdir) 85)
				(setq tmp "D")
				(setq tmp "U")
			)
		)
	)
	(prompt (strcat "\nDirection of nut base (U)p or (D)own: <" tmp end))
	(setq ndir (getstring))
	(if (zerop (strlen ndir))
		(setq ndir tmp)
	)
	(setq rad 0)
	(setq tbl (list
		'("0" 0.06 0.078 0.047 0.042)
		'("1" 0.073 0.078 0.047 0.042)
		'("2" 0.086 0.094 0.062 0.055)
		'("3" 0.099 0.094 0.062 0.055)
		'("4" 0.112 0.125 0.093 0.085)
		'("5" 0.125 0.156 0.108 0.098)
		'("6" 0.138 0.156 0.108 0.098)
		'("8" 0.164 0.172 0.125 0.113)
		'("10" 0.19 0.188 0.125 0.113)
		'("12" 0.216 0.219 0.154 0.14)
		'("1/4" 0.25 0.219 0.185 0.167)
		'("5/16" 0.3125 0.281 0.216 0.196)
		'("3/8" 0.375 0.313 0.25 0.225))
	)
	(setq n 12)
	(while (and (>= n 0) (/= nbsz (car (nth n tbl))))
		(setq n (1- n))
	)
	(if (>= n 0)
		(setq dia (cadr (nth n tbl)) rad (caddr (nth n tbl))
		    iht (cadddr (nth n tbl)) oht (last (nth n tbl)))
	)
	(if (/= rad 0) (progn
		(if (= (ascii (strcase ndir)) 85)
			(setq mul -1.0 bdir "D")
			(setq mul 1.0 bdir "U")
		)
		(setvar "elevation" el)
		(setvar "thickness" (* mul iht))
		(command "DONUT" dia (* rad 2.0) pt0
			"")
		(setvar "thickness" (* mul oht))
		(command "POLYGON" 6 pt0 "C" rad)
		(setvar "elevation" el0)
		(setvar "thickness" t0))
	)
)
