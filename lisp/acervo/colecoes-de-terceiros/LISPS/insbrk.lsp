; INSBRK.LSP

; Inspired by LES6.LSP and UBREAK.LSP from "AutoLisp in Plain English".

;THIS PROGRAM INSERTS A BLOCK NAMED "insbrk" (LOOKS LIKE A ROTATED "N")
;INTO A LINE AND BREAKS THE LINE AT THE ENDS OF THE BLOCK TO FORM A BREAK-
;LINE SYMBOL.  ENTER SCALE FACTOR FROM KEYBOARD (APPROX SAME AS TEXT   
;HEIGHT).  POINT TO SPOT ON LINE
;WHERE YOU WANT THE BREAK SYMBOL INSERTED (AUTOMATIC NEAREST OSNAP).
;POINT TO ANOTHER POINT ON THE LINE.  THE BLOCK IS INSERTED AND THE
;LINE IS BROKEN AT THE BLOCK.  HIT SPACEBAR TO CONTINUE AND YOU ARE
;PROMPTED FOR ANOTHER INSERTION POINT ON THE LINE.  OR TYPE E AND HIT THE
;SPACEBAR OR RETURN KEY TO EXIT THIS PROGRAM.


(DEFUN RTD (A) ;RTD FUNCTION CONVERTS RADIANS TO DEGREES
 (/ (* A 180.0) PI)
 )
; 
(defun C:INSBRK (/ os S K pnt1 pnt2 a A1 S1 PNT3 ST)
 (graphscr)
 (setq os (getvar "osmode"))
 (SETQ S (GETREAL "ENTER SCALE FACTOR: ")) (TERPRI)
 (SETQ K 5)
 (WHILE K
  (SETVAR "OSMODE" 512) ;SETS OSNAP TO NEAREST
  (setq pnt1 (getpoint "INSERTION POINT ON LINE: ")) (terpri)
  (SETQ PNT2 (GETPOINT PNT1 "2nd POINT ON LINE: ")) (TERPRI)
  (SETQ A (ANGLE PNT1 PNT2))
  (setq a1 a)
  (SETQ S1 S)
  (command "insert" "insbrk" PNT1 S1 S1 (RTD A1))
  (SETQ S1 (* 0.625 S1))
  (SETQ PNT3 (POLAR PNT1 A S1))
  (COMMAND "BREAK" PNT2 "F" PNT1 PNT3)
  (SETQ ST (GETSTRING "E to end or SPACEBAR to continue . . . "))
  (IF (= (STRCASE ST) "E")  (SETQ K NIL))
 )
 (setvar "osmode" os)
)
