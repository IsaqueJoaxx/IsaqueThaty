(defun c:ProjBot()
  (setvar "VTENABLE" 7)
  (setq ZoomH (getvar "VIEWSIZE"))
  (setq Ar1 (getpoint "Defina a área de trabalho:"))
  (Setq Ar2 (getcorner Ar1 "Defina a área de trabalho:"))
  (command "ZOOM" "W" Ar1 Ar2)
  (Alert "Pressione \"OK\" e pode ir embora.\nAgora o ProjBot© estará automaticamente trabalhando por você!\nQuando você retornar basta pressionar \"ESC\" e continuar onde o ProjBot© parou")
  (setq Est1 (car Ar1))
  (setq Est2 (car Ar2))
  (setq Nrt1 (cadr Ar1))
  (setq Nrt2 (cadr Ar2))
  (setq EstD(abs (- Est2 Est1)))
  (setq NrtD(abs (- Nrt2 Nrt1)))
  (setq MinEst (min Est1 Est2))
  (setq MinNrt (min Nrt1 Nrt2))

(while (= NadaQueInteresse nil)
  (setq RndSeed (rtos (getvar "DATE") 2 9))
  (while (/= (substr RndSeed 17) (substr RndSeed 16 1))
    (setq RndSeed (rtos (getvar "DATE") 2 9))
  )
  (setq RndNum (distof (strcat "0." (substr RndSeed 17) (substr RndSeed 16 1) (substr RndSeed 15 1) (substr RndSeed 14 1))))
  (setq RndEst (+(* Estd RndNum) MinEst))
  (while (/= (substr RndSeed 17) (substr RndSeed 15 1))
    (setq RndSeed (rtos (getvar "DATE") 2 9))
  )
  (setq RndNum (distof (strcat "0." (substr RndSeed 17) (substr RndSeed 16 1) (substr RndSeed 15 1) (substr RndSeed 14 1))))
  (setq RndNrt (+(* Nrtd RndNum) MinNrt))
  (while (/= (substr RndSeed 17) (substr RndSeed 14 1))
    (setq RndSeed (rtos (getvar "DATE") 2 9))
  )
  (setq RndNum (distof (strcat "0." (substr RndSeed 17) (substr RndSeed 16 1) (substr RndSeed 15 1) (substr RndSeed 14 1))))
  (while (/= (substr RndSeed 17) (substr RndSeed 13 1))
    (setq RndSeed (rtos (getvar "DATE") 2 9))
  )
  (setq ZPCoord (list RndEst RndNrt 0.0))
  (if (= 0 RndNum)
    (command "zoom" "c" ZPCoord "")
    (command "zoom" "c" ZPCoord (* RndNum ZoomH))
  )
  (command "delay" (fix (* 5000 RndNum)))
)
)
