(defun c:lk3d(/ OsnVar ptox ptoy dist1 comp altu perc dist2 ang0 ang1 ang2)
  (setq OsnVar (getvar "OSMODE"))
  (setq ptox (getpoint "\nClique no Primeiro ponto: "))
  (setq ptoy (getpoint ptox "\nClique no Segundo Ponto: "))
  (setq dist1 (distance ptox ptoy))
  (setq comp (distance (vl-remove (caddr ptox) ptox) (vl-remove (caddr ptoy) ptoy)))
  (setq altu (- (caddr ptox) (caddr ptoy)))
  (setq perc (rtos (* (/ altu dist1) -100) 2 2))
  (setq dist2 (rtos dist1 2 2))
  (setq ang0 (angle ptox ptoy))
  (setq ang1 (ATAN (/ altu dist1) (SQRT (- 1 (* (/ altu dist1) (/ altu dist1))))))
  (setq ang2 (angtos ang1 0 4))


  (setvar "OSMODE" 0)
  (setvar "CMDECHO" 0)
  (command "line" ptox ptoy "")
  (setvar "CMDECHO" 1)
  (setvar "OSMODE" OsnVar)
  (princ (strcat "\nComprimento Base = " (rtos comp 2 2) " ; Altura Base = " (rtos altu 2 2) " ; Comprimento Inclinado = " dist2 "\nÂngulo Inclinação = " ang2 " ; Percentual Inclinação = " perc "%"))
  (setvar "OSMODE" 0)
  (setvar "CMDECHO" 0)
;;;  (command "DONUT" 0 (getvar "textsize") ptox ptoy "")
  (if (= 0 (cdr (assoc 40 (tblsearch "STYLE" (getvar "TEXTSTYLE")))))
    (command "TEXT" "J" "BC" (polar ptox ang0 (/ dist1 2)) "" (angtos ang0 0 4) (strcat perc "%"))
    (command "TEXT" "J" "BC" (polar ptox ang0 (/ dist1 2)) (angtos ang0 0 4) (strcat perc "%"))
  )  
    
;;;  (command "MTEXT" (polar ptox ang1 (/ dist1 2)) "J" "MC" "R" ang2 "W" dist1 (strcat "i=" perc "%") (strcat "d=" dist2 "m") "")
  (setvar "CMDECHO" 1)
  (setvar "OSMODE" OsnVar)
  (setq ptox ptoy)
  (princ)

);defun