(defun c:inc ()
  (Setq ponto1 (getpoint "\nIndique 1º ponto da linha"))
  	(Setq ponto2 (getpoint "\nIndique 2º ponto da linha"))
  		(setq cord1 (cadr ponto1)
		      )
 			 (setq cord2 (cadr ponto2)
			       )
 				 (setq cord3 (car ponto1)
				       )
  					(setq cord4 (car ponto2)
					      )
  (setq alt (- cord2 cord1)
	)
  	(setq base (- cord4 cord3)
	      )
  (setq fin (* 100 (/ alt base)
	       )
	)
  (setq texto (strcat (rtos fin 2 2) "%")
	)
  (Setq po (getpoint "\nSelecione o local do texto"))
  
  (command "text" po "" "" texto)
  (princ)
)

