(defun C:TRIMF(/ P1 P2 P3 P4 DIST V1 V2 E1 F1 F2 F3 F4 M1 M3 SG CONT)
    (C:INICIAL)
    (setvar "osmode" 37)
    (setvar "autosnap" 7)
    (setvar "orthomode" 0)
    (prompt "Clique no canto inferior esquerdo! ") (terpri)
    (setq P1 (getpoint))
    (setq P3 (getcorner P1 "Clique no canto superior direito! "))
    (setvar "osmode" 0)
    (setvar "autosnap" 0)
    (setvar "orthomode" 0)
    (setq P2 (list (car P3) (cadr P1))) 
    (setq P4 (list (car P1) (cadr P3)))
    (command "pline" P1 "w" 0.0 0.0 P2 P3 P4 "C")
    (setq E1 (entlast))
    (setq V1 P1 V2 P3)
    (setq DIST (/ (distance V1 V2) 100.0))
    (setq DIST (- DIST))
    (setq F1 (polar P1 (angle P1 P3) DIST))
    (setq F2 (polar P2 (angle P2 P4) DIST))
    (setq F3 (polar P3 (angle P3 P1) DIST))
    (setq F4 (polar P4 (angle P4 P2) DIST))
    (setq M1 F1 M3 F3)
    (command "zoom" "w" M1 M3)
    (command "TRIM" E1 "" "F" F1 F4 "" "F" F4 F3 "" "F" F3 F2 "" "F" F2 F1 "" "")
    (command "zoom" "P")
    (setq SG (ssget "W" F1 F3))
    (setq CONT(- 1))
    (command "erase" "all" "")
    (repeat (sslength SG)
      (entdel (ssname SG (setq CONT ( 1+ CONT))))
    )
    (if E1 (command "erase" E1 ""))
    (redraw)
    (command "pline" P1 "w" 0.0 0.0 P2 P3 P4 "C")
   (princ)
  (C:FINAL)
 )

(defun RETO()
  (setq A Y1)
  (while (<= A (cadr P2))
    (setvar "cecolor" F_C1)
    (setq T1 (list (car P1) A) T2 (list (car P2) A))
    (command "line" T1 T2 "")
    (setvar "cecolor" F_C2)
    (setq K (*  FTX 1.8))
    (setq POS1 (list (+ (car T1) K ) (+ (cadr T1) (/ K 2))))
    (setq POS2 (list (- (car T2) K ) (+ (cadr T1) (/ K 2))))
    (command "text" "S" "ROMANS" "J" "ML" POS1 0 (strcat "N="(rtos A 2 0)) "")
    (command "text" "S" "ROMANS" "J" "MR" POS2 0 (strcat "N="(rtos A 2 0)) "")
    (setq A (+ A MALHA))
  )
  (setq A X1)
  (while (<= (+ A MALHA) (car P2))
    (setq A (+ A MALHA))
    (setvar "cecolor" F_C1)
    (setq T1 (list  A (cadr P1)) T2 (list A (cadr P2)))
    (command "line" T1 T2 "")
    (setvar "cecolor" F_C2)
    (setq POS1 (list (- (car T1) (/ K 2)) (+ (cadr T1) K)))
    (setq POS2 (list (- (car T1) (/ K 2) ) (- (cadr T2) K)))
    (command "text" "S" "ROMANS" "J" "ML" POS1 90 (strcat "E="(rtos A 2 0)) "")
    (command "text" "S" "ROMANS" "J" "MR" POS2 90 (strcat "E="(rtos A 2 0)) "")
  )
)  

(defun C:MALHAS ()
  (C:INICIAL)
  (GRAPHSCR)
  (setvar "osmode" 7)
  (setvar "osmode" 7)
  (setq CONTINUA "S")
  (new_dialog "malha_def" (load_dialog "DEFINE.DCL"))
  (action_tile "cancel" "(setq CONTINUA nil)(done_dialog)")
  (action_tile "accept" "(done_dialog)")
  (if (= F_L1 nil)
    (progn
      (set_tile "L1" "200")
      (setq F_L1 "200")
    )
    (set_tile "L1" F_L1)
  )
  (if (= F_C1 nil)
    (progn
      (set_tile "C1" "8")
      (setq F_C1 "8")
    )
    (set_tile "C1" F_C1)
  )
  (if (= F_TX nil)
    (progn
      (set_tile "TX" "4")
      (setq F_TX "4")
    )
    (set_tile "TX" F_TX)
  )
  (if (= F_C2 nil)
    (progn
      (set_tile "C2" "2")
      (setq F_C2 "2")
    )
    (set_tile "C2" F_C2)
  )
  (mode_tile "L1" 2)
  (mode_tile "L1" 3)
  (action_tile "L1" "(setq F_L1 (get_tile \"L1\")) $value")
  (action_tile "C1" "(setq F_C1 (get_tile \"C1\")) $value")
  (action_tile "TX" "(setq F_TX (get_tile \"TX\")) $value")
  (action_tile "C2" "(setq F_C2 (get_tile \"C2\")) $value")
  (setq dcl_id (start_dialog))
  (unload_dialog dcl_id)
  (terpri)
  (princ "OK!....")
  (if (= CONTINUA nil)
    (progn
      (C:FINAL)
      (princ "Programa cancelado!...")
      (quit)
    )
  )
  (setq	FL1 (atof F_L1)
	FTX (atof F_TX)
	MALHA FL1
  )
  (setq i (tblsearch "LAYER" "MALHA"))
  (if (= i nil)
    (command "LAYER" "N" "MALHA" "")
  )
  (setvar "osmode" 37)
  (setvar "autosnap" 7)
  (setvar "orthomode" 0)
  (setq P1 (getpoint "\nClique nos pontos limites da área útil"))
  (setq P2 (getpoint P1))
  (setq P3 (getpoint P2))
  (setq P4 (getpoint P3))
  (setq YMAX (max (cadr P1) (cadr P2) (cadr P3) (cadr P4))) 
  (setq YMIN (min (cadr P1) (cadr P2) (cadr P3) (cadr P4)))
  (setq XMAX (max (car P1) (car P2) (car P3) (car P4))) 
  (setq XMIN (min (car P1) (car P2) (car P3) (car P4)))
  (if (equal YMAX (cadr P1)) (setq N (list (car P1) (cadr P1))))
  (if (equal YMAX (cadr P2)) (setq N (list (car P2) (cadr P2))))
  (if (equal YMAX (cadr P3)) (setq N (list (car P3) (cadr P3))))
  (if (equal YMAX (cadr P4)) (setq N (list (car P4) (cadr P4))))
  (if (equal YMIN (cadr P1)) (setq S (list (car P1) (cadr P1))))
  (if (equal YMIN (cadr P2)) (setq S (list (car P2) (cadr P2))))
  (if (equal YMIN (cadr P3)) (setq S (list (car P3) (cadr P3))))
  (if (equal YMIN (cadr P4)) (setq S (list (car P4) (cadr P4))))
  (if (equal XMAX (car P1)) (setq L (list (car P1) (cadr P1))))
  (if (equal XMAX (car P2)) (setq L (list (car P2) (cadr P2))))
  (if (equal XMAX (car P3)) (setq L (list (car P3) (cadr P3))))
  (if (equal XMAX (car P4)) (setq L (list (car P4) (cadr P4))))
  (if (equal XMIN (car P1)) (setq W (list (car P1) (cadr P1))))
  (if (equal XMIN (car P2)) (setq W (list (car P2) (cadr P2))))
  (if (equal XMIN (car P3)) (setq W (list (car P3) (cadr P3))))
  (if (equal XMIN (car P4)) (setq W (list (car P4) (cadr P4))))
  (setq P1 (list (car W) (cadr S)))
  (setq P2 (list (car L) (cadr N)))
  (setq P3 (list (car P3) (cadr P3)))
  (setq P4 (list (car P4) (cadr P4)))	
  (setvar "osmode" 0)
  (setvar "autosnap" 0)
  (setvar "orthomode" 0)
  (command "style" "ROMANS" "" FTX "" 0 "" "" "")
  (setq X1 (* MALHA ( fix (/ (car P1) MALHA))))
  (setq Y1 (* MALHA (+ ( fix (/ (cadr P1) MALHA)) 1)))
  (setq X2 (* MALHA ( fix (/ (car P2) MALHA))))
  (setq Y2 (* MALHA ( fix (/ (cadr P2) MALHA))))
  (setvar "celtype" "continuous")
  (if (or (equal P1 P3)(equal P3 P2)(equal P2 P4)(equal P1 P4))
      (RETO)
      (progn    
	  (setq A Y1)
	  (while (<= A (cadr P2))
	    (setvar "cecolor" F_C1)
	    (setq T1 (list (car P1) A) T2 (list (car P2) A))
	    (setq PT1 (inters T1 T2 W S))
	    (if (= PT1 nil)
	      (setq PT1 (inters T1 T2 W N))
	    )  
	    (setq PT2 (inters T1 T2 S L))
	    (if (= PT2 nil)
	      (setq PT2 (inters T1 T2 N L))
	    )  
	    (command "line" PT1 PT2 "")
	    (setvar "cecolor" F_C2)
	    (setq K (*  FTX 1.8))
	    (setq POS1 (list (+ (car PT1) (* 1.5 K)) (+ (cadr PT1) (/ K 2))))
	    (setq POS2 (list (- (car PT2) (* 1.5 K) ) (+ (cadr PT2) (/ K 2))))
	    (command "text" "S" "ROMANS" "J" "ML" POS1 0 (strcat "N="(rtos A 2 0)) "")
	    (command "text" "S" "ROMANS" "J" "MR" POS2 0 (strcat "N="(rtos A 2 0)) "")
	    (setq A (+ A MALHA))
	  )
	  (setq A X1)
	  (while (<= (+ A MALHA) (car P2))
	    (setq A (+ A MALHA))
	    (setvar "cecolor" F_C1)
	    (setq T1 (list  A (cadr P1)) T2 (list A (cadr P2)))
	    (setq PT1 (inters T1 T2 S W))
	    (if (= PT1 nil)
	      (setq PT1 (inters T1 T2 S L))
	    )  
	    (setq PT2 (inters T1 T2 W N))
	    (if (= PT2 nil)
	      (setq PT2 (inters T1 T2 N L))
	    )  
	    (command "line" PT1 PT2 "")
	    (setvar "cecolor" F_C2)
	    (setq POS1 (list (- (car PT1) (/ K 2)) (+ (cadr PT1) K)))
	    (setq POS2 (list (- (car PT2) (/ K 2)) (- (cadr PT2) K)))
	    (command "text" "S" "ROMANS" "J" "ML" POS1 90 (strcat "E="(rtos A 2 0)) "")
	    (command "text" "S" "ROMANS" "J" "MR" POS2 90 (strcat "E="(rtos A 2 0)) "")
	  )
      )
  )
  (princ "\nOK!") (princ)
  (C:FINAL)
)

    
  