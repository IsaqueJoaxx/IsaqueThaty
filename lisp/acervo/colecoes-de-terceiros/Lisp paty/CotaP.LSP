(defun c:cotap ()
  (if (= nil VEsc)
    (setq VEsc (getreal "\nDigite a Escala Vertical do Perfil: "))
  )
  (setq DZGet (getvar "DIMZIN"))
  (setq	CotPnt (getpoint "\nClique em uma cota conhecida ou [Usar Atual]:"))
  (if (/= nil CotPnt)
    (progn
      (setq CotNum (getreal "\nDigite o valor da cota:"))
      (command "UCS" CotPnt "" "UCS" "o" (strcat "0,-" (rtos (* CotNum Vesc))) "")
    )
  )
  (setq EntCota	(entsel "\nSelecione a cota:")
	cota	(nth 1 (getpoint "Clique no ponto do perfil:"))
	pcota	(entget (car entcota))
  )
  (setvar "DIMZIN" 1)
  (setq pcota (subst (cons 1 (rtos (/ cota Vesc) 2 3)) (assoc 1 pcota) pcota))
  (setvar "DIMZIN" DZGet)
  (if (assoc 62 pcota)
    (setq pcota (subst (cons 62 3) (assoc 62 pcota) pcota))
    (setq pcota (append pcota '((62 . 3))))
  )
  (entmod pcota)
)
