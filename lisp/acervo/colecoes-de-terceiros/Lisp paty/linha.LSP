(defun C:linha ()
 (while (setq inclinação (getreal "\nInforme a inclinação da linha < >:"))
    (setq distancia (getreal "\nInforme o tamanho da linha < >:"))
  (setq ponto1 (getpoint"\nInsira o local da linha"))
  (setq ponto2 (polar ponto1 0 100))
  (setq ponto3 (polar ponto2 (/ pi 2) inclinação))
  (SETQ angulo (angle ponto1 ponto3))
  (SETQ angulo_text (rtos(angle ponto1 ponto3)))
  (setq ponto4 (polar ponto1 angulo distancia))
  (setq pos (/ distancia 2))
  (setq pos_text (polar ponto1 angulo pos))
  (command "pline" ponto1 ponto4 "")
  (setq texto (strcat ""(rtos inclinação 2 2) "%")) 
  (command "text" pos_text "" "" texto)
  (command "select" "last" "")
  (command "rotate" "previous" "" ponto1 "r" ponto4 ponto4 ponto3))
  (princ)
  )