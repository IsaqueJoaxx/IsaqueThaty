(defun c:ib (/ n n1 n2 n3 LstCrd PrjSet WhtSet PrjSet WhtObj WhtLst IntPnt PrjObj PrjLst WinCrd)
;;;  (vl-load-com)
;;;  (setq CurSpc (vla-get-modelspace (vla-get-activedocument (vlax-get-acad-object))))
  (setvar "CMDECHO" 0)
  (command "UNDO" "BEGIN")
  (command "INSERT" "IB.DWG" (command))
  (setvar "CMDECHO" 1)
  (setq OsmBak (getvar "OSMODE"))
  (if (< OsmBak 16384)
    (setvar "OSMODE" (+ 16384 OsmBak))
  )
  
  (setq n 0 n1 0 n2 0 n3 0 LstCrd nil)
  (setq WhtSet (ssget '((0 . "LWPOLYLINE")(8 . "+Cor7")))
        PrjSet (ssget "_CP" (foreach x (cdadr (ssnamex WhtSet 1)) (setq WinCrd (append WinCrd (cdr x)))) '((0 . "LWPOLYLINE")(8 . "+Projeto"))))
  (acet-ui-progress "Progresso:" (sslength WhtSet))
  (while (/= (ssname WhtSet n) nil)
    (setq WhtObj (ssname WhtSet n) WhtLst (entget WhtObj))
    (while (and (= IntPnt nil)(/= (ssname PrjSet n1) nil))
      (setq PrjObj (ssname PrjSet n1) PrjLst (entget PrjObj))
      (while (nth n2 PrjLst)
	(if (= 10 (car (nth n2 PrjLst)))
	  (setq LstCrd (append LstCrd (list (nth n2 PrjLst))))
	)
	(setq n2 (1+ n2))
      )
      (setq n2 0)
      (while (nth (1+ n3) LstCrd)
	(if (= IntPnt nil)
	  (setq IntPnt (inters (cdr (assoc 10 WhtLst)) (cdr (assoc 10 (reverse WhtLst))) (cdr (nth n3 LstCrd)) (cdr (nth (1+ n3) LstCrd))))
	)
	(setq n3 (1+ n3))
      )
      (setq n3 0 n1 (1+ n1))
      (if (/= IntPnt nil)
	(progn
	  (entmakex (list (cons 0 "INSERT")(cons 2 "Ib")(cons 10 IntPnt)))
	  (ssdel PrjObj PrjSet)
	)
      )
      (setq LstCrd nil)
    )
    (setq n1 0 n2 0 n3 0 IntPnt nil n (1+ n))
    (acet-ui-progress -1)
  )
  (setvar "OSMODE" OsmBak)
  (acet-ui-progress-done)
  (setvar "CMDECHO" 0)
  (command "UNDO" "END")
  (setvar "CMDECHO" 1)
  (princ)
)
    