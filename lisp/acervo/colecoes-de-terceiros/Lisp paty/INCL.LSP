(princ "\nDigite INC: ")
(defun c:inc (/ ponto1 ponto2 alt base po texto)
  (setq osm (getvar "osmode"))
  (while
    (Setq ponto1 (getpoint "\nIndique 1º ponto da linha"))
     (setq xp1 (car ponto1))
     (setq yp1 (cadr ponto1))
     (Setq ponto2 (getpoint "\nIndique 2º ponto da linha"))
     (setq yp2 (cadr ponto2))
     (setq xp2 (car ponto2))
     (setq alt (- yp2 yp1))
     (setq base (- xp2 xp1))
     (setq Xnome (/ (+ xp1 xp2) 2))
     (setq ynome (/ (+ yp1 yp2) 2))
     (setq po (list Xnome Ynome))
     (setq fin (* 100 (/ alt base)))
     (setq texto (strcat (rtos fin 2 2) "%"))
     (Setq echo (getvar "cmdecho"))
     (setvar "cmdecho" 0)
     (setvar "osmode" 0)
(ENTMAKE (LIST (CONS 0 "TEXT")
	       (CONS 8 "INCLINAÇÃO")
	       (CONS 10 PO)
	       (CONS 40 1.5)
	       (CONS 1 TEXTO)
	       (CONS 50 0.0)
	 )
)
     (setvar "osmode" osm)
     (setvar "cmdecho" echo)
  )
  (PRINC)
)