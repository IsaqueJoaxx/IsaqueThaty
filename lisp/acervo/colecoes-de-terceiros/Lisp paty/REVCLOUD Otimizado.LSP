(princ "\nDesenvolvido por Daniel Roberto Romualdo dos Santos")
(PRINC "\nDigite RV: ")
(defun c:RV ()
  (setq echo (getvar "CMDECHO"))
  (setvar "CMDECHO" 0)
  (setq arc (getreal "\nInforme o Comprimento do Arco: "))
  (WHILE
    (setq p1 (getpoint "\nInforme o primeiro ponto: "))
     (setq p2 (getpoint "\nInforme o primeiro ponto: "))
     (command "._RECTANG" p1 p2 "")
     (setq sel (entlast))
     (command "._revcloud" "a" arc arc "O" SEL "YES")
     (setvar "CMDECHO" echo)
  )
  (PRINC)
)