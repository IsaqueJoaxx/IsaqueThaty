(defun c:DivPFL (/)
  (setq CrdNov nil
	OsnVar (getvar "OSMODE")
	n 0
	CrdLst nil
	VerNum -1
	EntPln (entsel "\nSelecione o perfil para dividir: ")
	DivEsp (getreal "\nDigite o espaçamento para divisão: ")
	DrwVer (getstring "\nDesenhar vértices? [Sim/Não] <Sim>: ")
	GetPln (entget (car EntPln))
	DifDiv 0
  )
  (foreach xy GetPln (if (= 10 (car xy)) (setq VerNum (1+ VerNum) CrdLst (cons (trans (cdr xy) 0 1) CrdLst))))
  (if (> (car (nth 0 CrdLst)) (car (nth 1 CrdLst)))
    (setq CrdLst (reverse CrdLst))
  )
  (setq CrdNov (cons (nth 0 CrdLst) CrdNov))
  (repeat VerNum
    (setq EstIni (car (nth n CrdLst))
	  EstFim (car (nth (1+ n) CrdLst))
	  EstDif (+ (- EstFim EstIni)(* DivEsp DifDiv))
	  NumDiv (/ EstDif DivEsp)
    )
    (repeat (fix NumDiv)
      (setq EstIni (+ EstIni (- DivEsp (* DivEsp DifDiv)))
	    DifDiv 0
	    CrdBs1 (subst EstIni (car (nth n CrdLst)) (nth n CrdLst))
	    CrdBs2 (subst (+ 100 (cadr CrdBs1)) (cadr CrdBs1) CrdBs1)
	    CrdInt (inters (nth n CrdLst) (nth (1+ n) CrdLst) CrdBs1 CrdBs2 nil)
	    CrdNov (cons CrdInt CrdNov)
      )
    )
    (setq DifDiv (- NumDiv (fix NumDiv))
	  n (1+ n)
    )
  )
  (setq CrdNov (reverse CrdNov))
    
;;;  (command "erase" EntPln "")
  (setvar "OSMODE" 0)
  (command "pline")
  (foreach crd CrdNov (command crd))
  (command "")
  (setvar "OSMODE" OsnVar)
  (setq DWGInfo (strcat (getvar "dwgprefix") (vl-string-right-trim ".dwg" (getvar "dwgname"))))
  (setq FileName (getfiled "Arquivo de dados a ser criado" DWGInfo "csv" 1))
  (if (/= FileName nil)
    (progn
      (setq arquivo (open FileName "w"))
      (foreach crd CrdNov (write-line (vl-string-subst "," "." (rtos (cadr crd) 2 4)) arquivo))
      (close arquivo)
    )
  )
  (print)
)