(defun c:TGPNT ()
  (princ "\n*** Corrige os pontos do topoGRAPH utilizando a cota do atributo ***")
  (princ "\nSelecione os pontos do topoGRAPH: ")
  (setq GrpPnt (ssget '((0 . "INSERT")))
	LenGrp (sslength GrpPnt)
	n 0
  )
  (setvar "CMDECHO" 0)
  (command "UNDO" "BEGIN")
  (repeat LenGrp
    (setq EntPnt (ssname GrpPnt n))
    (setq LstPnt (entget EntPnt))
    (setq LstAtt (entget(entnext(entnext(entnext EntPnt)))))
    (if (= "COTA" (cdr(assoc 2 LstAtt)))
      (progn
	(setq CtaPnt (distof (vl-string-subst "." "," (cdr (assoc 1 LstAtt)))))
	(setq CrdPnt (assoc 10 LstPnt))
	(setq NewCrd (subst CtaPnt (cadddr (assoc 10 LstPnt)) CrdPnt))
	(setq NewPnt (subst NewCrd (assoc 10 LstPnt) LstPnt))
	(entmod NewPnt)
	(setq n (1+ n))
      )
    )
  )
  (command "UNDO" "END")
  (setvar "CMDECHO" 0)
  (alert (strcat (itoa n) " pontos corrigidos"))
  (princ)
)