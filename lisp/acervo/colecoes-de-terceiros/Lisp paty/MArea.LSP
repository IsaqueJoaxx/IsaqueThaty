(defun c:marea()
  (setvar "CMDECHO" 0)
  (princ "Selecione as polilinhas das seções:")
  (setq OsnMode (getvar "OSMODE"))
  (setvar "OSMODE" 0)
  (setq	n 0
	n1 0
        SecGrp (ssget '((0 . "LWPOLYLINE")))
	LenGrp (sslength SecGrp)
	PntGrp (getpoint "\nClique dentro da área a ser medida:")
	BoundGRP (ssadd)
	LayLst nil
  )
  (setvar "OSMODE" OsnMode)
  (command "UNDO" "BEGIN")
  (repeat LenGrp
    (setq EntGrp (entget (ssname SecGRP n))
	  EntClr (cdr (assoc 62 EntGrp))
    )
    (if (= EntClr 3)
      (setq LayNam "+Primitivo")
    )
    (if (= EntClr 6)
      (setq LayNam "+Projeto")
    )
    (if (not
	  (or
	    (= EntClr 3)
	    (= EntClr 6)
	  )
	)
      (setq LayNam (strcat "+Cor" (rtos EntClr 2 0)))
    )
    (command "LAYER" "MAKE" LayNam "c" EntClr "" "")
    (setq EntNly (subst (cons 8 LayNam) (assoc 8 Entgrp) EntGrp))
    (command "LAYER" "MAKE" "0" "")
    (command "LAYER" "OFF" LayNam "")

    (entmod EntNly)
    (setq LayLst (cons LayNam LayLst))
    (setq n (1+ n))    
  )
  (command "LAYER" "ON" "+Primitivo" "")
  (repeat (length LayLst)
    (if (or
	  (= (nth n1 LayLst) "+Projeto")
	  (= (nth n1 LayLst) "+Primitivo")
	)
      (princ)
      (progn
	(command "LAYER" "ON" (nth n1 LayLst) "")
	(command "LAYER" "MAKE" (nth n1 LayLst) "")
	(command "BOUNDARY" "A" "O" "REGION" "" PntGrp "")
	(ssadd (entlast) BoundGRP)
	(command "LAYER" "MAKE" "0" "")
	(command "LAYER" "OFF" (nth n1 LayLst) "")
      )
    )
  (setq n1 (1+ n1))
  )
  (command "union" BoundGRP "")
  (setq BoundSec (entlast))
  (command "LAYER" "ON" "+Projeto" "")
  (command "LAYER" "MAKE" "+Boundary" "c" "253" "" "")
  (command "BOUNDARY" "A" "O" "REGION" "" PntGrp "")
  (setq BoundPri (entlast))
  (command "INTERSECT" BoundPri BoundSec "")
  (command "CHPROP" (entlast) "" "LA" "+Boundary" "")
  (foreach x LayLst (command "LAYER" "ON" x ""))
  (command "HATCH" "ANSI31" "" "" "S" (entlast) "")
  (command "LAYER" "MAKE" "0" "")
  (command "UNDO" "END")
  (command "AREA" "O" (entlast))
  (setvar "CMDECHO" 1)
  (princ (strcat "\n\nArea do Objeto: " (rtos (getvar "AREA")2 3) " m²"))
  (princ)
)