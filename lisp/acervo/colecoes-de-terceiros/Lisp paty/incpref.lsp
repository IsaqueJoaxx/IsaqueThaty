(defun c:incpref (/ valor alturatexto p1 texto prefixo passo)
  (setq echo (getvar "cmdecho"))
  (setvar "cmdecho" 0)
  (command "layer" "m" "txt" "c" "2" "" "")
  (setq prefixo (getstring t "\nDigite o prefixo para o número: "))
  (setq sufixo (getstring t "\nDigite o sufixo para o número: "))
  (initget 1)
  (setq valor (getint "\nQual o número inicial: "))
  (initget 1)
  (setq passo (getint "\nQual o passo a utilizar: "))
  (initget 1)
  (setq alturatexto (getreal "\nQual a altura do texto: "))
  (initget 1)
  (setq rottexto (getreal "\nQual o angulo do texto: "))
  (while 
    (setq p1 (getpoint "\nIndique um ponto de inserção ou [ENTER] para sair: "))
    (setq txttemp (strcat prefixo (rtos valor 2 0)))
    (setq texto (strcat txttemp sufixo))
    (command "text" "c" p1 alturatexto rottexto texto)
   (setq valor (+ valor passo))
  )
  (setvar "cmdecho" echo)
  (princ)
)