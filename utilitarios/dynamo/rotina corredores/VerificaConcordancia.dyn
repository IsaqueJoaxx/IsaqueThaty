      "InputValue": "CORREDOR LOTEAMENTO"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# -*- coding: utf-8 -*-\n# SOMENTE LEITURA. Mede as concordancias criadas e valida contra o esperado.\nRAIO_ESPERADO = 2.0\nOFFSET_ESPERADO = 4.2407\nDESTINO = r\"D:\\Claude ai\\Dynamo rotinas\\rotina corredores\\verifica.txt\"\n\nimport clr, io, math\nclr.AddReference('AcMgd'); clr.AddReference('AcDbMgd')\nclr.AddReference('AcCoreMgd'); clr.AddReference('AeccDbMgd')\nfrom Autodesk.AutoCAD.ApplicationServices import Application\nfrom Autodesk.AutoCAD.DatabaseServices import OpenMode\nfrom Autodesk.Civil.ApplicationServices import CivilApplication\ntry:\n    from Autodesk.Civil import AlignmentType\nexcept ImportError:\n    AlignmentType = None\n\nout = []\n\ndef st_off(a, x, y):\n    for args in ((x, y), (x, y, 0.0, 0.0)):\n        try:\n            r = a.StationOffset(*args)\n            if r is not None:\n                return float(r[0]), float(r[1])\n        except Exception:\n            pass\n    return None, None\n\nadoc = Application.DocumentManager.MdiActiveDocument\ncivdoc = CivilApplication.ActiveDocument\n\nwith adoc.LockDocument():\n    db = adoc.Database\n    with db.TransactionManager.StartTransaction() as t:\n\n        todos = []\n        for aid in civdoc.GetAlignmentIds():\n            a = t.GetObject(aid, OpenMode.ForRead)\n            todos.append((a.Name, aid, a))\n\n        out.append(u\"=== %d alinhamento(s) no desenho ===\" % len(todos))\n        for nome, aid, a in todos:\n            tipo = u\"?\"\n            try:\n                tipo = str(a.AlignmentType)\n            except Exception:\n                pass\n            out.append(u\"   %-45s  tipo=%-12s  comp=%8.3f\"\n                       % (nome, tipo, a.EndingStation - a.StartingStation))\n        out.append(u\"\")\n\n        # ------------------------------------------------ concordancias\n        conc = [(n, i, a) for n, i, a in todos if n.startswith(u\"CONC\")]\n        out.append(u\"=== %d concordancia(s) ===\" % len(conc))\n\n        eixos = [(n, i, a) for n, i, a in todos if not n.startswith(u\"CONC\")]\n\n        for nome, aid, a in conc:\n            out.append(u\"\")\n            out.append(u\"--- %s ---\" % nome)\n            out.append(u\"   comprimento total = %.4f m\"\n                       % (a.EndingStation - a.StartingStation))\n            try:\n                out.append(u\"   AlignmentType = %s\" % a.AlignmentType)\n            except Exception:\n                pass\n\n            # geometria: entidades\n            try:\n                out.append(u\"   %d entidade(s):\" % a.Entities.Count)\n                for e in a.Entities:\n                    tn = type(e).__name__\n                    linha = u\"      %s\" % tn\n                    for prop in ('Length', 'Radius', 'StartPoint', 'EndPoint',\n                                 'Delta'):\n                        try:\n                            v = getattr(e, prop)\n                            if prop in ('StartPoint', 'EndPoint'):\n                                linha += u\"  %s=(%.3f, %.3f)\" % (prop, v.X, v.Y)\n                            elif prop == 'Delta':\n                                linha += u\"  %s=%.4f rad (%.2f graus)\" % (\n                                    prop, float(v), math.degrees(float(v)))\n                            else:\n                                linha += u\"  %s=%.4f\" % (prop, float(v))\n                        except Exception:\n                            pass\n                    out.append(linha)\n            except Exception as ex:\n                out.append(u\"   (entidades: %s)\" % ex)\n\n            # extremos e distancia aos eixos pais\n            try:\n                p0 = a.StartPoint\n                p1 = a.EndPoint\n                out.append(u\"   inicio = (%.3f, %.3f)\" % (p0.X, p0.Y))\n                out.append(u\"   fim    = (%.3f, %.3f)\" % (p1.X, p1.Y))\n                for rot, pt in ((u\"inicio\", p0), (u\"fim\", p1)):\n                    melhor = None\n                    for n2, i2, a2 in eixos:\n                        s, o = st_off(a2, pt.X, pt.Y)\n                        if s is None:\n                            continue\n                        if melhor is None or abs(o) < abs(melhor[2]):\n                            melhor = (n2, s, o)\n                    if melhor:\n                        marca = u\"\"\n                        if abs(abs(melhor[2]) - OFFSET_ESPERADO) < 0.02:\n                            marca = u\"   <-- bate com a face do meio-fio\"\n                        out.append(u\"   %s: eixo mais proximo %s  est %.3f  \"\n                                   u\"offset %+.4f%s\"\n                                   % (rot, melhor[0], melhor[1], melhor[2], marca))\n            except Exception as ex:\n                out.append(u\"   (extremos: %s)\" % ex)\n\n            # perfis\n            try:\n                pids = a.GetProfileIds()\n                out.append(u\"   perfis: %d\" % pids.Count)\n                for pid in pids:\n                    pr = t.GetObject(pid, OpenMode.ForRead)\n                    out.append(u\"      %s  (%s)\" % (pr.Name, pr.ProfileType))\n            except Exception as ex:\n                out.append(u\"   (perfis: %s)\" % ex)\n\n        t.Commit()\n\nf = io.open(DESTINO, 'w', encoding='utf-8'); f.write(u\"\\n\".join(out)); f.close()\nOUT = [u\"gravado: %s (%d linhas)\" % (DESTINO, len(out))]\n",
      "Engine": "PythonNet3",
      "VariableInputPorts": true,
