      "NodeType": "StringInputNode",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "da09af73f89340a894743b612f0632c9",
          "Name": "",
          "Description": "String",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
