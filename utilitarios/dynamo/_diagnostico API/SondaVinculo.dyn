    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# -*- coding: utf-8 -*-\n# SOMENTE LEITURA. Procura mecanismo ASSOCIATIVO para amarrar greide.\nimport clr, io\nclr.AddReference('AcMgd'); clr.AddReference('AcDbMgd')\nclr.AddReference('AcCoreMgd'); clr.AddReference('AeccDbMgd')\nimport Autodesk.Civil.DatabaseServices as CDS\nimport Autodesk.Civil as CIV\n\nDESTINO = r\"D:\\Claude ai\\Dynamo rotinas\\rotina corredores\\vinculo.txt\"\nout = []\n\ndef props(tipo, titulo, filtro=None):\n    out.append(u\"##### %s #####\" % titulo)\n    try:\n        t = clr.GetClrType(tipo)\n    except Exception as e:\n        out.append(u\"  <erro: %s>\" % e); out.append(u\"\"); return\n    for pi in sorted(t.GetProperties(), key=lambda x: x.Name):\n        if filtro and filtro.lower() not in pi.Name.lower():\n            continue\n        out.append(u\"  %s %s  (set=%s)\" % (pi.PropertyType.Name, pi.Name, pi.CanWrite))\n    out.append(u\"\")\n\ndef metodos(tipo, titulo, filtro=None):\n    out.append(u\"##### %s #####\" % titulo)\n    try:\n        t = clr.GetClrType(tipo)\n    except Exception as e:\n        out.append(u\"  <erro: %s>\" % e); out.append(u\"\"); return\n    ms = set()\n    for mi in t.GetMethods():\n        if mi.Name.startswith(('get_', 'set_', 'add_', 'remove_')):\n            continue\n        if filtro and filtro.lower() not in mi.Name.lower():\n            continue\n        ps = u\", \".join(u\"%s %s\" % (p.ParameterType.Name, p.Name)\n                        for p in mi.GetParameters())\n        ms.add(u\"  %s%s %s(%s)\" % (u\"static \" if mi.IsStatic else u\"\",\n                                   mi.ReturnType.Name, mi.Name, ps))\n    out.extend(sorted(ms) or [u\"  (nenhum)\"])\n    out.append(u\"\")\n\nprops(CDS.Profile, u\"1. Profile: TODAS as propriedades\")\nprops(CDS.ProfilePVI, u\"2. ProfilePVI: TODAS as propriedades\")\nmetodos(CDS.Profile, u\"3. Profile: metodos com 'dynamic/super/feature/parent/update'\", None)\n\nout.append(u\"##### 4. Tipos com 'Superimposed' / 'Dynamic' / 'FeatureLine' #####\")\nout += sorted([n for n in dir(CDS) if any(k in n.lower() for k in\n               ('superimposed', 'dynamic', 'featureline'))]) or [u\"  (nenhum)\"]\nout.append(u\"\")\n\nout.append(u\"##### 5. ProfileType: valores #####\")\ntry:\n    for n in clr.GetClrType(CDS.ProfileType if hasattr(CDS, 'ProfileType')\n                            else CIV.ProfileType).GetEnumNames():\n        out.append(u\"  %s\" % n)\nexcept Exception as e:\n    out.append(u\"  <erro: %s>\" % e)\nout.append(u\"\")\n\nprops(CDS.Alignment, u\"6. Alignment: propriedades com 'dynamic/parent/offset'\", None)\n\nf = io.open(DESTINO, 'w', encoding='utf-8'); f.write(u\"\\n\".join(out)); f.close()\nOUT = [u\"gravado: %s (%d linhas)\" % (DESTINO, len(out))]\n",
      "Engine": "PythonNet3",
      "VariableInputPorts": true,
      "Id": "5cf48fab9bae459b94325586bfcdb3c2",
