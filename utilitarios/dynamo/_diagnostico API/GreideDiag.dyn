{
  "Uuid": "38042bab-33fb-4db6-901f-e87b924fd716",
  "IsCustomNode": false,
  "Description": "Geracao automatica de greide: le o perfil do terreno do alinhamento, gera os PIVs respeitando a rampa maxima e dimensiona as curvas verticais por K minimo.",
  "Name": "GreideDiag",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [],
  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Id": "559edfa8-b244-48f0-986d-21f5c6c0c49b",
      "NodeType": "PythonScriptNode",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "10e44956-c0ee-4b25-9c24-dabe75c20fdd",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script.",
      "Code": "# -*- coding: utf-8 -*-\n# Descobre as assinaturas reais da API de perfis do Civil 3D por reflexao .NET\nimport clr\nclr.AddReference('AcMgd'); clr.AddReference('AcCoreMgd'); clr.AddReference('AcDbMgd')\nclr.AddReference('AecBaseMgd'); clr.AddReference('AeccDbMgd')\n\nfrom Autodesk.Civil.DatabaseServices import (ProfileEntityCollection, ProfilePVICollection,\n                                             ProfilePVI, Profile, VerticalCurveType)\n\nout = []\n\ndef dump(tipo, filtro):\n    out.append(\"\")\n    out.append(\"=\" * 78)\n    out.append(\"### \" + tipo.FullName)\n    out.append(\"=\" * 78)\n    vistos = set()\n    for m in tipo.GetMethods():\n        if filtro and not any(f.lower() in m.Name.lower() for f in filtro):\n            continue\n        ps = \", \".join(\"%s %s\" % (p.ParameterType.Name, p.Name) for p in m.GetParameters())\n        linha = \"%s %s(%s)\" % (m.ReturnType.Name, m.Name, ps)\n        if linha not in vistos:\n            vistos.add(linha)\n            out.append(\"  \" + linha)\n    for p in tipo.GetProperties():\n        if filtro and not any(f.lower() in p.Name.lower() for f in filtro):\n            continue\n        out.append(\"  [prop] %s %s  (get=%s set=%s)\"\n                   % (p.PropertyType.Name, p.Name, p.CanRead, p.CanWrite))\n\ndump(ProfileEntityCollection, [\"parabola\", \"curve\", \"tangent\", \"add\"])\ndump(ProfilePVICollection, [\"add\", \"item\"])\ndump(ProfilePVI, [\"curve\", \"length\", \"station\", \"elevation\", \"grade\", \"k\"])\n\nout.append(\"\")\nout.append(\"### VerticalCurveType (valores possiveis)\")\nfor n in VerticalCurveType.GetEnumNames():\n    out.append(\"  \" + n)\n\nout.append(\"\")\nout.append(\"### Profile.CreateByLayout (assinaturas)\")\nfor m in Profile.GetMethods():\n    if m.Name == \"CreateByLayout\":\n        ps = \", \".join(\"%s %s\" % (p.ParameterType.Name, p.Name) for p in m.GetParameters())\n        out.append(\"  %s CreateByLayout(%s)\" % (m.ReturnType.Name, ps))\n\nOUT = \"\\n\".join(out)\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true
    },
