    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# -*- coding: utf-8 -*-\n# SOMENTE LEITURA. Nomes reais das propriedades das entidades de perfil.\nimport clr, io\nclr.AddReference('AcMgd'); clr.AddReference('AcDbMgd')\nclr.AddReference('AcCoreMgd'); clr.AddReference('AeccDbMgd')\nfrom Autodesk.AutoCAD.ApplicationServices import Application\nfrom Autodesk.AutoCAD.DatabaseServices import OpenMode\nfrom Autodesk.Civil.ApplicationServices import CivilApplication\nimport Autodesk.Civil.DatabaseServices as CDS\ntry:\n    from Autodesk.Civil import ProfileType\nexcept ImportError:\n    from Autodesk.Civil.DatabaseServices import ProfileType\n\nDESTINO = r\"D:\\Claude ai\\Dynamo rotinas\\rotina corredores\\entidades.txt\"\nout = []\n\ndef dump(tipo, titulo):\n    out.append(u\"##### %s #####\" % titulo)\n    try:\n        t = clr.GetClrType(tipo)\n    except Exception as e:\n        out.append(u\"  <erro: %s>\" % e); out.append(u\"\"); return\n    out.append(u\"  -- propriedades --\")\n    for pi in sorted(t.GetProperties(), key=lambda x: x.Name):\n        out.append(u\"    %s %s  (set=%s)\" % (pi.PropertyType.Name, pi.Name, pi.CanWrite))\n    out.append(u\"  -- metodos --\")\n    ms = set()\n    for mi in t.GetMethods():\n        if mi.Name.startswith(('get_', 'set_', 'add_', 'remove_')):\n            continue\n        ps = u\", \".join(u\"%s %s\" % (p.ParameterType.Name, p.Name)\n                        for p in mi.GetParameters())\n        ms.add(u\"    %s%s %s(%s)\" % (u\"static \" if mi.IsStatic else u\"\",\n                                     mi.ReturnType.Name, mi.Name, ps))\n    out.extend(sorted(ms))\n    out.append(u\"\")\n\ndump(CDS.ProfileEntity, u\"1. ProfileEntity (base)\")\ndump(CDS.ProfileTangent, u\"2. ProfileTangent\")\ndump(CDS.ProfileEntityCollection, u\"3. ProfileEntityCollection\")\n\nout.append(u\"##### 4. Tipos de entidade de perfil no namespace #####\")\nout += sorted([n for n in dir(CDS) if n.startswith('Profile')])\nout.append(u\"\")\n\n# --- amostra real de um greide do desenho ---\nout.append(u\"##### 5. Amostra: entidades de um greide real #####\")\nadoc = Application.DocumentManager.MdiActiveDocument\ncivdoc = CivilApplication.ActiveDocument\nwith adoc.LockDocument():\n    db = adoc.Database\n    with db.TransactionManager.StartTransaction() as t:\n        for aid in civdoc.GetAlignmentIds():\n            a = t.GetObject(aid, OpenMode.ForRead)\n            if 'ALINHAMENTO -1' not in a.Name:\n                continue\n            for pid in a.GetProfileIds():\n                p = t.GetObject(pid, OpenMode.ForRead)\n                if p.ProfileType != ProfileType.FG:\n                    continue\n                out.append(u\"  perfil: %s   %d entidade(s)\" % (p.Name, p.Entities.Count))\n                for e in p.Entities:\n                    out.append(u\"   --- entidade tipo %s (id=%s) ---\"\n                               % (type(e).__name__, getattr(e, 'EntityId', '?')))\n                    for nome in ('StartStation', 'StartElevation', 'EndStation',\n                                 'EndElevation', 'Grade', 'GradeIn', 'GradeOut',\n                                 'Length', 'EntityType', 'EntityAfter',\n                                 'EntityBefore', 'PVIStation', 'PVIElevation'):\n                        try:\n                            out.append(u\"       %s = %s\" % (nome, getattr(e, nome)))\n                        except Exception as ex:\n                            pass\n                out.append(u\"  -- PVIs --\")\n                for pv in p.PVIs:\n                    out.append(u\"       est %.4f  cota %.4f  tipo %s\"\n                               % (pv.Station, pv.Elevation, pv.PVIType))\n            break\n        t.Commit()\n\nf = io.open(DESTINO, 'w', encoding='utf-8'); f.write(u\"\\n\".join(out)); f.close()\nOUT = [u\"gravado: %s (%d linhas)\" % (DESTINO, len(out))]\n",
      "Engine": "PythonNet3",
      "VariableInputPorts": true,
