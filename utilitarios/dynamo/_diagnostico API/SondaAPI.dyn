    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Id": "5cf48fab9bae459b94325586bfcdb3c2",
      "NodeType": "PythonScriptNode",
      "Code": "# -*- coding: utf-8 -*-\n# Sonda 2 - SOMENTE LEITURA. Foco: criacao de concordancias (curb return).\nimport clr, io\nclr.AddReference('AcMgd'); clr.AddReference('AcDbMgd')\nclr.AddReference('AcCoreMgd'); clr.AddReference('AeccDbMgd')\nimport Autodesk.Civil.DatabaseServices as CDS\nimport Autodesk.Civil as CIV\n\nDESTINO = r\"D:\\Claude ai\\Dynamo rotinas\\rotina corredores\\sonda_api2.txt\"\nout = []\n\ndef detalha(tipo, titulo):\n    out.append(u\"##### %s #####\" % titulo)\n    try:\n        t = clr.GetClrType(tipo)\n    except Exception as e:\n        out.append(u\"  <sem tipo CLR: %s>\" % e); out.append(u\"\"); return\n    out.append(u\"  -- construtores --\")\n    ctors = t.GetConstructors()\n    if not ctors:\n        out.append(u\"    (nenhum publico)\")\n    for c in ctors:\n        ps = u\", \".join(u\"%s %s\" % (p.ParameterType.Name, p.Name) for p in c.GetParameters())\n        out.append(u\"    new %s(%s)\" % (t.Name, ps))\n    out.append(u\"  -- propriedades --\")\n    for pi in sorted(t.GetProperties(), key=lambda x: x.Name):\n        out.append(u\"    %s %s  (get=%s set=%s)\"\n                   % (pi.PropertyType.Name, pi.Name, pi.CanRead, pi.CanWrite))\n    out.append(u\"  -- metodos --\")\n    ms = set()\n    for mi in t.GetMethods():\n        if mi.Name.startswith('get_') or mi.Name.startswith('set_'):\n            continue\n        ps = u\", \".join(u\"%s %s\" % (p.ParameterType.Name, p.Name) for p in mi.GetParameters())\n        ms.add(u\"    %s%s %s(%s)\" % (u\"static \" if mi.IsStatic else u\"\",\n                                     mi.ReturnType.Name, mi.Name, ps))\n    out.extend(sorted(ms))\n    out.append(u\"\")\n\ndef enum_vals(tipo, titulo):\n    out.append(u\"##### %s #####\" % titulo)\n    try:\n        t = clr.GetClrType(tipo)\n        for n in t.GetEnumNames():\n            out.append(u\"    %s\" % n)\n    except Exception as e:\n        out.append(u\"    <erro: %s>\" % e)\n    out.append(u\"\")\n\ndetalha(CDS.ConnectedAlignmentParams, u\"1. ConnectedAlignmentParams\")\nenum_vals(CIV.CurbReturnType, u\"2. CurbReturnType\")\nenum_vals(CIV.CurbReturnCurveGroupType, u\"3. CurbReturnCurveGroupType\")\n\nout.append(u\"##### 4. Tipos do namespace com 'Connected' ou 'Param' #####\")\nout += sorted([n for n in dir(CDS)\n               if 'connected' in n.lower() or 'curbreturn' in n.lower()]) or [u\"  (nenhum)\"]\nout.append(u\"\")\n\nout.append(u\"##### 5. IntersectionRoad / IntersectionRegion: metodos #####\")\nfor nome in ('IntersectionRoad', 'IntersectionRegion'):\n    try:\n        t = clr.GetClrType(getattr(CDS, nome))\n        out.append(u\"  -- %s --\" % nome)\n        for mi in sorted(set(m.Name for m in t.GetMethods()\n                             if not m.Name.startswith(('get_', 'set_')))):\n            out.append(u\"    %s\" % mi)\n    except Exception as e:\n        out.append(u\"  %s: %s\" % (nome, e))\nout.append(u\"\")\n\nf = io.open(DESTINO, 'w', encoding='utf-8'); f.write(u\"\\n\".join(out)); f.close()\nOUT = [u\"gravado: %s (%d linhas)\" % (DESTINO, len(out))]\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
