{
  "Uuid": "955de1a5-19f1-4f5f-be63-545ef7741cf9",
  "IsCustomNode": false,
  "Description": "Cria Point Groups no Civil 3D a partir da descricao dos pontos COGO",
  "Name": "ClassificaPontos_PointGroups",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [],
  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "CoreNodeModels.Input.BooleanSelector, CoreNodeModels",
      "NodeType": "BooleanInputNode",
      "InputValue": false,
      "Id": "39e92443660642a9b19a23430f4f0576",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "06bd0e8a1961420a831b61caec08de2c",
          "Name": "",
          "Description": "Boolean",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Seleciona entre true e false."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "# ============================================================\n# CLASSIFICA PONTOS - Dynamo para Civil 3D\n# Cria/atualiza Point Groups a partir da descricao bruta (Raw\n# Description) dos pontos COGO ja importados no desenho.\n# IN[0] = Boolean (True = executar)\n# ============================================================\nimport clr\nclr.AddReference('AcMgd')\nclr.AddReference('AcDbMgd')\nclr.AddReference('AeccDbMgd')\n\nfrom Autodesk.AutoCAD.ApplicationServices import Application\nfrom Autodesk.AutoCAD.DatabaseServices import OpenMode\nfrom Autodesk.Civil.ApplicationServices import CivilApplication\nfrom Autodesk.Civil.DatabaseServices import StandardPointGroupQuery\n\nexecutar = IN[0]\n\ndef limpa(nome):\n    invalidos = '<>/\\\\\":;?*|,=`'\n    s = ''.join('_' if c in invalidos else c for c in nome)\n    s = s.strip()\n    return s if s else 'SEM_CODIGO'\n\nresultado = []\n\nif not executar:\n    OUT = 'Mude o Boolean para True e rode o grafo (Run).'\nelse:\n    adoc = Application.DocumentManager.MdiActiveDocument\n    civdoc = CivilApplication.ActiveDocument\n    db = adoc.Database\n\n    with adoc.LockDocument():\n        t = db.TransactionManager.StartTransaction()\n        try:\n            # 1) varre todos os pontos COGO e agrupa por descricao\n            pontos = civdoc.CogoPoints\n            mapa = {}   # descricao -> lista de numeros de ponto\n            total = 0\n            for oid in pontos:\n                p = t.GetObject(oid, OpenMode.ForRead)\n                d = (p.RawDescription or '').strip().upper()\n                if not d:\n                    d = 'SEM_CODIGO'\n                mapa.setdefault(d, []).append(int(p.PointNumber))\n                total += 1\n\n            if total == 0:\n                resultado.append('Nenhum ponto COGO encontrado no desenho.')\n            else:\n                # 2) grupos ja existentes\n                grupos = civdoc.PointGroups\n                existentes = {}\n                for gid_ in grupos:\n                    g = t.GetObject(gid_, OpenMode.ForRead)\n                    existentes[g.Name.upper()] = gid_\n\n                # 3) cria/atualiza um grupo por descricao\n                for desc in sorted(mapa.keys()):\n                    nome = limpa(desc)\n                    q = StandardPointGroupQuery()\n                    if desc == 'SEM_CODIGO':\n                        # sem descricao: consulta por numero de ponto\n                        q.IncludeNumbers = ','.join(str(n) for n in sorted(mapa[desc]))\n                    else:\n                        q.IncludeRawDescriptions = desc\n\n                    if nome.upper() in existentes:\n                        g = t.GetObject(existentes[nome.upper()], OpenMode.ForWrite)\n                        g.SetQuery(q)\n                        try:\n                            g.Update()\n                        except:\n                            pass\n                        resultado.append('%s -> atualizado (%d pontos)' % (nome, len(mapa[desc])))\n                    else:\n                        novo = grupos.Add(nome)\n                        g = t.GetObject(novo, OpenMode.ForWrite)\n                        g.SetQuery(q)\n                        try:\n                            g.Update()\n                        except:\n                            pass\n                        resultado.append('%s -> criado (%d pontos)' % (nome, len(mapa[desc])))\n\n                resultado.append('---')\n                resultado.append('Total: %d pontos em %d grupos' % (total, len(mapa)))\n\n            t.Commit()\n        except Exception as e:\n            t.Abort()\n            resultado = ['ERRO: ' + str(e)]\n        finally:\n            t.Dispose()\n\n    OUT = resultado\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "48641d48be5e497a80a3106439bbc416",
