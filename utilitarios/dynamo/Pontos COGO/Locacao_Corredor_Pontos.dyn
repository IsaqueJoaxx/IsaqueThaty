    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# =====================================================================\n#  LOCACAO DE CORREDOR - pontos COGO por codigo de ponto do corredor\n#  Civil 3D 2026/2027 - Dynamo (CPython3 ou PythonNet3)\n#\n#  IN[0] Corredores   : nomes separados por \";\"  (\"*\" = todos; aceita curinga, ex. \"01*\")\n#  IN[1] Codigos      : \"CODIGO=DESCRICAO; ...\"   (primeiro que casar vence; aceita * e ?)\n#  IN[2] Intervalo (m): 20 = estacas inteiras; 10 = estacas e meias; 0 = todas as secoes do corredor\n#  IN[3] Pontos notaveis: True inclui PC/PT/TS/SC..., inicio/fim de regiao\n#  IN[4] Grupo de pontos: prefixo do grupo (sera \"<prefixo> - <corredor>\")\n#  IN[5] Apagar anteriores: True remove os pontos que ja estavam no grupo\n#  IN[6] Pasta CSV    : \"\" = mesma pasta do DWG; \"-\" = nao exportar\n#  IN[7] EXECUTAR     : False = so lista codigos e simula; True = cria os pontos\n# =====================================================================\nimport clr, os, fnmatch\nclr.AddReference('AcMgd')\nclr.AddReference('AcCoreMgd')\nclr.AddReference('AcDbMgd')\nclr.AddReference('AecBaseMgd')\nclr.AddReference('AeccDbMgd')\n\nfrom Autodesk.AutoCAD.ApplicationServices import Application\nfrom Autodesk.AutoCAD.DatabaseServices import OpenMode\nfrom Autodesk.AutoCAD.Geometry import Point3d\nfrom Autodesk.Civil.ApplicationServices import CivilApplication\nfrom Autodesk.Civil.DatabaseServices import StandardPointGroupQuery\n\ntry:\n    from Autodesk.Civil import StationTypes\nexcept Exception:\n    try:\n        from Autodesk.Civil.DatabaseServices import StationTypes\n    except Exception:\n        StationTypes = None\n\n\ndef _s(v, d=\"\"):\n    return d if v is None else str(v)\n\n\ncorr_filtro = _s(IN[0], \"*\").strip() or \"*\"\ncodigos_txt = _s(IN[1])\nintervalo = float(IN[2] or 0)\nnotaveis = bool(IN[3])\ngrupo_prefixo = _s(IN[4], \"LOCACAO\").strip() or \"LOCACAO\"\napagar = bool(IN[5])\npasta_csv = _s(IN[6]).strip()\nexecutar = bool(IN[7])\n\nTOL_ST = 0.005      # tolerancia de estaca (m)\nTOL_XY = 0.001      # pontos duplicados (m)\n\n# ---- mapa de codigos -------------------------------------------------\nmapa = []\nfor par in codigos_txt.replace(\"\\n\", \";\").split(\";\"):\n    if \"=\" in par:\n        k, v = par.split(\"=\", 1)\n        if k.strip():\n            mapa.append((k.strip().lower(), v.strip().upper()))\n\n\ndef descricao_de(codes):\n    lc = [c.lower() for c in codes]\n    for pat, desc in mapa:\n        for c in lc:\n            if fnmatch.fnmatchcase(c, pat):\n                return desc\n    return None\n\n\ndef filtro_corredor(nome):\n    for pat in corr_filtro.split(\";\"):\n        pat = pat.strip()\n        if pat and fnmatch.fnmatchcase(nome.lower(), pat.lower()):\n            return True\n    return False\n\n\ndef estaca_txt(st, passo=20.0):\n    n = int((st + 1e-9) // passo)\n    r = st - n * passo\n    return (\"%d+%.2f\" % (n, r)).replace(\".\", \",\")\n\n\ndef lado_de(off):\n    if off < -TOL_XY:\n        return \"LE\"\n    if off > TOL_XY:\n        return \"LD\"\n    return \"\"\n\n\ndef xy_por_alinhamento(al, st, off):\n    r = al.PointLocation(st, off, 0.0, 0.0)\n    vals = [v for v in (r if isinstance(r, tuple) else [r]) if isinstance(v, float)]\n    return vals[-2], vals[-1]\n\n\ndef estacoes_notaveis(al, regioes):\n    sts = []\n    for rg in regioes:\n        sts += [rg.StartStation, rg.EndStation]\n    if StationTypes is not None and al is not None:\n        try:\n            for s in al.GetStationSet(StationTypes.GeometryPoint):\n                sts.append(float(s))\n        except Exception:\n            pass\n    return sts\n\n\ndef passa_estaca(st, notaveis_lst):\n    if intervalo <= 0:\n        return True\n    r = st % intervalo\n    if r < TOL_ST or intervalo - r < TOL_ST:\n        return True\n    if notaveis:\n        for s in notaveis_lst:\n            if abs(s - st) < TOL_ST:\n                return True\n    return False\n\n\ndef pontos_de(aa):\n    try:\n        return list(aa.Points)\n    except Exception:\n        return list(aa.GetPoints())\n\n\ndef faixas(nums):\n    nums = sorted(set(nums))\n    out, ini, ant = [], None, None\n    for n in nums:\n        if ini is None:\n            ini = ant = n\n        elif n == ant + 1:\n            ant = n\n        else:\n            out.append(str(ini) if ini == ant else \"%d-%d\" % (ini, ant))\n            ini = ant = n\n    if ini is not None:\n        out.append(str(ini) if ini == ant else \"%d-%d\" % (ini, ant))\n    return \",\".join(out)\n\n\nimport traceback\n\n\ndef main():\n    adoc = Application.DocumentManager.MdiActiveDocument\n    db = adoc.Database\n    civdoc = CivilApplication.ActiveDocument\n    relatorio = []\n    csv_linhas = []\n    csv_rel = []\n\n    lock = adoc.LockDocument()\n    try:\n        t = db.TransactionManager.StartTransaction()\n        try:\n            cogo = civdoc.CogoPoints\n            for cid in civdoc.CorridorCollection:\n                corr = t.GetObject(cid, OpenMode.ForRead)\n                if not filtro_corredor(corr.Name):\n                    continue\n                contagem_codigos = {}\n                candidatos = []   # (x, y, z, desc, baseline, st, off)\n                for bl in corr.Baselines:\n                    try:\n                        al = t.GetObject(bl.AlignmentId, OpenMode.ForRead)\n                    except Exception:\n                        al = None   # baseline por feature line (ex.: esquinas)\n                    try:\n                        bl_nome = str(bl.Name)\n                    except Exception:\n                        bl_nome = 'baseline'\n                    regioes = list(bl.BaselineRegions)\n                    notav = estacoes_notaveis(al, regioes)\n                    for rg in regioes:\n                        for aa in rg.AppliedAssemblies:\n                            for cp in pontos_de(aa):\n                                codes = [str(c) for c in cp.CorridorCodes]\n                                for c in codes:\n                                    contagem_codigos[c] = contagem_codigos.get(c, 0) + 1\n                                desc = descricao_de(codes)\n                                if desc is None:\n                                    continue\n                                soe = cp.StationOffsetElevationToBaseline\n                                st, off, z = soe.X, soe.Y, soe.Z\n                                if not passa_estaca(st, notav):\n                                    continue\n                                try:\n                                    p = cp.XYZ\n                                    x, y, z = p.X, p.Y, p.Z\n                                except Exception:\n                                    if al is None:\n                                        continue\n                                    x, y = xy_por_alinhamento(al, st, off)\n                                candidatos.append((x, y, z, desc, bl_nome, st, off))\n\n                # remove duplicados (mesmo ponto vindo de subassemblies/regioes vizinhas)\n                vistos, pontos = set(), []\n                for c in sorted(candidatos, key=lambda k: (k[4], k[5], k[6])):\n                    chave = (round(c[0] / TOL_XY), round(c[1] / TOL_XY))\n                    if chave in vistos:\n                        continue\n                    vistos.add(chave)\n                    pontos.append(c)\n\n                resumo = {}\n                for c in pontos:\n                    d = (c[3] + \" \" + lado_de(c[6])).strip()\n                    resumo[d] = resumo.get(d, 0) + 1\n\n                relatorio.append(\"== CORREDOR: %s ==\" % corr.Name)\n                relatorio.append(\"Codigos encontrados: \" + \", \".join(\n                    \"%s(%d)\" % (k, v) for k, v in sorted(contagem_codigos.items())))\n                relatorio.append(\"Pontos a locar: %d -> \" % len(pontos) + \", \".join(\n                    \"%s: %d\" % (k, v) for k, v in sorted(resumo.items())))\n\n                if not executar:\n                    continue\n\n                # ---- grupo de pontos ----\n                gnome = \"%s - %s\" % (grupo_prefixo, corr.Name)\n                pgs = civdoc.PointGroups\n                gid = None\n                for _id in pgs:\n                    if t.GetObject(_id, OpenMode.ForRead).Name == gnome:\n                        gid = _id\n                        break\n                if gid is not None:\n                    if apagar:\n                        pg_old = t.GetObject(gid, OpenMode.ForRead)\n                        removidos = 0\n                        for n in list(pg_old.GetPointNumbers()):\n                            try:\n                                cogo.Remove(cogo.GetPointByPointNumber(n))\n                                removidos += 1\n                            except Exception:\n                                pass\n                        relatorio.append(\"Pontos anteriores removidos: %d\" % removidos)\n                else:\n                    gid = pgs.Add(gnome)\n\n                numeros = []\n                for (x, y, z, desc, bln, st, off) in pontos:\n                    raw = (desc + \" \" + lado_de(off)).strip()\n                    pid = cogo.Add(Point3d(x, y, z), raw, True)\n                    cpt = t.GetObject(pid, OpenMode.ForRead)\n                    num = int(cpt.PointNumber)\n                    numeros.append(num)\n                    csv_linhas.append(\"%d,%.4f,%.4f,%.4f,%s\" % (num, y, x, z, raw))\n                    csv_rel.append(\"%d;%s;%s;%s;%s;%s;%s;%s;%s\" % (\n                        num, corr.Name, bln, estaca_txt(st), (\"%.3f\" % st).replace(\".\", \",\"),\n                        (\"%.3f\" % off).replace(\".\", \",\"), (\"%.4f\" % y).replace(\".\", \",\"),\n                        (\"%.4f\" % x).replace(\".\", \",\"), (\"%.4f\" % z).replace(\".\", \",\")) + \";\" + raw)\n\n                pg = t.GetObject(gid, OpenMode.ForWrite)\n                q = StandardPointGroupQuery()\n                q.IncludeNumbers = faixas(numeros)\n                pg.SetQuery(q)\n                pg.Update()\n                if numeros:\n                    relatorio.append(\"Criados %d pontos (%d a %d) no grupo '%s'\" % (\n                        len(numeros), min(numeros), max(numeros), gnome))\n\n            if executar:\n                t.Commit()\n            else:\n                t.Abort()\n        finally:\n            t.Dispose()\n    finally:\n        lock.Dispose()\n\n    # ---- CSV ------------------------------------------------------------\n    if executar and csv_linhas and pasta_csv != \"-\":\n        pasta = pasta_csv or os.path.dirname(db.Filename) or os.path.expanduser(\"~\")\n        base = os.path.splitext(os.path.basename(db.Filename or \"desenho\"))[0]\n        f1 = os.path.join(pasta, base + \"_LOCACAO_PNEZD.csv\")\n        f2 = os.path.join(pasta, base + \"_LOCACAO_relatorio.csv\")\n        with open(f1, \"w\", encoding=\"utf-8\") as f:\n            f.write(\"\\n\".join(csv_linhas) + \"\\n\")\n        with open(f2, \"w\", encoding=\"utf-8-sig\") as f:\n            f.write(\"Ponto;Corredor;Baseline;Estaca;Estaca_m;Offset;Norte;Este;Cota;Descricao\\n\")\n            f.write(\"\\n\".join(csv_rel) + \"\\n\")\n        relatorio.append(\"CSV coletora: \" + f1)\n        relatorio.append(\"CSV relatorio: \" + f2)\n\n    if not relatorio:\n        relatorio.append(\"Nenhum corredor encontrado com o filtro '%s'.\" % corr_filtro)\n    if not executar:\n        relatorio.insert(0, \"MODO SIMULACAO - nada foi criado. Ajuste os codigos e mude EXECUTAR para True.\")\n\n    return relatorio\n\n\ntry:\n    OUT = main()\nexcept Exception:\n    OUT = ['ERRO - envie este texto:'] + traceback.format_exc().splitlines()\n\ntry:\n    _p = os.path.join(os.path.expanduser('~'), 'Documents', 'Dynamo')\n    with open(os.path.join(_p, 'locacao_ultimo_relatorio.txt'), 'w', encoding='utf-8') as _f:\n        _f.write(chr(10).join(str(x) for x in OUT))\nexcept Exception:\n    pass\n",
      "Engine": "PythonNet3",
      "VariableInputPorts": true,
