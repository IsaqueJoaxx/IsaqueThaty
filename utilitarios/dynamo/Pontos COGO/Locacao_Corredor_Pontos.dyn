{
  "Uuid": "1a402aa0-c8ae-491a-a059-79a1448cbb9d",
  "IsCustomNode": false,
  "Description": "Insere pontos COGO de locacao (eixo, bordo, sarjeta/drenagem, banquetas, offset) a partir dos codigos de ponto do corredor, cria grupo de pontos e exporta CSV PNEZD.",
  "Name": "Locacao_Corredor_Pontos",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [
    {
      "Id": "399eb7e87989461db63cbe3712e9599a",
      "Name": "1. Corredores (* = todos; separar por ;)",
      "Type": "string",
      "Type2": "string",
      "Value": "*",
      "Description": "Cria uma sequência de caracteres."
    },
    {
      "Id": "e4f1f41df722491d9c639c6651cee38a",
      "Name": "2. Codigos do corredor = descricao do ponto",
      "Type": "string",
      "Type2": "string",
      "Value": "Crown=EIXO; ETW=BORDO; Drenagem*-6=FIM DRENAGEM; AterroBan*=BANQUETA",
      "Description": "Cria uma sequência de caracteres."
    },
    {
      "Id": "5446d124b2b94b8aa9f5d7f18e0dab21",
      "Name": "3. Intervalo em metros (20 = estacas; 0 = todas as secoes)",
      "Type": "number",
      "Type2": "number",
      "Value": "20",
      "NumberType": "Double",
      "Description": "Cria um número."
    },
    {
      "Id": "b15b33365e904880a3a0ea3762468d19",
      "Name": "4. Incluir pontos notaveis (PC, PT, TS, SC, inicio/fim de regiao)",
      "Type": "boolean",
      "Type2": "boolean",
      "Value": "true",
      "Description": "Permite a seleção entre True e False"
    },
    {
      "Id": "195f5b59e3954fbda7d169c311dea38b",
      "Name": "5. Prefixo do grupo de pontos",
      "Type": "string",
      "Type2": "string",
      "Value": "LOCACAO",
      "Description": "Cria uma sequência de caracteres."
    },
    {
      "Id": "df2401afbd8a4cf68acb5f54fe5cc5a4",
      "Name": "6. Apagar pontos anteriores do grupo",
      "Type": "boolean",
      "Type2": "boolean",
      "Value": "true",
      "Description": "Permite a seleção entre True e False"
    },
    {
      "Id": "28e629353b544b148cc9f141375ee443",
      "Name": "7. Pasta do CSV (vazio = pasta do DWG; - = nao exportar)",
      "Type": "string",
      "Type2": "string",
      "Value": "",
      "Description": "Cria uma sequência de caracteres."
    },
    {
      "Id": "0960ca3f03814f6ab09c4a5c9aaf2017",
      "Name": "8. EXECUTAR (False = so simula e lista codigos)",
      "Type": "boolean",
      "Type2": "boolean",
      "Value": "true",
      "Description": "Permite a seleção entre True e False"
    }
  ],
  "Outputs": [
