<Project Sdk="Microsoft.NET.Sdk">

  <!-- Plugin de intersecao para Civil 3D 2025+ -->
  <!-- Civil 3D 2025 roda sobre .NET 8. Para 2024 ou anterior, troque para net4.8 -->

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <UseWindowsForms>false</UseWindowsForms>
    <AssemblyName>Intersecao</AssemblyName>
    <RootNamespace>IntersecaoPlugin</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Nao copiar as DLLs do Civil 3D para a saida -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- >>> AJUSTE <<< o caminho de instalacao se necessario -->
  <PropertyGroup>
    <C3DPath>C:\Program Files\Autodesk\AutoCAD 2025</C3DPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="accoremgd">
      <HintPath>$(C3DPath)\accoremgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="acdbmgd">
      <HintPath>$(C3DPath)\acdbmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="acmgd">
      <HintPath>$(C3DPath)\acmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AecBaseMgd">
      <HintPath>$(C3DPath)\AecBaseMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AeccDbMgd">
      <HintPath>$(C3DPath)\C3D\AeccDbMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AeccApplicationMgd">
      <HintPath>$(C3DPath)\C3D\AeccApplicationMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
